// Same-cache-line concurrent R/W stress probe.
//
// Previous tests had insufficient concurrency (SyncAll between phases,
// only 2 blocks, single-shot). This probe fixes those gaps:
//
// Mode 0: 2-block tight-loop store+dcci to DIFFERENT words (no mid-loop SyncAll)
//   Block 0: 1000× { gx[0]=A; gx[1]=A; dcci(flush); }
//   Block 1: 1000× { gx[2]=B; gx[3]=B; dcci(flush); }
//   Each dcci writes back ENTIRE 64B line → clobbers the other block's words.
//
// Mode 1: 3-block version of mode 0
//
// Mode 2: Torn read — writer does dcci(flush) while reader does ld_dev
//   Block 0: 1000× { write all 16 words = round; dcci(flush); }
//   Block 1: 1000× { ld_dev read all 16 words; check consistency; }
//   Can reader see half-updated line (some words round N, others N+1)?
//
// Mode 3: Mixed tight-loop: st_dev vs store+dcci
//   Block 0: 1000× { st_dev word[0..3] = A; }
//   Block 1: 1000× { store word[8..11] + dcci(flush); }
//
// Mode 4: Accumulated stores then single dcci (real kernel pattern)
//   Block 0: 500× { gx[0]=r; gx[1]=r; gx[2]=r; gx[3]=r; dcci(flush); }
//   Block 1: 500× { gx[4]=r; gx[5]=r; gx[6]=r; gx[7]=r; dcci(flush); }
//
// Build/run:
//   bisheng -xasc cacheline_stress.asc --npu-arch=dav-3510 -o /tmp/cl_stress
//   /tmp/cl_stress
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cstdint>
#include <time.h>
#include <cstdio>
using namespace AscendC;

#ifndef SINGLE_CACHE_LINE
#define SINGLE_CACHE_LINE 0
#endif
#ifndef CACHELINE_OUT
#define CACHELINE_OUT 2
#endif

constexpr uint32_t ROUNDS = 1000;

__schedmode__(1) __global__ __mix__(0, 1) void cl_stress(
    __gm__ uint32_t *gx, uint32_t mode, uint32_t num_blocks)
{
    uint32_t bid = GetBlockIdx();
    uint32_t nb  = num_blocks;

    // ================================================================
    // Mode 0: 2-block tight-loop store+dcci (no SyncAll between rounds)
    // ================================================================
    if (mode == 0) {
        SyncAll();  // start barrier only
        if (bid < 2) {
            // Block 0 owns words [0,1], block 1 owns words [2,3]
            uint32_t my_base = (bid == 0) ? 0xA000A000u : 0xB000B000u;
            uint32_t my_w0 = bid * 2;
            for (uint32_t r = 0; r < ROUNDS; r++) {
                gx[my_w0]     = my_base + r;
                gx[my_w0 + 1] = my_base + r;
                dcci(gx, SINGLE_CACHE_LINE, CACHELINE_OUT);
            }
        }
        SyncAll();  // end barrier
        if (bid == 0) {
            uint32_t w0 = ReadGmByPassDCache<uint32_t>(&gx[0]);
            uint32_t w1 = ReadGmByPassDCache<uint32_t>(&gx[1]);
            uint32_t w2 = ReadGmByPassDCache<uint32_t>(&gx[2]);
            uint32_t w3 = ReadGmByPassDCache<uint32_t>(&gx[3]);
            gx[16] = w0; gx[17] = w1; gx[18] = w2; gx[19] = w3;
            gx[20] = 0xA000A000u + ROUNDS - 1;  // expected for block 0
            gx[21] = 0xB000B000u + ROUNDS - 1;  // expected for block 1
            uint32_t err = 0;
            if (w0 < 0xA000A000u) err++;  // clobbered by block 1
            if (w1 < 0xA000A000u) err++;
            if (w2 < 0xB000B000u) err++;  // clobbered by block 0
            if (w3 < 0xB000B000u) err++;
            gx[22] = err;
        }
        SyncAll();

    // ================================================================
    // Mode 1: N-block tight-loop store+dcci
    // ================================================================
    } else if (mode == 1) {
        SyncAll();
        if (bid < nb) {
            // Each block owns 2 words: block i → words [2i, 2i+1]
            uint32_t my_base = 0x10000000u * (bid + 1);
            uint32_t my_w0 = bid * 2;
            if (my_w0 + 1 < 16) {
                for (uint32_t r = 0; r < ROUNDS; r++) {
                    gx[my_w0]     = my_base + r;
                    gx[my_w0 + 1] = my_base + r;
                    dcci(gx, SINGLE_CACHE_LINE, CACHELINE_OUT);
                }
            }
        }
        SyncAll();
        if (bid == 0) {
            uint32_t total_err = 0;
            for (uint32_t b = 0; b < nb && b < 8; b++) {
                uint32_t w0 = 2 * b;
                if (w0 + 1 >= 16) break;
                uint32_t my_base = 0x10000000u * (b + 1);
                uint32_t v0 = ReadGmByPassDCache<uint32_t>(&gx[w0]);
                uint32_t v1 = ReadGmByPassDCache<uint32_t>(&gx[w0 + 1]);
                if (v0 < my_base) total_err++;
                if (v1 < my_base) total_err++;
            }
            gx[22] = total_err;
        }
        SyncAll();

    // ================================================================
    // Mode 2: Torn read — writer dcci(flush) while reader ld_dev reads
    // ================================================================
    } else if (mode == 2) {
        SyncAll();
        if (bid == 0) {
            // Writer: write all 16 words = round number, then dcci flush
            for (uint32_t r = 1; r <= ROUNDS; r++) {
                for (uint32_t w = 0; w < 16; w++) gx[w] = r;
                dcci(gx, SINGLE_CACHE_LINE, CACHELINE_OUT);
            }
            // Signal done
            WriteGmByPassDCache<uint32_t>(&gx[31], 0xDEAD);
        } else if (bid == 1) {
            // Reader: read all 16 words via bypass, check consistency
            uint32_t torn_count = 0;
            uint32_t read_count = 0;
            uint32_t done = 0;
            while (done != 0xDEAD) {
                uint32_t vals[16];
                for (uint32_t w = 0; w < 16; w++)
                    vals[w] = ReadGmByPassDCache<uint32_t>(&gx[w]);
                done = ReadGmByPassDCache<uint32_t>(&gx[31]);
                read_count++;
                // Check: all 16 words should have the same value
                uint32_t v0 = vals[0];
                for (uint32_t w = 1; w < 16; w++) {
                    if (vals[w] != v0) {
                        torn_count++;
                        break;
                    }
                }
            }
            gx[22] = torn_count;
            gx[23] = read_count;
        }
        SyncAll();

    // ================================================================
    // Mode 3: Mixed tight-loop: st_dev vs store+dcci
    // ================================================================
    } else if (mode == 3) {
        SyncAll();
        if (bid == 0) {
            // Block 0: st_dev (bypass DCache) to words 0-3
            for (uint32_t r = 0; r < ROUNDS; r++) {
                WriteGmByPassDCache<uint32_t>(&gx[0], 0xDEAD0000u + r);
                WriteGmByPassDCache<uint32_t>(&gx[1], 0xDEAD0000u + r);
                WriteGmByPassDCache<uint32_t>(&gx[2], 0xDEAD0000u + r);
                WriteGmByPassDCache<uint32_t>(&gx[3], 0xDEAD0000u + r);
            }
        } else if (bid == 1) {
            // Block 1: store + dcci to words 8-11
            for (uint32_t r = 0; r < ROUNDS; r++) {
                gx[8]  = 0xBEEF0000u + r;
                gx[9]  = 0xBEEF0000u + r;
                gx[10] = 0xBEEF0000u + r;
                gx[11] = 0xBEEF0000u + r;
                dcci(gx, SINGLE_CACHE_LINE, CACHELINE_OUT);
            }
        }
        SyncAll();
        if (bid == 0) {
            uint32_t st_err = 0, dcci_err = 0;
            // st_dev words should survive
            for (uint32_t w = 0; w < 4; w++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[w]);
                if (v < 0xDEAD0000u) st_err++;
            }
            // store+dcci words
            for (uint32_t w = 8; w < 12; w++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[w]);
                if (v < 0xBEEF0000u) dcci_err++;
            }
            gx[16] = ReadGmByPassDCache<uint32_t>(&gx[0]);  // st_dev word[0]
            gx[17] = ReadGmByPassDCache<uint32_t>(&gx[8]);  // store+dcci word[8]
            gx[22] = st_err;
            gx[23] = dcci_err;
        }
        SyncAll();

    // ================================================================
    // Mode 4: Accumulated stores then single dcci (real kernel pattern)
    // ================================================================
    } else if (mode == 4) {
        SyncAll();
        if (bid < 2) {
            uint32_t my_base = (bid == 0) ? 0xAAAA0000u : 0xBBBB0000u;
            uint32_t my_w0 = bid * 4;  // block 0: words 0-3, block 1: words 4-7
            for (uint32_t r = 0; r < 500; r++) {
                // Accumulate 4 stores in L1 before single flush
                gx[my_w0]     = my_base + r;
                gx[my_w0 + 1] = my_base + r;
                gx[my_w0 + 2] = my_base + r;
                gx[my_w0 + 3] = my_base + r;
                dcci(gx, SINGLE_CACHE_LINE, CACHELINE_OUT);
            }
        }
        SyncAll();
        if (bid == 0) {
            uint32_t a_err = 0, b_err = 0;
            for (uint32_t w = 0; w < 4; w++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[w]);
                if (v < 0xAAAA0000u) a_err++;
            }
            for (uint32_t w = 4; w < 8; w++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[w]);
                if (v < 0xBBBB0000u) b_err++;
            }
            gx[22] = a_err;
            gx[23] = b_err;
            gx[16] = ReadGmByPassDCache<uint32_t>(&gx[0]);
            gx[17] = ReadGmByPassDCache<uint32_t>(&gx[4]);
        }
        SyncAll();
    }
}

int32_t main(int32_t argc, char *argv[])
{
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    constexpr int GX_SIZE = 64;
    uint32_t *gx_dev;
    aclrtMalloc((void **)&gx_dev, GX_SIZE * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);

    const char *names[] = {
        "2-blk store+dcci   ",
        "N-blk store+dcci   ",
        "Torn read          ",
        "Mixed st_dev+dcci  ",
        "Accumulate+dcci    ",
    };
    const int NUM_MODES = 5;

    printf("=== Same-Cache-Line Concurrent R/W Stress Probe ===\n");
    printf("ROUNDS=%u, no SyncAll between rounds\n\n", ROUNDS);

    for (int mode = 0; mode < NUM_MODES; mode++) {
        uint32_t nblk = (mode == 1) ? 3 : 2;
        uint32_t zeros[GX_SIZE] = {0};
        aclrtMemcpy(gx_dev, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE);

        struct timespec ts0, ts1;
        clock_gettime(CLOCK_MONOTONIC, &ts0);

        cl_stress<<<nblk, nullptr, stream>>>(gx_dev, (uint32_t)mode, nblk);
        aclrtSynchronizeStream(stream);

        clock_gettime(CLOCK_MONOTONIC, &ts1);
        double us = (ts1.tv_sec - ts0.tv_sec) * 1e6 + (ts1.tv_nsec - ts0.tv_nsec) / 1e3;

        uint32_t r[GX_SIZE] = {0};
        aclrtMemcpy(r, sizeof(r), gx_dev, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST);

        if (mode == 0) {
            printf("[%s] mode=%d  blk0_w0=0x%08x blk1_w2=0x%08x  err=%u/4  %.0fus\n",
                   names[mode], mode, r[16], r[18], r[22], us);
            printf("  w0=0x%08x w1=0x%08x w2=0x%08x w3=0x%08x\n",
                   r[16], r[17], r[18], r[19]);
        } else if (mode == 1) {
            printf("[%s] mode=%d  blk=%u  err=%u  %.0fus\n",
                   names[mode], mode, nblk, r[22], us);
        } else if (mode == 2) {
            printf("[%s] mode=%d  torn=%u/%u reads  %.0fus\n",
                   names[mode], mode, r[22], r[23], us);
        } else if (mode == 3) {
            printf("[%s] mode=%d  st_err=%u/4 dcci_err=%u/4  st_w0=0x%08x dcci_w8=0x%08x  %.0fus\n",
                   names[mode], mode, r[22], r[23], r[16], r[17], us);
        } else if (mode == 4) {
            printf("[%s] mode=%d  A_err=%u/4 B_err=%u/4  A_w0=0x%08x B_w4=0x%08x  %.0fus\n",
                   names[mode], mode, r[22], r[23], r[16], r[17], us);
        }
    }

    // Run mode 0 multiple times for distribution
    printf("\n--- Mode 0 x5 runs (2-block store+dcci stress) ---\n");
    for (int i = 0; i < 5; i++) {
        uint32_t zeros[GX_SIZE] = {0};
        aclrtMemcpy(gx_dev, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE);
        cl_stress<<<2, nullptr, stream>>>(gx_dev, 0, 2);
        aclrtSynchronizeStream(stream);
        uint32_t r[GX_SIZE] = {0};
        aclrtMemcpy(r, sizeof(r), gx_dev, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST);
        printf("  run %d: err=%u/4  w0=0x%08x w2=0x%08x\n", i, r[22], r[16], r[18]);
    }

    aclrtFree(gx_dev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
