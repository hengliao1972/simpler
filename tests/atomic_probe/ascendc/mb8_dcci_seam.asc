// MB-8 Coherent<T>/dcci seam onboard probe — cross-block publish/observe.
//
// Block 0 (producer): writes a GM data array, dcci flush, sets flag via
// AtomicMax. Block 1 (consumer): dcci inval flag, polls until flag==1, dcci
// inval data, reads and verifies. Repeated for multiple rounds with different
// patterns to trigger cache reuse.
//
// Verifies: consumer reads the exact producer-written data every round (no
// stale-cache corruption). This is the foundational dcci/dcci seam test — all
// other onboard minibench failures trace back to this seam.
//
// Run on A5 onboard only (sim compiles dcci to no-op, always passes).
//
// Build/run: see _run_probe.sh
#include "../probe_host.h"
#include "kernel_operator.h"
#include <cstdint>
#include <time.h>
#include <cstdio>
using namespace AscendC;

constexpr int32_t DATA_ELEMS = 64;  // 64 * 4B = 256B = 4 cache lines
constexpr int32_t kCacheLineBytes = 64;

// Flush/invalidate a byte range by iterating cache lines (dcci only operates
// on a SINGLE_CACHE_LINE per call; the 2nd param is CacheLine enum [0,1],
// the 3rd is DcciDst enum: 2=CACHELINE_OUT for flush).
// For invalidate, dist_engine.cpp pto_dcci_inval uses the 2-arg form
// dcci(ptr, SINGLE_CACHE_LINE) which defaults to clean+invalidate.
__aicore__ inline void dcci_flush_range(__gm__ void *ptr, int32_t bytes) {
    uintptr_t a = reinterpret_cast<uintptr_t>(ptr) & ~(kCacheLineBytes - 1);
    const uintptr_t end = reinterpret_cast<uintptr_t>(ptr) + bytes;
    for (; a < end; a += kCacheLineBytes)
        dcci(reinterpret_cast<__gm__ void *>(a), 0, 2);  // SINGLE_CACHE_LINE, CACHELINE_OUT
}
__aicore__ inline void dcci_inval_range(__gm__ void *ptr, int32_t bytes) {
    uintptr_t a = reinterpret_cast<uintptr_t>(ptr) & ~(kCacheLineBytes - 1);
    const uintptr_t end = reinterpret_cast<uintptr_t>(ptr) + bytes;
    for (; a < end; a += kCacheLineBytes)
        dcci(reinterpret_cast<__gm__ void *>(a), 0);  // SINGLE_CACHE_LINE (2-arg = inval)
}

__schedmode__(1) __global__ __mix__(0, 1) void mb8_dcci_seam(
    __gm__ uint32_t *data,    // [DATA_ELEMS] — the payload
    __gm__ uint32_t *flag,    // [1] — completion flag (AtomicAdd counter)
    __gm__ uint32_t *errors,  // [1] — error count (host checks)
    int32_t num_rounds)
{
    SyncAll();
    int32_t bid = GetBlockIdx();

    for (int32_t round = 0; round < num_rounds; round++) {
        if (bid == 0) {
            // Producer: write data pattern, flush, set flag via AtomicAdd
            uint32_t pattern = 0xA5000000u | (uint32_t)round;
            for (int i = 0; i < DATA_ELEMS; i++) {
                data[i] = pattern + (uint32_t)i;
            }
            dcci_flush_range(reinterpret_cast<__gm__ void *>(data), DATA_ELEMS * (int32_t)sizeof(uint32_t));
            AtomicAdd(flag, 1u);
        } else if (bid == 1) {
            // Consumer: poll flag via idempotent atomic read (AtomicMax with 0
            // returns current value without modifying it — memory-level, reads
            // true HBM value per docs §2 "纯读共享量" alternative).
            uint32_t target = (uint32_t)(round + 1);
            while (true) {
                if (AtomicMax(flag, 0u) >= target) break;
            }
            // Invalidate data cache lines before reading (data is not atomic)
            dcci_inval_range(reinterpret_cast<__gm__ void *>(data), DATA_ELEMS * (int32_t)sizeof(uint32_t));
            uint32_t pattern = 0xA5000000u | (uint32_t)round;
            for (int i = 0; i < DATA_ELEMS; i++) {
                if (data[i] != pattern + (uint32_t)i) {
                    AtomicAdd(errors, 1u);
                    break;
                }
            }
        }
        SyncAll();
    }

    if (bid == 0) {
        printf("MB8 rounds=%d data_elems=%d\n", num_rounds, DATA_ELEMS);
    }
}

int32_t main(int32_t argc, char *argv[])
{
    int32_t deviceId = atomic_probe::DeviceId();
    if (deviceId < 0) {
        return EXIT_FAILURE;
    }
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    const int32_t NUM_ROUNDS = 100;
    uint32_t *data_buf = nullptr;
    uint32_t *flag_buf = nullptr;
    uint32_t *errors_buf = nullptr;
    PROBE_ACL_CHECK(
        aclrtMalloc((void **)&data_buf, DATA_ELEMS * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc((void **)&flag_buf, sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc((void **)&errors_buf, sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    atomic_probe::Result result;

    uint32_t zero = 0;
    PROBE_ACL_CHECK(
        aclrtMemcpy(flag_buf, sizeof(uint32_t), &zero, sizeof(uint32_t), ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(
        aclrtMemcpy(errors_buf, sizeof(uint32_t), &zero, sizeof(uint32_t), ACL_MEMCPY_HOST_TO_DEVICE));

    struct timespec ts_start, ts_end;
    clock_gettime(CLOCK_MONOTONIC, &ts_start);

    // Need at least 2 blocks (producer + consumer)
    mb8_dcci_seam<<<2, nullptr, stream>>>(data_buf, flag_buf, errors_buf, NUM_ROUNDS);
    PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

    clock_gettime(CLOCK_MONOTONIC, &ts_end);
    double host_us = (ts_end.tv_sec - ts_start.tv_sec) * 1e6 +
                     (ts_end.tv_nsec - ts_start.tv_nsec) / 1e3;

    uint32_t errors_host = 0;
    uint32_t flag_host = 0;
    PROBE_ACL_CHECK(aclrtMemcpy(&errors_host, sizeof(uint32_t), errors_buf, sizeof(uint32_t),
                               ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(&flag_host, sizeof(uint32_t), flag_buf, sizeof(uint32_t),
                               ACL_MEMCPY_DEVICE_TO_HOST));

    bool pass = (errors_host == 0) && (flag_host == (uint32_t)NUM_ROUNDS);
    printf("[HOST] MB8 rounds=%d host=%.1fus flag=%u errors=%u %s\n",
           NUM_ROUNDS, host_us, flag_host, errors_host, pass ? "PASS" : "FAIL");
    result.Expect(pass, "MB8 exact data and completion count");

    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(data_buf), "aclrtFree(data_buf)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(flag_buf), "aclrtFree(flag_buf)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(errors_buf), "aclrtFree(errors_buf)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    result.Expect(cleanup_ok, "ACL cleanup");
    return result.ExitCode();
}
