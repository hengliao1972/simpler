// 测试目标：精确比较 DCCI 第三参数 DEFAULT、CACHELINE_ALL、CACHELINE_OUT、
// CACHELINE_ATOMIC 对“读核只读、目标 cache line 始终 clean”的失效行为。
//
// 参与者固定为两个 AIV，data、ready、done、writer marker、reader result 各自独占
// 一条 64B cache line。两个核对 data 的访问由 ready/done atomic phase 严格串行，
// 不存在同时读写 data line；读核在整个用例中绝不写 data line。
//
// 每轮时序：
//   1. 读核用普通 scalar load 预读旧 data，使本核持有 clean cache line；DSB 后用
//      AtomicMax(ready, round+1) 把写权限交给写核。
//   2. 写核看到 ready 后，用 WriteGmByPassDCache 更新整条 data；DSB 后用
//      AtomicMax(done, round+1) 发布新值。
//   3. 读核看到 done 后执行本 mode 的 DCCI 和 DSB，再分别用普通 load 与
//      ReadGmByPassDCache 读取。普通 load 检验本核 cache 是否更新，bypass load
//      检验 GM 是否仍保留写核新值。
//   4. 下一轮 ready 只能在本轮检查完成后发布，因此写核不会提前覆盖下一轮数据。
//
// Mode：
//   0 DEFAULT：两参数 dcci(data, SINGLE_CACHE_LINE)，第三参数采用编译器默认值 0。
//   1 ALL：显式 dcci(..., CACHELINE_ALL)。与 mode 0 对照默认值是否等价于 ALL。
//   2 OUT：显式 dcci(..., CACHELINE_OUT)。
//   3 ATOMIC：显式 dcci(..., CACHELINE_ATOMIC)。
//   4 NO DCCI：stale-cache 前提对照，不是业务方案。
//
// 固定判定标准：每轮普通读取的整条 line 只能等于本轮新值，或等于 DCCI 前实际预读
// 的完整 stale line；ld_dev 必须始终看到写核本轮新值。板上重复结果已将四种 DCCI
// mode 收紧为 100 轮全部 fresh；该门禁只描述本机 A5 的 ordinary clean line。
#include "../probe_host.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>

using namespace AscendC;

constexpr uint32_t CACHELINE_BYTES = 64;
constexpr uint32_t CACHELINE_WORDS = CACHELINE_BYTES / sizeof(uint32_t);
constexpr uint32_t NUM_ROUNDS = 100;
constexpr uint32_t NUM_MODES = 5;
constexpr uint32_t READER_MAGIC = 0x52454144u;

constexpr uint32_t RESULT_MAGIC = 0;
constexpr uint32_t RESULT_MODE = 1;
constexpr uint32_t RESULT_ROUNDS = 2;
constexpr uint32_t RESULT_PRELOAD_ROUNDS = 3;
constexpr uint32_t RESULT_PRELOAD_CURRENT = 4;
constexpr uint32_t RESULT_FRESH = 5;
constexpr uint32_t RESULT_STALE = 6;
constexpr uint32_t RESULT_NORMAL_OTHER = 7;
constexpr uint32_t RESULT_IMPOSSIBLE = 8;
constexpr uint32_t RESULT_GM_BAD = 9;
constexpr uint32_t RESULT_FIRST_NORMAL = 10;
constexpr uint32_t RESULT_FIRST_PRELOAD = 11;
constexpr uint32_t RESULT_FIRST_EXPECTED = 12;
constexpr uint32_t RESULT_FIRST_BYPASS = 13;
constexpr uint32_t RESULT_FIRST_WORD = 14;
constexpr uint32_t RESULT_RESERVED = 15;

__aicore__ inline uint32_t PublishedValue(uint32_t mode, uint32_t round, uint32_t word)
{
    return 0xA5000000u + mode * 0x00100000u + round * 0x100u + word;
}

__aicore__ inline uint32_t WriterMarkerValue(uint32_t mode, uint32_t phase, uint32_t word)
{
    return 0x57000000u + mode * 0x00100000u + phase * 0x100u + word;
}

__schedmode__(1) __global__ __mix__(0, 1) void mb8_dcci_seam(
    __gm__ uint32_t *data, __gm__ uint32_t *ready, __gm__ uint32_t *done,
    __gm__ uint32_t *writer_marker, __gm__ uint32_t *reader_result, uint32_t mode)
{
    uint32_t participant = static_cast<uint32_t>(GetBlockIdx());

    if (participant == 0) {
        for (uint32_t round = 0; round < NUM_ROUNDS; ++round) {
            uint32_t phase = round + 1;
            while (AtomicMax(&ready[0], 0u) < phase) {
            }

            for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
                WriteGmByPassDCache<uint32_t>(
                    &data[word], PublishedValue(mode, round, word));
                WriteGmByPassDCache<uint32_t>(
                    &writer_marker[word], WriterMarkerValue(mode, phase, word));
            }
            DataSyncBarrier<MemDsbT::ALL>();
            AtomicMax(&done[0], phase);
        }
        return;
    }

    if (participant != 1) {
        return;
    }

    uint32_t preload_rounds = 0;
    uint32_t preload_current_rounds = 0;
    uint32_t fresh_rounds = 0;
    uint32_t stale_rounds = 0;
    uint32_t normal_other_rounds = 0;
    uint32_t impossible_rounds = 0;
    uint32_t gm_bad_rounds = 0;
    uint32_t first_normal = 0;
    uint32_t first_preload = 0;
    uint32_t first_expected = 0;
    uint32_t first_bypass = 0;
    uint32_t first_word = 0xffffffffu;
    volatile __gm__ uint32_t *normal_data = data;

    for (uint32_t round = 0; round < NUM_ROUNDS; ++round) {
        uint32_t preload[CACHELINE_WORDS];
        uint32_t normal[CACHELINE_WORDS];
        uint32_t bypass[CACHELINE_WORDS];
        bool preload_is_current = true;
        for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
            preload[word] = normal_data[word];
            preload_is_current =
                preload_is_current && preload[word] == PublishedValue(mode, round, word);
        }
        ++preload_rounds;
        if (preload_is_current) {
            ++preload_current_rounds;
        }

        DataSyncBarrier<MemDsbT::ALL>();
        uint32_t phase = round + 1;
        AtomicMax(&ready[0], phase);
        while (AtomicMax(&done[0], 0u) < phase) {
        }
        // 不把 atomic phase 观察本身当作 DCCI 的 ordering 保证。
        DataSyncBarrier<MemDsbT::ALL>();

        if (mode == 0) {
            dcci(data, SINGLE_CACHE_LINE);
        } else if (mode == 1) {
            dcci(data, SINGLE_CACHE_LINE, CACHELINE_ALL);
        } else if (mode == 2) {
            dcci(data, SINGLE_CACHE_LINE, CACHELINE_OUT);
        } else if (mode == 3) {
            dcci(data, SINGLE_CACHE_LINE, CACHELINE_ATOMIC);
        }
        DataSyncBarrier<MemDsbT::ALL>();

        bool normal_is_fresh = true;
        bool normal_is_preloaded = true;
        bool bypass_is_fresh = true;
        for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
            uint32_t expected = PublishedValue(mode, round, word);
            normal[word] = normal_data[word];
            bypass[word] = ReadGmByPassDCache<uint32_t>(&data[word]);
            normal_is_fresh = normal_is_fresh && normal[word] == expected;
            normal_is_preloaded = normal_is_preloaded && normal[word] == preload[word];
            bypass_is_fresh = bypass_is_fresh && bypass[word] == expected;
        }

        bool normal_is_allowed = normal_is_fresh != normal_is_preloaded;
        if (normal_is_fresh) {
            ++fresh_rounds;
        } else if (normal_is_preloaded) {
            ++stale_rounds;
        } else {
            ++normal_other_rounds;
        }

        if (!normal_is_allowed) {
            ++impossible_rounds;
        }
        if (!bypass_is_fresh) {
            ++gm_bad_rounds;
        }
        if ((!normal_is_allowed || !bypass_is_fresh) && first_word == 0xffffffffu) {
            uint32_t diagnostic_word = 0;
            for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
                uint32_t expected = PublishedValue(mode, round, word);
                if (normal[word] != expected && normal[word] != preload[word]) {
                    diagnostic_word = word;
                    break;
                }
                if (bypass[word] != expected) {
                    diagnostic_word = word;
                    break;
                }
            }
            first_normal = normal[diagnostic_word];
            first_preload = preload[diagnostic_word];
            first_expected = PublishedValue(mode, round, diagnostic_word);
            first_bypass = bypass[diagnostic_word];
            first_word = diagnostic_word;
        }
    }

    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_MAGIC], READER_MAGIC);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_MODE], mode);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_ROUNDS], NUM_ROUNDS);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_PRELOAD_ROUNDS], preload_rounds);
    WriteGmByPassDCache<uint32_t>(
        &reader_result[RESULT_PRELOAD_CURRENT], preload_current_rounds);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_FRESH], fresh_rounds);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_STALE], stale_rounds);
    WriteGmByPassDCache<uint32_t>(
        &reader_result[RESULT_NORMAL_OTHER], normal_other_rounds);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_IMPOSSIBLE], impossible_rounds);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_GM_BAD], gm_bad_rounds);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_FIRST_NORMAL], first_normal);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_FIRST_PRELOAD], first_preload);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_FIRST_EXPECTED], first_expected);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_FIRST_BYPASS], first_bypass);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_FIRST_WORD], first_word);
    WriteGmByPassDCache<uint32_t>(&reader_result[RESULT_RESERVED], 0u);
    DataSyncBarrier<MemDsbT::ALL>();
}

struct ProbeBuffers {
    uint32_t *data = nullptr;
    uint32_t *ready = nullptr;
    uint32_t *done = nullptr;
    uint32_t *writer_marker = nullptr;
    uint32_t *reader_result = nullptr;
};

static uint32_t HostPublishedValue(uint32_t mode, uint32_t round, uint32_t word)
{
    return 0xA5000000u + mode * 0x00100000u + round * 0x100u + word;
}

static uint32_t HostWriterMarkerValue(uint32_t mode, uint32_t phase, uint32_t word)
{
    return 0x57000000u + mode * 0x00100000u + phase * 0x100u + word;
}

static bool LinesAreIndependent(const ProbeBuffers &buffers)
{
    uintptr_t addresses[5] = {
        reinterpret_cast<uintptr_t>(buffers.data),
        reinterpret_cast<uintptr_t>(buffers.ready),
        reinterpret_cast<uintptr_t>(buffers.done),
        reinterpret_cast<uintptr_t>(buffers.writer_marker),
        reinterpret_cast<uintptr_t>(buffers.reader_result),
    };
    for (uint32_t i = 0; i < 5; ++i) {
        if ((addresses[i] & (CACHELINE_BYTES - 1)) != 0) {
            return false;
        }
        for (uint32_t j = 0; j < i; ++j) {
            if ((addresses[i] >> 6) == (addresses[j] >> 6)) {
                return false;
            }
        }
    }
    return true;
}

int32_t main()
{
    uint32_t mode = 0;
    if (!atomic_probe::RequiredUintEnv("ATOMIC_PROBE_MODE", NUM_MODES, &mode)) {
        return EXIT_FAILURE;
    }
    int32_t device_id = atomic_probe::DeviceId();
    if (device_id < 0) {
        return EXIT_FAILURE;
    }
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(device_id));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    ProbeBuffers buffers;
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.data), CACHELINE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.ready), CACHELINE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.done), CACHELINE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.writer_marker), CACHELINE_BYTES,
        ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.reader_result), CACHELINE_BYTES,
        ACL_MEM_MALLOC_HUGE_FIRST));

    atomic_probe::Result result;
    result.Expect(
        LinesAreIndependent(buffers), "data、ready、done、marker、result 必须各占一条 64B line");
    const char *mode_names[NUM_MODES] = {
        "DEFAULT", "CACHELINE_ALL", "CACHELINE_OUT", "CACHELINE_ATOMIC", "NO DCCI"};
    uint32_t data_host[CACHELINE_WORDS];
    uint32_t zeros[CACHELINE_WORDS] = {};
    for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
        data_host[word] = 0x11000000u + mode * 0x00100000u + word;
    }
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.data, CACHELINE_BYTES, data_host, CACHELINE_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.ready, CACHELINE_BYTES, zeros, CACHELINE_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.done, CACHELINE_BYTES, zeros, CACHELINE_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.writer_marker, CACHELINE_BYTES, zeros, CACHELINE_BYTES,
        ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.reader_result, CACHELINE_BYTES, zeros, CACHELINE_BYTES,
        ACL_MEMCPY_HOST_TO_DEVICE));

    mb8_dcci_seam<<<2, nullptr, stream>>>(
        buffers.data, buffers.ready, buffers.done, buffers.writer_marker,
        buffers.reader_result, mode);
    PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

    uint32_t ready_host[CACHELINE_WORDS] = {};
    uint32_t done_host[CACHELINE_WORDS] = {};
    uint32_t marker_host[CACHELINE_WORDS] = {};
    uint32_t result_host[CACHELINE_WORDS] = {};
    PROBE_ACL_CHECK(aclrtMemcpy(
        data_host, CACHELINE_BYTES, buffers.data, CACHELINE_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        ready_host, CACHELINE_BYTES, buffers.ready, CACHELINE_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        done_host, CACHELINE_BYTES, buffers.done, CACHELINE_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        marker_host, CACHELINE_BYTES, buffers.writer_marker, CACHELINE_BYTES,
        ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        result_host, CACHELINE_BYTES, buffers.reader_result, CACHELINE_BYTES,
        ACL_MEMCPY_DEVICE_TO_HOST));

    bool phase_exact = ready_host[0] == NUM_ROUNDS && done_host[0] == NUM_ROUNDS;
    for (uint32_t word = 1; word < CACHELINE_WORDS; ++word) {
        phase_exact = phase_exact && ready_host[word] == 0 && done_host[word] == 0;
    }
    bool writer_exact = true;
    bool data_exact = true;
    for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
        writer_exact = writer_exact &&
            marker_host[word] == HostWriterMarkerValue(mode, NUM_ROUNDS, word);
        data_exact = data_exact &&
            data_host[word] == HostPublishedValue(mode, NUM_ROUNDS - 1, word);
    }
    bool reader_exact = result_host[RESULT_MAGIC] == READER_MAGIC &&
        result_host[RESULT_MODE] == mode && result_host[RESULT_ROUNDS] == NUM_ROUNDS &&
        result_host[RESULT_PRELOAD_ROUNDS] == NUM_ROUNDS &&
        result_host[RESULT_PRELOAD_CURRENT] == 0 &&
        result_host[RESULT_FIRST_WORD] == 0xffffffffu &&
        result_host[RESULT_RESERVED] == 0;

    std::printf(
        "[%s] ready=%u done=%u preload_current=%u fresh=%u stale=%u other=%u "
        "impossible=%u gm_bad=%u\n",
        mode_names[mode], ready_host[0], done_host[0],
        result_host[RESULT_PRELOAD_CURRENT], result_host[RESULT_FRESH],
        result_host[RESULT_STALE], result_host[RESULT_NORMAL_OTHER],
        result_host[RESULT_IMPOSSIBLE],
        result_host[RESULT_GM_BAD]);

    char label[256];
    std::snprintf(label, sizeof(label), "%s：ready/done 轮数及两核执行标记必须精确", mode_names[mode]);
    result.Expect(phase_exact && writer_exact && reader_exact, label);
    std::snprintf(label, sizeof(label), "%s：GM 整条 data 必须保留写核最后一轮值", mode_names[mode]);
    result.Expect(data_exact && result_host[RESULT_GM_BAD] == 0, label);
    std::snprintf(label, sizeof(label), "%s：100 轮普通读取只能是本轮新 line 或本轮预读 line", mode_names[mode]);
    result.Expect(
        result_host[RESULT_FRESH] + result_host[RESULT_STALE] +
                result_host[RESULT_NORMAL_OTHER] == NUM_ROUNDS &&
            result_host[RESULT_NORMAL_OTHER] == 0 &&
            result_host[RESULT_IMPOSSIBLE] == 0,
        label);
    if (mode <= 3) {
        result.Expect(
            result_host[RESULT_FRESH] == NUM_ROUNDS && result_host[RESULT_STALE] == 0,
            "DEFAULT、ALL、OUT、ATOMIC：100 轮普通读取都必须取得写核本轮新 line");
    } else {
        result.Expect(
            result_host[RESULT_FRESH] == 0 && result_host[RESULT_STALE] == NUM_ROUNDS,
            "NO DCCI 对照：100 轮普通读取都必须保留 DCCI 前实际预读的旧 line");
    }

    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.data), "aclrtFree(data)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.ready), "aclrtFree(ready)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.done), "aclrtFree(done)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.writer_marker), "aclrtFree(writer_marker)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.reader_result), "aclrtFree(reader_result)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtDestroyStream(stream), "aclrtDestroyStream(stream)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtResetDevice(device_id), "aclrtResetDevice(device_id)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    result.Expect(cleanup_ok, "ACL 设备内存、stream 与 runtime 资源必须全部释放成功");
    return result.ExitCode();
}
