// ccec/st_dev_same_line.cpp 的 AscendC 同构用例。两个 AIV 反复写：
//   1. 同一 64B cache line 内不同 4B slot，只在循环末执行 DSB；
//   2. 每个 AIV 独占一条 cache line，只在循环末执行 DSB；
//   3. 同一 line 内不同 slot，每轮后均执行 DSB。
//
// 三条路径都要求终值精确等于最后一轮值。路径1用于暴露跨 AIV 同-line 问题；
// 路径2只是低压力分-line 对照，不代表分-line 安全，独立压力由
// st_dev_separate_line_stress 覆盖；路径3用于对照逐轮完成。路径1必须保留
// loop-end DSB，加入逐轮 DSB 会改变本回归用例要暴露的时序。
#include "../probe_host.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>

using namespace AscendC;

constexpr uint32_t ROUNDS = 257;
constexpr uint32_t TRIALS = 100;
constexpr uint32_t SAME_BASE = 0;
constexpr uint32_t SEPARATE_BASE = 16;
constexpr uint32_t ORDERED_BASE = 48;
constexpr uint32_t RESULT_BASE = 80;
constexpr uint32_t STORAGE_WORDS = 128;
constexpr uint32_t LAUNCHES = 20;
constexpr uint32_t CHECKS_PER_LAUNCH = 200;

__aicore__ inline uint32_t TrialValue(uint32_t participant, uint32_t trial, uint32_t round)
{
    return 0xA5000000u + participant * 0x01000000u + trial * 0x1000u + round;
}

__aicore__ inline void AivSyncAll()
{
    SyncAll<true>();
}

__schedmode__(1) __global__ __mix__(0, 1) void st_dev_same_line(__gm__ uint32_t *gx)
{
    uint32_t participant = (uint32_t)get_block_idx();
    uint32_t same_errors = 0;
    uint32_t separate_errors = 0;
    uint32_t ordered_errors = 0;
    uint32_t first_same_actual = 0;
    uint32_t first_same_expected = 0;

    AtomicAdd(&gx[RESULT_BASE + 7], 1u);
    WriteGmByPassDCache<uint32_t>(&gx[RESULT_BASE + 8 + participant], 0xA1A00000u | participant);
    DataSyncBarrier<MemDsbT::ALL>();
    AivSyncAll();

    for (uint32_t trial = 0; trial < TRIALS; trial++) {
        for (uint32_t round = 0; round < ROUNDS; round++) {
            WriteGmByPassDCache<uint32_t>(
                &gx[SAME_BASE + participant], TrialValue(participant, trial, round));
        }
        DataSyncBarrier<MemDsbT::ALL>();
        AivSyncAll();
        if (participant == 0) {
            for (uint32_t p = 0; p < 2; p++) {
                uint32_t expected = TrialValue(p, trial, ROUNDS - 1);
                uint32_t actual = ReadGmByPassDCache<uint32_t>(&gx[SAME_BASE + p]);
                if (actual != expected) {
                    if (same_errors == 0) {
                        first_same_actual = actual;
                        first_same_expected = expected;
                    }
                    same_errors++;
                }
            }
        }
        AivSyncAll();

        uint32_t separate_slot = SEPARATE_BASE + participant * 16;
        for (uint32_t round = 0; round < ROUNDS; round++) {
            WriteGmByPassDCache<uint32_t>(&gx[separate_slot], TrialValue(participant, trial, round));
        }
        DataSyncBarrier<MemDsbT::ALL>();
        AivSyncAll();
        if (participant == 0) {
            for (uint32_t p = 0; p < 2; p++) {
                uint32_t expected = TrialValue(p, trial, ROUNDS - 1);
                uint32_t actual = ReadGmByPassDCache<uint32_t>(&gx[SEPARATE_BASE + p * 16]);
                if (actual != expected) separate_errors++;
            }
        }
        AivSyncAll();

        for (uint32_t round = 0; round < ROUNDS; round++) {
            WriteGmByPassDCache<uint32_t>(
                &gx[ORDERED_BASE + participant], TrialValue(participant, trial, round));
            DataSyncBarrier<MemDsbT::ALL>();
        }
        AivSyncAll();
        if (participant == 0) {
            for (uint32_t p = 0; p < 2; p++) {
                uint32_t expected = TrialValue(p, trial, ROUNDS - 1);
                uint32_t actual = ReadGmByPassDCache<uint32_t>(&gx[ORDERED_BASE + p]);
                if (actual != expected) ordered_errors++;
            }
        }
        AivSyncAll();
    }

    if (participant == 0) {
        WriteGmByPassDCache<uint32_t>(&gx[RESULT_BASE + 0], same_errors);
        WriteGmByPassDCache<uint32_t>(&gx[RESULT_BASE + 1], separate_errors);
        WriteGmByPassDCache<uint32_t>(&gx[RESULT_BASE + 2], ordered_errors);
        WriteGmByPassDCache<uint32_t>(&gx[RESULT_BASE + 3], first_same_actual);
        WriteGmByPassDCache<uint32_t>(&gx[RESULT_BASE + 4], first_same_expected);
        WriteGmByPassDCache<uint32_t>(&gx[RESULT_BASE + 5], TRIALS);
        WriteGmByPassDCache<uint32_t>(&gx[RESULT_BASE + 6], 0x3510C1A5u);
        DataSyncBarrier<MemDsbT::ALL>();
    }
    AivSyncAll();
}

int32_t main()
{
    int32_t device = atomic_probe::DeviceId();
    if (device < 0) return EXIT_FAILURE;
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(device));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    uint32_t *device_storage = nullptr;
    PROBE_ACL_CHECK(aclrtMalloc((void **)&device_storage, STORAGE_WORDS * sizeof(uint32_t),
                                ACL_MEM_MALLOC_HUGE_FIRST));

    uint32_t total_same_errors = 0;
    uint32_t total_separate_errors = 0;
    uint32_t total_ordered_errors = 0;
    atomic_probe::Result result;
    for (uint32_t launch = 0; launch < LAUNCHES; launch++) {
        uint32_t host[STORAGE_WORDS] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(device_storage, sizeof(host), host, sizeof(host),
                                    ACL_MEMCPY_HOST_TO_DEVICE));
        st_dev_same_line<<<2, nullptr, stream>>>(device_storage);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));
        PROBE_ACL_CHECK(aclrtMemcpy(host, sizeof(host), device_storage, sizeof(host),
                                    ACL_MEMCPY_DEVICE_TO_HOST));

        bool control_ok = host[RESULT_BASE + 5] == TRIALS &&
                          host[RESULT_BASE + 6] == 0x3510C1A5u &&
                          host[RESULT_BASE + 7] == 2u &&
                          host[RESULT_BASE + 8] == 0xA1A00000u &&
                          host[RESULT_BASE + 9] == 0xA1A00001u;
        char label[96];
        std::snprintf(label, sizeof(label), "AscendC same-line participation launch=%u", launch);
        result.Expect(control_ok, label);

        total_same_errors += host[RESULT_BASE + 0];
        total_separate_errors += host[RESULT_BASE + 1];
        total_ordered_errors += host[RESULT_BASE + 2];
        std::printf("launch=%u same=%u/%u separate=%u/%u ordered=%u/%u first=0x%08x expected=0x%08x\n",
                    launch, host[RESULT_BASE + 0], CHECKS_PER_LAUNCH,
                    host[RESULT_BASE + 1], CHECKS_PER_LAUNCH,
                    host[RESULT_BASE + 2], CHECKS_PER_LAUNCH,
                    host[RESULT_BASE + 3], host[RESULT_BASE + 4]);
    }

    std::printf("aggregate same=%u/%u separate=%u/%u ordered=%u/%u\n",
                total_same_errors, LAUNCHES * CHECKS_PER_LAUNCH,
                total_separate_errors, LAUNCHES * CHECKS_PER_LAUNCH,
                total_ordered_errors, LAUNCHES * CHECKS_PER_LAUNCH);
    result.Expect(total_same_errors == 0, "AscendC two AIVs same line keep exact final values");
    result.Expect(total_separate_errors == 0, "AscendC two AIVs on separate cache lines exact");
    result.Expect(total_ordered_errors == 0, "AscendC same line with per-round DSB exact");

    PROBE_ACL_CHECK(aclrtFree(device_storage));
    PROBE_ACL_CHECK(aclrtDestroyStream(stream));
    PROBE_ACL_CHECK(aclrtResetDevice(device));
    PROBE_ACL_CHECK(aclFinalize());
    return result.ExitCode();
}
