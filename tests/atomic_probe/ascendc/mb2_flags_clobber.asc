// MB-2 flags[] cacheline clobber onboard probe — AtomicMax(,1) vs store+dcci.
//
// Adjacent task flags share a 64B cache line. Multiple blocks set flags
// concurrently. Compares two paths:
//   (a) AtomicMax(&flags[N], 1) — the fix (memory-level, no cacheline writeback)
//   (b) plain store + dcci CACHELINE_OUT — the buggy path (clobbers neighbours)
//
// Verifies: path (a) has zero lost flags; path (b) may lose flags (the bug).
// Run on A5 onboard only (sim has no cache-line concept, masks the issue).
//
// Build/run: see _run_probe.sh
#include "../probe_host.h"
#include "kernel_operator.h"
#include <cstdlib>
#include <time.h>
#include <cstdio>
using namespace AscendC;

// Path (a): set flag via AtomicMax — no cacheline clobber
__schedmode__(1) __global__ __mix__(0, 1) void mb2_flags_atomicmax(
    __gm__ int32_t *flags,   // [NUM_FLAGS] init 0
    int32_t num_flags)
{
    SyncAll();
    int32_t bid = GetBlockIdx();
    int32_t numBlocks = GetBlockNum();
    // Each block sets flags where (N % numBlocks == bid)
    for (int32_t N = bid; N < num_flags; N += numBlocks) {
        AtomicMax(&flags[N], 1);
    }
    SyncAll();
}

// Path (b): set flag via plain store + dcci CACHELINE_OUT — may clobber
__schedmode__(1) __global__ __mix__(0, 1) void mb2_flags_store_dcci(
    __gm__ int32_t *flags,
    int32_t num_flags)
{
    SyncAll();
    int32_t bid = GetBlockIdx();
    int32_t numBlocks = GetBlockNum();
    for (int32_t N = bid; N < num_flags; N += numBlocks) {
        flags[N] = 1;
        dcci(reinterpret_cast<__gm__ void *>(&flags[N]), SINGLE_CACHE_LINE, CACHELINE_OUT);
    }
    SyncAll();
}

static bool count_lost_flags(__gm__ int32_t *flags_buf, int32_t *flags_host,
                             int32_t num_flags, int32_t *lost) {
    if (!atomic_probe::CheckAcl(
            aclrtMemcpy(flags_host, num_flags * sizeof(int32_t), flags_buf,
                        num_flags * sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(flags_host, flags_buf)", __FILE__, __LINE__)) {
        return false;
    }
    *lost = 0;
    for (int32_t i = 0; i < num_flags; i++)
        if (flags_host[i] != 1) (*lost)++;
    return true;
}

int32_t main(int32_t argc, char *argv[])
{
    int32_t deviceId = atomic_probe::DeviceId();
    if (deviceId < 0) {
        return EXIT_FAILURE;
    }
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    const int32_t NUM_FLAGS = 512;  // 512 * 4B = 2048B = 32 cache lines
    int32_t *flags_buf = nullptr;
    PROBE_ACL_CHECK(
        aclrtMalloc((void **)&flags_buf, NUM_FLAGS * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    int32_t *flags_host = (int32_t *)malloc(NUM_FLAGS * sizeof(int32_t));
    if (flags_host == nullptr) {
        std::fprintf(stderr, "malloc flags_host failed\n");
        return EXIT_FAILURE;
    }
    int32_t flags_zero[NUM_FLAGS] = {0};
    atomic_probe::Result result;

    int32_t test_blocks[] = {8, 16, 32, 64};
    for (size_t i = 0; i < sizeof(test_blocks) / sizeof(test_blocks[0]); i++) {
        int32_t numBlocks = test_blocks[i];

        // Path (a): AtomicMax — should have zero lost flags
        PROBE_ACL_CHECK(aclrtMemcpy(flags_buf, sizeof(flags_zero), flags_zero, sizeof(flags_zero),
                                   ACL_MEMCPY_HOST_TO_DEVICE));
        mb2_flags_atomicmax<<<numBlocks, nullptr, stream>>>(flags_buf, NUM_FLAGS);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));
        int32_t lost_a = 0;
        if (!count_lost_flags(flags_buf, flags_host, NUM_FLAGS, &lost_a)) return EXIT_FAILURE;

        // Path (b): store + dcci — may clobber neighbours
        PROBE_ACL_CHECK(aclrtMemcpy(flags_buf, sizeof(flags_zero), flags_zero, sizeof(flags_zero),
                                   ACL_MEMCPY_HOST_TO_DEVICE));
        mb2_flags_store_dcci<<<numBlocks, nullptr, stream>>>(flags_buf, NUM_FLAGS);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));
        int32_t lost_b = 0;
        if (!count_lost_flags(flags_buf, flags_host, NUM_FLAGS, &lost_b)) return EXIT_FAILURE;

        bool pass_a = (lost_a == 0);
        printf("[HOST] MB2 blocks=%d  atomicmax_lost=%d/512  store_dcci_lost=%d/512  %s\n",
               numBlocks, lost_a, lost_b, pass_a ? "PASS(atomicmax)" : "FAIL");
        char assertion[80];
        std::snprintf(assertion, sizeof(assertion), "AtomicMax flags exact, blocks=%d", numBlocks);
        result.Expect(pass_a, assertion);
    }

    free(flags_host);
    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(flags_buf), "aclrtFree(flags_buf)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    result.Expect(cleanup_ok, "ACL cleanup");
    return result.ExitCode();
}
