// WriteGmByPassDCache / ReadGmByPassDCache probe.
//
// These AscendC APIs (st_dev / ld_dev intrinsics) bypass the DCache
// entirely — the write goes directly from the scalar pipe to L2/HBM
// without dirtying any cache line.  This is the official solution for
// the "cache-line clobber" problem we demonstrated in cacheline_blast.asc.
//
// Key advantages over scalar store + dcci(CACHELINE_OUT):
//   1. Blast radius = exactly the write width (1B/2B/4B/8B), no neighbours
//   2. Supports int8/uint8/int16/uint16 — the ONLY non-clobbering 1-byte write
//   3. No dcci needed — the write never enters DCache, so no flush required
//   4. ReadGmByPassDCache always sees the latest HBM value (no stale L1)
//
// The local CANN 9.1 kernel_scalar.h implementation has explicit 1B/2B/4B/8B
// st_dev and ld_dev branches for __NPU_ARCH__ == 3510 (A5).
//
// Layout: gx[0..15] = 64B test cache line, gx[16..] = results
//
// Build/run:
//   bisheng -xasc bypass_dcache_probe.asc --npu-arch=dav-3510 -o /tmp/bypass_dcache
//   /tmp/bypass_dcache
#include "../probe_host.h"
#include "kernel_operator.h"
#include <cstdint>
#include <time.h>
#include <cstdio>
using namespace AscendC;

#ifndef SINGLE_CACHE_LINE
#define SINGLE_CACHE_LINE 0
#endif
#ifndef CACHELINE_OUT
#define CACHELINE_OUT 2
#endif

constexpr uint32_t SENTINEL_BASE = 0xA000;
constexpr uint32_t BYPASS_TARGET = 0xBEEF;
constexpr uint32_t ATOMIC_ROUNDS = 100;

__aicore__ inline void dcci_flush_line(__gm__ void *p) {
    dcci(p, SINGLE_CACHE_LINE, CACHELINE_OUT);
}
__aicore__ inline void dcci_inval_line(__gm__ void *p) {
    dcci(p, SINGLE_CACHE_LINE);
}

// Fill gx[0..15] with word sentinels and flush to HBM.
__aicore__ inline void fill_sentinels_words(__gm__ uint32_t *gx) {
    for (uint32_t i = 0; i <= 15; i++) gx[i] = SENTINEL_BASE + i;
    dcci_flush_line(gx);
}

// Fill 64 bytes with unique byte sentinels and flush to HBM.
__aicore__ inline void fill_sentinels_bytes(__gm__ uint32_t *gx) {
    __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
    for (uint32_t i = 0; i < 64; i++) bytes[i] = (uint8_t)(i + 1);
    dcci_flush_line(gx);
}

// =====================================================================
// Kernel
// =====================================================================
__schedmode__(1) __global__ __mix__(0, 1) void bypass_probe(
    __gm__ uint32_t *gx, uint32_t mode)
{
    uint32_t bid = GetBlockIdx();

    // -----------------------------------------------------------------
    // Mode 0: 1-byte ByPassDCache write blast radius
    //   Defender fills 64 bytes with sentinels + flush.
    //   Attacker writes ONLY byte[0] via WriteGmByPassDCache<uint8_t>.
    //   Check: bytes 1-63 intact.  This is the 1-byte test!
    // -----------------------------------------------------------------
    if (mode == 0) {
        SyncAll();
        if (bid == 1) { fill_sentinels_bytes(gx); }
        SyncAll();
        if (bid == 0) {
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            WriteGmByPassDCache<uint8_t>(&bytes[0], 0xFF);
        }
        SyncAll();
        if (bid == 1) {
            dcci_inval_line(gx);
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t corrupted = 0;
            for (uint32_t i = 1; i < 64; i++)
                if (bytes[i] != (uint8_t)(i + 1)) corrupted++;
            WriteGmByPassDCache<uint32_t>(&gx[16], corrupted);
            for (uint32_t i = 0; i <= 15; i++) {
                WriteGmByPassDCache<uint32_t>(&gx[17 + i], ReadGmByPassDCache<uint32_t>(&gx[i]));
            }
        }
        SyncAll();

    // -----------------------------------------------------------------
    // Mode 1: 4-byte ByPassDCache write blast radius
    //   Attacker writes word[0] via WriteGmByPassDCache<uint32_t>.
    //   Check: words 1-15 (bytes 4-63) intact.
    // -----------------------------------------------------------------
    } else if (mode == 1) {
        SyncAll();
        if (bid == 1) { fill_sentinels_bytes(gx); }
        SyncAll();
        if (bid == 0) {
            WriteGmByPassDCache<uint32_t>(&gx[0], 0xFFFFFFFFu);
        }
        SyncAll();
        if (bid == 1) {
            dcci_inval_line(gx);
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t corrupted = 0;
            for (uint32_t i = 4; i < 64; i++)
                if (bytes[i] != (uint8_t)(i + 1)) corrupted++;
            WriteGmByPassDCache<uint32_t>(&gx[16], corrupted);
            for (uint32_t i = 0; i <= 15; i++) {
                WriteGmByPassDCache<uint32_t>(&gx[17 + i], ReadGmByPassDCache<uint32_t>(&gx[i]));
            }
        }
        SyncAll();

    // -----------------------------------------------------------------
    // Mode 2: Concurrent ByPassDCache write + atomic (mode 4 fix)
    //   Block 0: 100× AtomicAdd(&gx[0], 1)
    //   Block 1: WriteGmByPassDCache to words 1-15 (no dcci!)
    //   No sync between them.  Expected PASS — ByPass write doesn't
    //   clobber the atomic result because it never enters L1.
    //   This is the FIX for cacheline_blast mode 4.
    // -----------------------------------------------------------------
    } else if (mode == 2) {
        SyncAll();
        if (bid == 0) {
            for (uint32_t i = 0; i < ATOMIC_ROUNDS; i++)
                AtomicAdd(&gx[0], 1u);
        }
        if (bid == 1) {
            for (uint32_t i = 1; i <= 15; i++)
                WriteGmByPassDCache<uint32_t>(&gx[i], SENTINEL_BASE + i);
        }
        SyncAll();
        if (bid == 1) {
            // Read back via ByPassDCache to avoid stale L1
            uint32_t g0 = ReadGmByPassDCache<uint32_t>(&gx[0]);
            uint32_t corrupted = 0;
            for (uint32_t i = 1; i <= 15; i++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[i]);
                if (v != SENTINEL_BASE + i) corrupted++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], corrupted);
            WriteGmByPassDCache<uint32_t>(&gx[17], g0);
            WriteGmByPassDCache<uint32_t>(&gx[18], ATOMIC_ROUNDS);
            for (uint32_t i = 0; i <= 15; i++) {
                WriteGmByPassDCache<uint32_t>(&gx[19 + i], ReadGmByPassDCache<uint32_t>(&gx[i]));
            }
        }
        SyncAll();

    // -----------------------------------------------------------------
    // Mode 3: ByPassDCache cross-core publish (dcci-free communication)
    //   Block 0: writes data[0..7] via WriteGmByPassDCache, then sets
    //            flag via AtomicAdd(&gx[8], 1).
    //   Block 1: polls flag via ReadGmByPassDCache (no dcci inval
    //            needed!), then reads data via ReadGmByPassDCache.
    //   NO dcci anywhere — the entire communication path is dcci-free.
    // -----------------------------------------------------------------
    } else if (mode == 3) {
        SyncAll();
        if (bid == 0) {
            // Producer: write 8 data words directly to HBM
            for (uint32_t i = 0; i < 8; i++)
                WriteGmByPassDCache<uint32_t>(&gx[i], 0xD0000000u + i);
            // Signal: atomic flag (also bypasses L1)
            AtomicAdd(&gx[8], 1u);
        } else if (bid == 1) {
            // Consumer: poll flag via ByPassDCache read (no dcci!)
            uint32_t flag = 0;
            while (flag < 1) {
                flag = ReadGmByPassDCache<uint32_t>(&gx[8]);
                Nop<800>();  // docs: avoid bus hogging
            }
            // Read data via ByPassDCache (always sees latest HBM)
            uint32_t corrupted = 0;
            for (uint32_t i = 0; i < 8; i++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[i]);
                if (v != 0xD0000000u + i) corrupted++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], corrupted);
            WriteGmByPassDCache<uint32_t>(&gx[17], flag);
            WriteGmByPassDCache<uint32_t>(&gx[18], 1);
            for (uint32_t i = 0; i <= 8; i++) {
                WriteGmByPassDCache<uint32_t>(&gx[19 + i], ReadGmByPassDCache<uint32_t>(&gx[i]));
            }
        }
        SyncAll();

    // -----------------------------------------------------------------
    // Mode 4: ByPass read vs normal scalar read (stale L1 comparison)
    //   Block 0: warms L1 with zeros (normal scalar reads).
    //   Block 1: writes TARGET to gx[0] via WriteGmByPassDCache.
    //   Block 0: reads gx[0] via normal load (may be stale 0) and via
    //            ReadGmByPassDCache (should see TARGET).
    //   Shows: normal load = stale, ByPass load = fresh.
    // -----------------------------------------------------------------
    } else if (mode == 4) {
        SyncAll();
        if (bid == 0) {
            // Warm L1
            volatile __gm__ uint32_t *vgx = gx;
            uint32_t sum = vgx[0] + vgx[1] + vgx[2];  // L1 now has zeros
            (void)sum;
        }
        SyncAll();
        if (bid == 1) {
            WriteGmByPassDCache<uint32_t>(&gx[0], BYPASS_TARGET);
        }
        SyncAll();
        if (bid == 0) {
            // Normal scalar read (goes through L1 — may be stale)
            volatile __gm__ uint32_t *vgx = gx;
            uint32_t normal_read = vgx[0];
            // ByPass read (bypasses L1 — should see latest HBM)
            uint32_t bypass_read = ReadGmByPassDCache<uint32_t>(&gx[0]);
            WriteGmByPassDCache<uint32_t>(&gx[17], normal_read);
            WriteGmByPassDCache<uint32_t>(&gx[18], bypass_read);
            WriteGmByPassDCache<uint32_t>(&gx[19], BYPASS_TARGET);
            WriteGmByPassDCache<uint32_t>(&gx[16], (bypass_read == BYPASS_TARGET) ? 0 : 1);
        }
        SyncAll();

    // -----------------------------------------------------------------
    // Mode 5: ReadGmByPassDCache correctness at 1B/2B/4B/8B width
    //   Block 1 writes 64 bytes via WriteGmByPassDCache<uint8_t>.
    //   Block 0 reads back via ReadGmByPassDCache at 1B, 2B, 4B widths
    //   and verifies each read matches the written pattern.
    // -----------------------------------------------------------------
    } else if (mode == 5) {
        SyncAll();
        if (bid == 1) {
            // Write 64 unique bytes directly to HBM
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            for (uint32_t i = 0; i < 64; i++)
                WriteGmByPassDCache<uint8_t>(&bytes[i], (uint8_t)(0x10 + i));
        }
        SyncAll();
        if (bid == 0) {
            uint32_t errors = 0;
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            // 1-byte reads
            for (uint32_t i = 0; i < 64; i++) {
                uint8_t v = ReadGmByPassDCache<uint8_t>(&bytes[i]);
                if (v != (uint8_t)(0x10 + i)) errors++;
            }
            // 2-byte reads
            __gm__ uint16_t *half = reinterpret_cast<__gm__ uint16_t*>(gx);
            for (uint32_t i = 0; i < 32; i++) {
                uint16_t v = ReadGmByPassDCache<uint16_t>(&half[i]);
                uint16_t exp = (uint16_t)((0x10 + 2*i) | ((0x10 + 2*i + 1) << 8));
                if (v != exp) errors++;
            }
            // 4-byte reads
            for (uint32_t i = 0; i < 16; i++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[i]);
                uint32_t exp = (uint32_t)(0x10 + 4*i) | ((uint32_t)(0x11 + 4*i) << 8) |
                               ((uint32_t)(0x12 + 4*i) << 16) | ((uint32_t)(0x13 + 4*i) << 24);
                if (v != exp) errors++;
            }
            // 8-byte reads
            __gm__ uint64_t *wide = reinterpret_cast<__gm__ uint64_t*>(gx);
            for (uint32_t i = 0; i < 8; i++) {
                uint64_t v = ReadGmByPassDCache<uint64_t>(&wide[i]);
                uint64_t exp = 0;
                for (uint32_t b = 0; b < 8; b++) {
                    exp |= (uint64_t)(uint8_t)(0x10 + 8 * i + b) << (8 * b);
                }
                if (v != exp) errors++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], errors);
            WriteGmByPassDCache<uint32_t>(&gx[17], 64 + 32 + 16 + 8);
        }
        SyncAll();

    // -----------------------------------------------------------------
    // Mode 6: ReadGmByPassDCache does NOT pollute L1
    //   Block 0: normal store gx[0]=0xAA (L1 dirty with 0xAA).
    //   Block 1: WriteGmByPassDCache(&gx[0], TARGET) → HBM = TARGET.
    //   Block 0: ReadGmByPassDCache(&gx[0]) → sees TARGET (from HBM).
    //   Block 0: normal read gx[0] → if L1 not polluted: sees 0xAA (old L1).
    //   Block 0: dcci(CACHELINE_OUT) → flushes L1 (0xAA) to HBM.
    //   Block 1: ReadGmByPassDCache(&gx[0]) → sees 0xAA (dcci clobbered).
    //
    //   If L1 WERE polluted by bypass read, normal read would see TARGET
    //   and dcci would write TARGET back (safe).  We expect NOT polluted:
    //   normal read sees 0xAA, dcci writes 0xAA back.
    // -----------------------------------------------------------------
    } else if (mode == 6) {
        SyncAll();
        if (bid == 0) {
            // Dirty L1 with 0xAA via normal store
            gx[0] = 0xAA;
            // Don't flush — keep 0xAA in L1 only, HBM still has 0
        }
        SyncAll();
        if (bid == 1) {
            // Write TARGET directly to HBM (L1 on block 0 untouched)
            WriteGmByPassDCache<uint32_t>(&gx[0], BYPASS_TARGET);
        }
        SyncAll();
        if (bid == 0) {
            uint32_t bypass_val = ReadGmByPassDCache<uint32_t>(&gx[0]);
            volatile __gm__ uint32_t *vgx = gx;
            uint32_t normal_after = vgx[0];  // normal read after bypass read

            // dcci flush: writes L1 line to HBM
            dcci_flush_line(gx);

            WriteGmByPassDCache<uint32_t>(&gx[17], bypass_val);
            WriteGmByPassDCache<uint32_t>(&gx[18], normal_after);
            WriteGmByPassDCache<uint32_t>(&gx[19], 0xAA);
            WriteGmByPassDCache<uint32_t>(&gx[20], BYPASS_TARGET);
            // polluted? normal_after == BYPASS_TARGET means L1 was overwritten
            WriteGmByPassDCache<uint32_t>(&gx[16], (normal_after == 0xAA) ? 0 : 1);
        }
        SyncAll();
        if (bid == 1) {
            // After block 0's dcci flush, HBM gx[0] should be 0xAA
            // (dcci wrote L1's 0xAA back, clobbering the bypass-written TARGET)
            uint32_t after_flush = ReadGmByPassDCache<uint32_t>(&gx[0]);
            WriteGmByPassDCache<uint32_t>(&gx[21], after_flush);
        }
        SyncAll();
    }

    // Print from AIC only
#ifndef __DAV_VEC__
    if (bid == 0) {
        if (mode <= 1) {
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t check_from = (mode == 0) ? 1 : 4;
            uint32_t bc = 0;
            for (uint32_t i = check_from; i < 64; i++)
                if (bytes[i] != (uint8_t)(i + 1)) bc++;
            printf("mode=%u byte_corrupt=%u/%u first8=", mode, bc, 64 - check_from);
            for (uint32_t i = 0; i < 8; i++) printf("%02x ", bytes[i]);
            printf("\n");
        } else if (mode == 5) {
            printf("mode=%u read_errors=%u/%u\n", mode, gx[16], gx[17]);
        } else if (mode == 6) {
            printf("mode=%u polluted=%u bypass_read=0x%x normal_after=0x%x(exp 0xaa) after_dcci=0x%x\n",
                   mode, gx[16], gx[17], gx[18], gx[21]);
        } else {
            printf("mode=%u corrupt=%u g0_bypass=0x%x flag=%u\n",
                   mode, gx[16], gx[17], gx[18]);
        }
    }
#endif
}

// =====================================================================
// Host
// =====================================================================
int32_t main(int32_t argc, char *argv[])
{
    int32_t deviceId = atomic_probe::DeviceId();
    if (deviceId < 0) {
        return EXIT_FAILURE;
    }
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    constexpr int32_t GX_SIZE = 64;
    uint32_t *gx_dev = nullptr;
    PROBE_ACL_CHECK(aclrtMalloc((void **)&gx_dev, GX_SIZE * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    atomic_probe::Result result;

    const char *mode_names[] = {
        "ByPass1B(blast) ",
        "ByPass4B(blast) ",
        "ByPass+Atomic   ",
        "ByPassPublish   ",
        "ByPassReadVsL1  ",
        "ByPassReadCheck ",
        "ByPassNoPollute ",
    };
    const int NUM_MODES = sizeof(mode_names) / sizeof(mode_names[0]);

    printf("=== WriteGmByPassDCache / ReadGmByPassDCache Probe ===\n");
    printf("st_dev/ld_dev: bypass DCache, write/read GM directly\n\n");

    for (int mode = 0; mode < NUM_MODES; mode++) {
        uint32_t zeros[GX_SIZE] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(gx_dev, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE));

        struct timespec ts_start, ts_end;
        clock_gettime(CLOCK_MONOTONIC, &ts_start);

        bypass_probe<<<2, nullptr, stream>>>(gx_dev, (uint32_t)mode);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

        clock_gettime(CLOCK_MONOTONIC, &ts_end);
        double host_us = (ts_end.tv_sec - ts_start.tv_sec) * 1e6 +
                         (ts_end.tv_nsec - ts_start.tv_nsec) / 1e3;

        uint32_t results[GX_SIZE];
        PROBE_ACL_CHECK(
            aclrtMemcpy(results, sizeof(results), gx_dev, sizeof(results), ACL_MEMCPY_DEVICE_TO_HOST));

        bool pass = false;

        if (mode <= 1) {
            // Byte-level blast radius
            uint8_t *snap = reinterpret_cast<uint8_t*>(&results[17]);
            uint32_t check_from = (mode == 0) ? 1 : 4;
            uint32_t corrupted = 0;
            for (uint32_t i = check_from; i < 64; i++)
                if (snap[i] != (uint8_t)(i + 1)) corrupted++;
            bool target_ok = mode == 0 ? snap[0] == 0xFF
                                       : snap[0] == 0xFF && snap[1] == 0xFF &&
                                             snap[2] == 0xFF && snap[3] == 0xFF;
            pass = (corrupted == 0) && target_ok;
            printf("[%s] mode=%d  corrupted=%u/%u  first8=",
                   mode_names[mode], mode, corrupted, 64 - check_from);
            for (uint32_t i = 0; i < 8; i++) printf("%02x ", snap[i]);
            printf(" %.0fus  %s\n", host_us, pass ? "PASS" : "FAIL");
        } else if (mode == 2) {
            uint32_t corrupted = results[16];
            uint32_t g0 = results[17];
            pass = (corrupted == 0) && (g0 == ATOMIC_ROUNDS);
            printf("[%s] mode=%d  corrupt=%u/15  gx0=%u(exp %u)  %.0fus  %s\n",
                   mode_names[mode], mode, corrupted, g0, ATOMIC_ROUNDS,
                   host_us, pass ? "PASS" : "FAIL");
        } else if (mode == 3) {
            uint32_t corrupted = results[16];
            pass = (corrupted == 0) && (results[17] == 1);
            printf("[%s] mode=%d  corrupt=%u/8  flag=%u  %.0fus  %s\n",
                   mode_names[mode], mode, corrupted, results[17],
                   host_us, pass ? "PASS" : "FAIL");
        } else if (mode == 4) {
            uint32_t normal_read = results[17];
            uint32_t bypass_read = results[18];
            uint32_t expected    = results[19];
            bool bypass_ok = (bypass_read == expected);
            pass = bypass_ok;
            printf("[%s] mode=%d  normal=0x%x  bypass=0x%x  exp=0x%x  %.0fus  bypass:%s\n",
                   mode_names[mode], mode, normal_read, bypass_read, expected,
                   host_us, bypass_ok ? "OK" : "FAIL");
            printf("  -> normal read %s (stale L1)\n",
                   (normal_read == expected) ? "sees latest" : "STALE");
        } else if (mode == 5) {
            uint32_t errors = results[16];
            uint32_t total  = results[17];
            pass = (errors == 0) && (total == 120);
            printf("[%s] mode=%d  read_errors=%u/%u  %.0fus  %s\n",
                   mode_names[mode], mode, errors, total,
                   host_us, pass ? "PASS" : "FAIL");
        } else if (mode == 6) {
            uint32_t polluted     = results[16];
            uint32_t bypass_val   = results[17];
            uint32_t normal_after = results[18];
            uint32_t after_dcci   = results[21];
            bool not_polluted = (polluted == 0);
            pass = not_polluted && bypass_val == BYPASS_TARGET && normal_after == 0xAA && after_dcci == 0xAA;
            printf("[%s] mode=%d  bypass=0x%x normal_after=0x%x(exp 0xaa) after_dcci=0x%x  %.0fus  L1:%s\n",
                   mode_names[mode], mode, bypass_val, normal_after, after_dcci,
                   host_us, not_polluted ? "CLEAN" : "POLLUTED");
        }

        char assertion[80];
        std::snprintf(assertion, sizeof(assertion), "bypass mode %d exact result", mode);
        result.Expect(pass, assertion);
    }

    printf("\n=== Summary ===\n");
    printf("WriteGmByPassDCache: tested single writes preserve their exact width\n");
    printf("ReadGmByPassDCache: tested reads bypass the local DCache\n");
    printf("Repeated cross-AIV same-line writes are covered by st_dev_same_line\n");
    printf("Supports: int8/uint8/int16/uint16/int32/uint32/int64/uint64\n");

    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(gx_dev), "aclrtFree(gx_dev)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    result.Expect(cleanup_ok, "ACL cleanup");
    return result.ExitCode();
}
