// 64-bit atomic verification probe.
//
// Question: is atomicAdd<uint64_t> / atomicMax<int64_t> truly atomic
// on A5, or is it emulated via two 32-bit operations?
//
// Test: N blocks concurrently increment/max a shared counter.
// If 64-bit atomic is real: final value = N × ROUNDS (0 lost updates).
// If emulated/broken: final value < expected (lost updates).
//
// Modes:
//   0 = atomicAdd<uint32_t>  — baseline (known good)
//   1 = atomicAdd<uint64_t>  — test target
//   2 = AtomicMax<uint32_t>  — baseline
//   3 = AtomicMax<int64_t>   — test target
//
// Build:
//   bisheng -xasc atomic64_verify.asc --npu-arch=dav-3510 -o /tmp/atomic64
//   /tmp/atomic64
#include "../probe_host.h"
#include "kernel_operator.h"
#include <cstdint>
#include <cstdio>
using namespace AscendC;

constexpr uint32_t ROUNDS = 100000;

__schedmode__(1) __global__ __mix__(0, 1) void atomic64_test(
    __gm__ uint32_t *gx, uint32_t mode, uint32_t num_blocks)
{
    uint32_t bid = GetBlockIdx();
    uint32_t nb = num_blocks;

    SyncAll();

    if (mode == 0) {
        // atomicAdd<uint32_t>: each block adds 1 per round
        for (uint32_t r = 0; r < ROUNDS; r++)
            AtomicAdd(&gx[0], 1u);
    } else if (mode == 1) {
        // atomicAdd<uint64_t>: counter at gx[0..1] (8 bytes)
        __gm__ uint64_t *counter64 = reinterpret_cast<__gm__ uint64_t*>(&gx[0]);
        for (uint32_t r = 0; r < ROUNDS; r++)
            AtomicAdd(counter64, (uint64_t)1);
    } else if (mode == 2) {
        // AtomicMax<uint32_t>: each block writes bid*ROUNDS+r
        for (uint32_t r = 0; r < ROUNDS; r++)
            AtomicMax(&gx[0], (uint32_t)(bid * ROUNDS + r + 1));
    } else if (mode == 3) {
        // AtomicMax<int64_t>: 64-bit max
        __gm__ int64_t *counter64 = reinterpret_cast<__gm__ int64_t*>(&gx[0]);
        for (uint32_t r = 0; r < ROUNDS; r++)
            AtomicMax(counter64, (int64_t)((int64_t)bid * ROUNDS + r + 1));
    }

    SyncAll();

    // Results read by host (block 0 writes nothing extra)
    // gx[0..1] = counter (for 32-bit: gx[0] only; for 64-bit: gx[0..1])
    // gx[2] = num_blocks (for host reference)
    if (bid == 0) {
        WriteGmByPassDCache<uint32_t>(&gx[2], nb);
        WriteGmByPassDCache<uint32_t>(&gx[3], ROUNDS);
    }
    SyncAll();
}

int32_t main() {
    int32_t deviceId = atomic_probe::DeviceId();
    if (deviceId < 0) {
        return EXIT_FAILURE;
    }
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    uint32_t *gx = nullptr;
    PROBE_ACL_CHECK(aclrtMalloc((void **)&gx, 64, ACL_MEM_MALLOC_HUGE_FIRST));
    atomic_probe::Result result;

    const char *names[] = {
        "atomicAdd<u32>",
        "atomicAdd<u64>",
        "AtomicMax<u32>",
        "AtomicMax<i64>",
    };

    printf("=== 64-Bit Atomic Verification ===\n");
    printf("Each test: N blocks × %u rounds\n\n", ROUNDS);

    // Test with 2, 3, 4 blocks
    uint32_t block_counts[] = {2, 3, 4};

    for (int mode = 0; mode < 4; mode++) {
        for (size_t bi = 0; bi < sizeof(block_counts)/sizeof(block_counts[0]); bi++) {
            uint32_t nblk = block_counts[bi];

            // Zero gx
            uint32_t zeros[16] = {0};
            PROBE_ACL_CHECK(aclrtMemcpy(gx, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE));

            atomic64_test<<<nblk, nullptr, stream>>>(gx, (uint32_t)mode, nblk);
            PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

            uint32_t r[16] = {0};
            PROBE_ACL_CHECK(aclrtMemcpy(r, sizeof(r), gx, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST));

            uint64_t counter64 = (uint64_t)r[0] | ((uint64_t)r[1] << 32);
            uint64_t expected = (uint64_t)nblk * ROUNDS;

            if (mode <= 1) {
                // atomicAdd: expect counter == nblk * ROUNDS
                uint64_t actual = (mode == 0) ? r[0] : counter64;
                uint64_t exp = (uint64_t)nblk * ROUNDS;
                bool ok = (actual == exp);
                printf("[%s] blk=%u  actual=%lu  expected=%lu  lost=%lu  %s\n",
                       names[mode], nblk, actual, exp, exp - actual,
                       ok ? "OK" : "FAIL");
                char assertion[80];
                std::snprintf(assertion, sizeof(assertion), "%s exact, blocks=%u", names[mode], nblk);
                result.Expect(ok, assertion);
            } else {
                // AtomicMax: expect max value = (nblk-1)*ROUNDS + ROUNDS = nblk*ROUNDS
                uint64_t actual = (mode == 2) ? r[0] : counter64;
                uint64_t exp = (uint64_t)nblk * ROUNDS; // last block's last round = nblk*ROUNDS
                bool ok = (actual == exp);
                printf("[%s] blk=%u  actual=%lu  expected=%lu  %s\n",
                       names[mode], nblk, actual, exp,
                       ok ? "OK" : "FAIL");
                char assertion[80];
                std::snprintf(assertion, sizeof(assertion), "%s exact, blocks=%u", names[mode], nblk);
                result.Expect(ok, assertion);
            }
        }
        printf("\n");
    }

    printf("=== Conclusion ===\n");
    printf("If all OK: A5 64-bit atomics are truly hardware-atomic.\n");
    printf("If atomicAdd<u64> FAIL: 64-bit atomic is emulated (non-atomic).\n");

    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(gx), "aclrtFree(gx)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    result.Expect(cleanup_ok, "ACL cleanup");
    return result.ExitCode();
}
