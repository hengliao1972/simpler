// Authoritative AscendC cache-line matrix.
//
// PROBE_CORE_VARIANT:
//   0 = AIV only (__mix__(0, 1))
//   2 = AIC + AIV (__mix__(1, 1))
//
// Modes 0..3 write 1B/2B/4B/8B distinct slots in one 64B cache line.
// Modes 4..7 write the same widths to one separate cache line per participant.
// Every participant repeatedly uses WriteGmByPassDCache and a designated
// verifier checks the exact final value with ReadGmByPassDCache.
#include "../probe_host.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>

using namespace AscendC;

#ifndef PROBE_CORE_VARIANT
#define PROBE_CORE_VARIANT 0
#endif

#if PROBE_CORE_VARIANT == 0
#define PROBE_CORE_ATTRIBUTE __mix__(0, 1)
constexpr uint32_t CORES_PER_BLOCK = 1;
#elif PROBE_CORE_VARIANT == 2
#define PROBE_CORE_ATTRIBUTE __mix__(1, 1)
constexpr uint32_t CORES_PER_BLOCK = 2;
#else
#error "PROBE_CORE_VARIANT must be 0 (AIV) or 2 (MIX)"
#endif

constexpr uint32_t STORAGE_WORDS = 512;
constexpr uint32_t CONTROL_WORD = 256;
constexpr uint32_t MARKER_WORD = CONTROL_WORD + 16;
constexpr uint32_t MATRIX_ROUNDS = 257;
constexpr uint32_t DONE_MAGIC = 0xCACE3510u;

template <typename T>
__aicore__ inline T MatrixValue(uint32_t participant, uint32_t round)
{
    uint64_t value = 0xA5A5A5A5A5A5A5A5ULL;
    value += (uint64_t)(participant + 1) * 0x0101010101010101ULL;
    value += round;
    return static_cast<T>(value);
}

template <typename T>
inline T HostMatrixValue(uint32_t participant, uint32_t round)
{
    uint64_t value = 0xA5A5A5A5A5A5A5A5ULL;
    value += (uint64_t)(participant + 1) * 0x0101010101010101ULL;
    value += round;
    return static_cast<T>(value);
}

__aicore__ inline uint32_t CoreKind()
{
#ifdef __DAV_VEC__
    return 1;
#else
    return 0;
#endif
}

__aicore__ inline uint32_t ParticipantId(uint32_t block_idx)
{
#if PROBE_CORE_VARIANT == 2
    return block_idx * 2 + CoreKind();
#else
    return block_idx;
#endif
}

__aicore__ inline uint32_t MarkerValue(uint32_t participant)
{
    uint32_t core_tag = CoreKind() == 0 ? 0xA1C00000u : 0xA1A00000u;
    return core_tag | participant;
}

__aicore__ inline void MatrixSyncAll()
{
    // This probe verifies peer-visible GM data immediately after SyncAll, so
    // it explicitly completes its preceding bypass writes before rendezvous.
    DataSyncBarrier<MemDsbT::ALL>();
#if PROBE_CORE_VARIANT == 0
    SyncAll<true>();
#else
    SyncAll<false>();
#endif
}

template <typename T>
__aicore__ inline void RunWidth(__gm__ uint8_t *storage, uint32_t mode, uint32_t participant,
                                uint32_t participants, __gm__ uint32_t *control)
{
    bool separate_lines = mode >= 4;
    uint32_t byte_offset = separate_lines ? participant * 64 : participant * sizeof(T);
    __gm__ T *slot = reinterpret_cast<__gm__ T *>(&storage[byte_offset]);

    for (uint32_t round = 0; round < MATRIX_ROUNDS; round++) {
        WriteGmByPassDCache<T>(slot, MatrixValue<T>(participant, round));
        // The oracle requires round N to precede round N+1. Serialize that
        // test protocol explicitly; this is not an API-wide usage rule.
        DataSyncBarrier<MemDsbT::ALL>();
    }

    MatrixSyncAll();

    if (participant == 0) {
        uint32_t errors = 0;
        uint32_t marker_errors = 0;
        for (uint32_t p = 0; p < participants; p++) {
            uint32_t offset = separate_lines ? p * 64 : p * sizeof(T);
            __gm__ T *candidate = reinterpret_cast<__gm__ T *>(&storage[offset]);
            T actual = ReadGmByPassDCache<T>(candidate);
            T expected = MatrixValue<T>(p, MATRIX_ROUNDS - 1);
            if (actual != expected) errors++;

            uint32_t marker = ReadGmByPassDCache<uint32_t>(&control[16 + p]);
#if PROBE_CORE_VARIANT == 0
            uint32_t marker_kind = 1;
#else
            uint32_t marker_kind = p & 1u;
#endif
            uint32_t marker_expected = (marker_kind == 0 ? 0xA1C00000u : 0xA1A00000u) | p;
            if (marker != marker_expected) marker_errors++;
        }
        WriteGmByPassDCache<uint32_t>(&control[4], errors);
        WriteGmByPassDCache<uint32_t>(&control[5], participants);
        WriteGmByPassDCache<uint32_t>(&control[6], DONE_MAGIC);
        WriteGmByPassDCache<uint32_t>(&control[7], mode);
        WriteGmByPassDCache<uint32_t>(&control[8], marker_errors);
    }

    MatrixSyncAll();
}

__schedmode__(1) __global__ PROBE_CORE_ATTRIBUTE void cacheline_matrix(
    __gm__ uint8_t *storage, uint32_t mode, uint32_t num_blocks)
{
    __gm__ uint32_t *words = reinterpret_cast<__gm__ uint32_t *>(storage);
    __gm__ uint32_t *control = &words[CONTROL_WORD];
    // GetBlockIdx() flattens AIV subblocks on dav-3510. The launch-level
    // identity shared by AIC/AIV in a MIX pair is the raw get_block_idx().
    uint32_t participant = ParticipantId((uint32_t)get_block_idx());
    uint32_t participants = num_blocks * CORES_PER_BLOCK;

    AtomicAdd(&control[1], 1u);
    if (CoreKind() == 0) {
        AtomicAdd(&control[2], 1u);
    } else {
        AtomicAdd(&control[3], 1u);
    }
    WriteGmByPassDCache<uint32_t>(&words[MARKER_WORD + participant], MarkerValue(participant));
    MatrixSyncAll();

    switch (mode & 3u) {
        case 0:
            RunWidth<uint8_t>(storage, mode, participant, participants, control);
            break;
        case 1:
            RunWidth<uint16_t>(storage, mode, participant, participants, control);
            break;
        case 2:
            RunWidth<uint32_t>(storage, mode, participant, participants, control);
            break;
        default:
            RunWidth<uint64_t>(storage, mode, participant, participants, control);
            break;
    }
}

int32_t main()
{
    int32_t device_id = atomic_probe::DeviceId();
    if (device_id < 0) return EXIT_FAILURE;
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(device_id));

    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));
    uint8_t *storage_device = nullptr;
    PROBE_ACL_CHECK(aclrtMalloc((void **)&storage_device, STORAGE_WORDS * sizeof(uint32_t),
                                ACL_MEM_MALLOC_HUGE_FIRST));

    const char *variant_names[] = {"AIV", nullptr, "AIC+AIV"};
    const char *width_names[] = {"1B", "2B", "4B", "8B"};
    const uint32_t block_counts[] = {2, 4};
    atomic_probe::Result result;

    uint32_t first_mode = 0;
    uint32_t last_mode = 8;
    const char *mode_filter = std::getenv("ATOMIC_PROBE_MATRIX_MODE");
    if (mode_filter != nullptr && mode_filter[0] != '\0') {
        char *end = nullptr;
        unsigned long selected = std::strtoul(mode_filter, &end, 10);
        if (end == mode_filter || *end != '\0' || selected >= 8) {
            std::fprintf(stderr, "Invalid ATOMIC_PROBE_MATRIX_MODE: %s\n", mode_filter);
            return EXIT_FAILURE;
        }
        first_mode = (uint32_t)selected;
        last_mode = first_mode + 1;
    }

    std::printf("=== AscendC Exact Cache-Line Matrix: %s ===\n", variant_names[PROBE_CORE_VARIANT]);
    for (uint32_t blocks : block_counts) {
        uint32_t expected_participants = blocks * CORES_PER_BLOCK;
        uint32_t expected_aic = PROBE_CORE_VARIANT == 0 ? 0 : blocks;
        uint32_t expected_aiv = blocks;

        for (uint32_t mode = first_mode; mode < last_mode; mode++) {
            uint32_t zeros[STORAGE_WORDS] = {0};
            PROBE_ACL_CHECK(aclrtMemcpy(storage_device, sizeof(zeros), zeros, sizeof(zeros),
                                       ACL_MEMCPY_HOST_TO_DEVICE));

            cacheline_matrix<<<blocks, nullptr, stream>>>(storage_device, mode, blocks);
            PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

            uint32_t host[STORAGE_WORDS] = {0};
            PROBE_ACL_CHECK(aclrtMemcpy(host, sizeof(host), storage_device, sizeof(host),
                                       ACL_MEMCPY_DEVICE_TO_HOST));
            uint32_t *control = &host[CONTROL_WORD];
            bool pass = control[1] == expected_participants && control[2] == expected_aic &&
                        control[3] == expected_aiv && control[4] == 0 && control[8] == 0 &&
                        control[5] == expected_participants && control[6] == DONE_MAGIC &&
                        control[7] == mode;
            std::printf("[%s %-9s] blocks=%u participants=%u (AIC=%u AIV=%u) data_err=%u marker_err=%u %s\n",
                        width_names[mode & 3u], mode < 4 ? "same-line" : "separate",
                        blocks, control[1], control[2], control[3], control[4], control[8],
                        pass ? "PASS" : "FAIL");
            if (!pass) {
                std::printf("  markers:");
                for (uint32_t p = 0; p < expected_participants; p++) {
                    std::printf(" [%u]=0x%08x", p, host[MARKER_WORD + p]);
                }
                std::printf("\n");
                std::printf("  values:");
                for (uint32_t p = 0; p < expected_participants; p++) {
                    uint32_t offset = mode < 4 ? p * (1u << (mode & 3u)) : p * 64;
                    uint64_t actual = 0;
                    uint64_t expected = 0;
                    switch (mode & 3u) {
                        case 0:
                            actual = reinterpret_cast<uint8_t *>(host)[offset];
                            expected = HostMatrixValue<uint8_t>(p, MATRIX_ROUNDS - 1);
                            break;
                        case 1:
                            actual = *reinterpret_cast<uint16_t *>(reinterpret_cast<uint8_t *>(host) + offset);
                            expected = HostMatrixValue<uint16_t>(p, MATRIX_ROUNDS - 1);
                            break;
                        case 2:
                            actual = *reinterpret_cast<uint32_t *>(reinterpret_cast<uint8_t *>(host) + offset);
                            expected = HostMatrixValue<uint32_t>(p, MATRIX_ROUNDS - 1);
                            break;
                        default:
                            actual = *reinterpret_cast<uint64_t *>(reinterpret_cast<uint8_t *>(host) + offset);
                            expected = HostMatrixValue<uint64_t>(p, MATRIX_ROUNDS - 1);
                            break;
                    }
                    std::printf(" [%u]=0x%016lx/0x%016lx", p, (unsigned long)actual,
                                (unsigned long)expected);
                }
                std::printf("\n");
            }
            char assertion[112];
            std::snprintf(assertion, sizeof(assertion), "%s %s %s blocks=%u exact",
                          variant_names[PROBE_CORE_VARIANT], width_names[mode & 3u],
                          mode < 4 ? "same-line" : "separate", blocks);
            result.Expect(pass, assertion);
        }
    }

    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(storage_device), "aclrtFree(storage_device)",
                                         __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)",
                                         __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtResetDevice(device_id), "aclrtResetDevice(device_id)",
                                         __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    result.Expect(cleanup_ok, "ACL cleanup");
    return result.ExitCode();
}
