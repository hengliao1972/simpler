// Multi-core AtomicCAS contention latency benchmark (AscendC API).
//
// All blocks race on the same GM word via AtomicCas, measuring per-block
// cycle count to characterize cross-core atomic contention scaling.
//
// Protocol per launch:
//   1. SyncAll
//   2. Each block: 100× AtomicCas(&gx[0], 1000, 2000)
//      - First block's first CAS succeeds: gx[0] 1000→2000
//      - All remaining CAS fail (2000≠1000) but still contend on HW atomic path
//   3. Each block records its cycle count + CAS success count to result buffer
//   4. SyncAll
//
// Result layout (gx as uint32_t):
//   gx[0]           = CAS target (init 1000)
//   gx[1 + bid]     = block bid cycle count (lower 32 bits)
//   gx[65 + bid]    = block bid CAS success count
//
// Build:
//   bisheng -xasc atomic.asc --npu-arch=dav-3510 -o /tmp/atomic_ascendc
//   /tmp/atomic_ascendc
#include "../probe_host.h"
#include "kernel_operator.h"
#include <time.h>
#include <cstdio>
using namespace AscendC;

constexpr int32_t CAS_ROUNDS = 100;
constexpr int32_t MAX_BLOCKS = 64;

__schedmode__(1) __global__ __mix__(0, 1) void atomic_cas_bench(
    __gm__ uint32_t *gx, uint32_t num_blocks)
{
    (void)num_blocks;
    uint32_t bid = GetBlockIdx();

    SyncAll();

    int64_t cycle_before = GetSystemCycle();
    uint32_t cas_success = 0;

    for (int32_t i = 0; i < CAS_ROUNDS; i++) {
        uint32_t old = AtomicCas(&gx[0], (uint32_t)1000, (uint32_t)2000);
        if (old == 1000) cas_success++;
    }

    int64_t cycle_after = GetSystemCycle();
    int64_t num_cycle = cycle_after - cycle_before;

    // Store per-block results
    WriteGmByPassDCache<uint32_t>(&gx[1 + bid], (uint32_t)num_cycle);
    WriteGmByPassDCache<uint32_t>(&gx[65 + bid], cas_success);

    SyncAll();
}

int32_t main(int32_t argc, char *argv[])
{
    int32_t deviceId = atomic_probe::DeviceId();
    if (deviceId < 0) {
        return EXIT_FAILURE;
    }
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(deviceId));

    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    uint32_t *gx_dev = nullptr;
    PROBE_ACL_CHECK(aclrtMalloc((void **)&gx_dev, 256 * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    atomic_probe::Result result;

    printf("=== AtomicCAS Contention Latency (AscendC) ===\n");
    printf("CAS_ROUNDS=%d per block\n\n", CAS_ROUNDS);
    printf("%-12s %12s %12s %12s %12s %10s %10s\n",
           "NUM_BLOCKS", "Host(us)", "Blk0_cycle", "Min_cycle", "Max_cycle", "CAS_ok", "TotalCAS");

    uint32_t key_blocks[] = {1, 2, 4, 8, 16, 32, 64};
    for (size_t i = 0; i < sizeof(key_blocks) / sizeof(key_blocks[0]); i++) {
        uint32_t nblk = key_blocks[i];

        // Init: CAS target = 1000, results = 0
        uint32_t init[256] = {0};
        init[0] = 1000;
        PROBE_ACL_CHECK(aclrtMemcpy(gx_dev, sizeof(init), init, sizeof(init), ACL_MEMCPY_HOST_TO_DEVICE));

        struct timespec ts0, ts1;
        clock_gettime(CLOCK_MONOTONIC, &ts0);

        atomic_cas_bench<<<nblk, nullptr, stream>>>(gx_dev, nblk);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

        clock_gettime(CLOCK_MONOTONIC, &ts1);
        double host_us = (ts1.tv_sec - ts0.tv_sec) * 1e6 + (ts1.tv_nsec - ts0.tv_nsec) / 1e3;

        uint32_t r[256];
        PROBE_ACL_CHECK(aclrtMemcpy(r, sizeof(r), gx_dev, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST));

        // Statistics across blocks
        uint32_t min_cyc = 0xFFFFFFFF, max_cyc = 0;
        uint32_t total_cas = 0;
        for (uint32_t b = 0; b < nblk; b++) {
            uint32_t cyc = r[1 + b];
            if (cyc < min_cyc) min_cyc = cyc;
            if (cyc > max_cyc) max_cyc = cyc;
            total_cas += r[65 + b];
        }

        printf("%-12u %12.1f %12u %12u %12u %10u %10u\n",
               nblk, host_us, r[1], min_cyc, max_cyc, total_cas, nblk * CAS_ROUNDS);
        char assertion[80];
        std::snprintf(assertion, sizeof(assertion), "CAS exact result, blocks=%u", nblk);
        result.Expect(r[0] == 2000 && total_cas == 1, assertion);
    }

    // Full 1~MAX sweep for curve plotting
    printf("\n--- Full sweep (block 0 cycles) ---\n");
    printf("blocks cycles\n");
    bool sweep_ok = true;
    for (uint32_t nblk = 1; nblk <= MAX_BLOCKS; nblk++) {
        uint32_t init[256] = {0};
        init[0] = 1000;
        PROBE_ACL_CHECK(aclrtMemcpy(gx_dev, sizeof(init), init, sizeof(init), ACL_MEMCPY_HOST_TO_DEVICE));

        atomic_cas_bench<<<nblk, nullptr, stream>>>(gx_dev, nblk);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

        uint32_t r[256];
        PROBE_ACL_CHECK(aclrtMemcpy(r, sizeof(r), gx_dev, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST));
        uint32_t total_cas = 0;
        for (uint32_t b = 0; b < nblk; b++) total_cas += r[65 + b];
        sweep_ok &= r[0] == 2000 && total_cas == 1;
        printf("%u %u\n", nblk, r[1]);
    }
    result.Expect(sweep_ok, "CAS exact result across 1..64 blocks");

    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(gx_dev), "aclrtFree(gx_dev)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    result.Expect(cleanup_ok, "ACL cleanup");
    return result.ExitCode();
}
