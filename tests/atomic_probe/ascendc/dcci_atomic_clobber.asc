// 测试目标：精确验证“普通 scalar store 留下的 dirty cacheline”在随后执行 DCCI 时，
// 是否会把另一个 AIV 已完成的 AtomicExch 更新回滚；同时区分 CACHELINE_ALL、
// CACHELINE_OUT、CACHELINE_ATOMIC 和完全不执行 DCCI 四种行为。
//
// 八个对象 data、atomic_data、ready、done、writer_marker、result 以及两条完整快照分别由独立的
// 64B allocation 承载。ready/done 只负责编排时序，绝不与被测 data line 共线。
//
// 固定时序（两个 AIV，不存在并发操作被测 data line）：
//   1. 核0用普通 scalar load 预读 data 与 atomic_data 的完整 64B 初值；随后仅用
//      普通 scalar store 修改 data[3]，使 data line 成为带有旧 data[0] 的 dirty line。
//   2. 核0执行 DSB，再通过独立 ready line 上的 AtomicExch 把写权限交给核1。
//   3. 核1观察 ready，执行 DSB，然后对目标 slot 执行一次 AtomicExch；保存该原子
//      指令返回的旧值，执行 DSB，再通过独立 done line 把权限交还核0。
//   4. 核0观察 done，执行 DSB；按 mode 对 data line 执行指定 DCCI（或不执行），
//      再执行 DSB，最后用 ld_dev 读取 data 与 atomic_data 两条完整 cacheline。
//
// Mode：
//   0 CACHELINE_ALL，同 line：AtomicExch 目标是 data[0]。
//   1 CACHELINE_OUT，同 line：AtomicExch 目标是 data[0]。
//   2 CACHELINE_ATOMIC，同 line：AtomicExch 目标是 data[0]。
//   3 NO DCCI，同 line：AtomicExch 目标是 data[0]。
//   4 CACHELINE_ALL，分 line：AtomicExch 目标是 atomic_data[0]。
//   5 CACHELINE_OUT，分 line：AtomicExch 目标是 atomic_data[0]。
//   6 CACHELINE_ATOMIC，分 line：AtomicExch 目标是 atomic_data[0]。
//   7 NO DCCI，分 line：AtomicExch 目标是 atomic_data[0]。
//
// 精确判定：
//   - 所有 mode 都必须满足：八个对象独占 cacheline、核0预读完整且正确、ready/done
//     精确、核1的 AtomicExch 返回目标初值、所有非目标 slot 保持逐 word 精确。
//   - mode 3/7 必须满足：AtomicExch 新值保留，data[3] 的普通 dirty store 未发布到 GM。
//   - mode 0/1/2 是正确性看护：DCCI 后 AtomicExch 新值必须保留；若观测到 DCCI
//     发布 ordinary dirty line 并用旧目标快照覆盖新值，则用例必须失败并打印精确分类。
//   - mode 4/5/6 必须精确满足：DCCI 发布 data dirty line；与其分离的 AtomicExch
//     新值始终保留。以上行为由本机 A5 的 AscendC/CCEC 同构用例交叉确认。
#include "../probe_host.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>

using namespace AscendC;

constexpr uint32_t CACHELINE_BYTES = 64;
constexpr uint32_t CACHELINE_WORDS = CACHELINE_BYTES / sizeof(uint32_t);
constexpr uint32_t NUM_MODES = 8;
constexpr uint32_t TARGET_WORD = 0;
constexpr uint32_t DIRTY_WORD = 3;

constexpr uint32_t READY_PHASE = 0x101u;
constexpr uint32_t DONE_PHASE = 0x202u;
constexpr uint32_t WRITER_MAGIC = 0x57524954u;
constexpr uint32_t CORE0_MAGIC = 0x434f5240u;
constexpr uint32_t CORE1_MAGIC = 0x434f5241u;
constexpr uint32_t RESULT_MAGIC_VALUE = 0x41534344u;

constexpr uint32_t RESULT_MAGIC = 0;
constexpr uint32_t RESULT_MODE = 1;
constexpr uint32_t RESULT_PRELOAD_DATA_BAD = 2;
constexpr uint32_t RESULT_PRELOAD_ATOMIC_BAD = 3;
constexpr uint32_t RESULT_TARGET_ACTUAL = 4;
constexpr uint32_t RESULT_DIRTY_ACTUAL = 5;
constexpr uint32_t RESULT_DATA_OTHER_BAD = 6;
constexpr uint32_t RESULT_ATOMIC_OTHER_BAD = 7;
constexpr uint32_t RESULT_DATA_HASH = 8;
constexpr uint32_t RESULT_ATOMIC_HASH = 9;
constexpr uint32_t RESULT_ATOMIC_SURVIVED = 10;
constexpr uint32_t RESULT_ATOMIC_ROLLED_BACK = 11;
constexpr uint32_t RESULT_DIRTY_PUBLISHED = 12;
constexpr uint32_t RESULT_DIRTY_UNPUBLISHED = 13;
constexpr uint32_t RESULT_CORE0_MARKER = 14;
constexpr uint32_t RESULT_RESERVED = 15;

__aicore__ inline uint32_t InitialDataValue(uint32_t mode, uint32_t word)
{
    return 0x11000000u + mode * 0x00100000u + word;
}

__aicore__ inline uint32_t InitialAtomicValue(uint32_t mode, uint32_t word)
{
    return 0x22000000u + mode * 0x00100000u + word;
}

__aicore__ inline uint32_t DirtyValue(uint32_t mode)
{
    return 0xD1700000u + mode;
}

__aicore__ inline uint32_t AtomicValue(uint32_t mode)
{
    return 0xA7000000u + mode;
}

__aicore__ inline uint32_t UpdateHash(uint32_t hash, uint32_t value)
{
    return (hash ^ value) * 16777619u;
}

__aicore__ inline void ApplySelectedDcci(__gm__ uint32_t *data, uint32_t mode)
{
    uint32_t selector = mode & 3u;
    if (selector == 0) {
        dcci(data, SINGLE_CACHE_LINE, CACHELINE_ALL);
    } else if (selector == 1) {
        dcci(data, SINGLE_CACHE_LINE, CACHELINE_OUT);
    } else if (selector == 2) {
        dcci(data, SINGLE_CACHE_LINE, CACHELINE_ATOMIC);
    }
}

__schedmode__(1) __global__ __mix__(0, 1) void dcci_atomic_clobber(
    __gm__ uint32_t *data, __gm__ uint32_t *atomic_data, __gm__ uint32_t *ready,
    __gm__ uint32_t *done, __gm__ uint32_t *writer_marker, __gm__ uint32_t *result,
    __gm__ uint32_t *data_snapshot_out, __gm__ uint32_t *atomic_snapshot_out,
    uint32_t mode)
{
    uint32_t participant = static_cast<uint32_t>(GetBlockIdx());
    bool same_line = mode < 4;
    __gm__ uint32_t *atomic_target = same_line ? data : atomic_data;

    if (participant == 1) {
        while (AtomicMax(&ready[0], 0u) != READY_PHASE) {
        }
        DataSyncBarrier<MemDsbT::ALL>();

        uint32_t old_value = AtomicExch(&atomic_target[TARGET_WORD], AtomicValue(mode));
        DataSyncBarrier<MemDsbT::ALL>();

        WriteGmByPassDCache<uint32_t>(&writer_marker[0], WRITER_MAGIC);
        WriteGmByPassDCache<uint32_t>(&writer_marker[1], mode);
        WriteGmByPassDCache<uint32_t>(&writer_marker[2], old_value);
        WriteGmByPassDCache<uint32_t>(&writer_marker[3], AtomicValue(mode));
        WriteGmByPassDCache<uint32_t>(&writer_marker[4], same_line ? 1u : 0u);
        WriteGmByPassDCache<uint32_t>(&writer_marker[5], CORE1_MAGIC);
        DataSyncBarrier<MemDsbT::ALL>();
        AtomicExch(&done[0], DONE_PHASE);
        return;
    }

    if (participant != 0) {
        return;
    }

    volatile __gm__ uint32_t *normal_data = data;
    volatile __gm__ uint32_t *normal_atomic_data = atomic_data;
    uint32_t preload_data_bad = 0;
    uint32_t preload_atomic_bad = 0;
    for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
        if (normal_data[word] != InitialDataValue(mode, word)) {
            ++preload_data_bad;
        }
        if (normal_atomic_data[word] != InitialAtomicValue(mode, word)) {
            ++preload_atomic_bad;
        }
    }

    normal_data[DIRTY_WORD] = DirtyValue(mode);
    DataSyncBarrier<MemDsbT::ALL>();
    AtomicExch(&ready[0], READY_PHASE);

    while (AtomicMax(&done[0], 0u) != DONE_PHASE) {
    }
    DataSyncBarrier<MemDsbT::ALL>();
    ApplySelectedDcci(data, mode);
    DataSyncBarrier<MemDsbT::ALL>();

    uint32_t data_snapshot[CACHELINE_WORDS];
    uint32_t atomic_snapshot[CACHELINE_WORDS];
    uint32_t data_hash = 2166136261u;
    uint32_t atomic_hash = 2166136261u;
    uint32_t data_other_bad = 0;
    uint32_t atomic_other_bad = 0;
    for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
        data_snapshot[word] = ReadGmByPassDCache<uint32_t>(&data[word]);
        atomic_snapshot[word] = ReadGmByPassDCache<uint32_t>(&atomic_data[word]);
        WriteGmByPassDCache<uint32_t>(&data_snapshot_out[word], data_snapshot[word]);
        WriteGmByPassDCache<uint32_t>(&atomic_snapshot_out[word], atomic_snapshot[word]);
        data_hash = UpdateHash(data_hash, data_snapshot[word]);
        atomic_hash = UpdateHash(atomic_hash, atomic_snapshot[word]);

        bool data_is_changed_slot = word == DIRTY_WORD || (same_line && word == TARGET_WORD);
        if (!data_is_changed_slot && data_snapshot[word] != InitialDataValue(mode, word)) {
            ++data_other_bad;
        }
        bool atomic_is_changed_slot = !same_line && word == TARGET_WORD;
        if (!atomic_is_changed_slot &&
            atomic_snapshot[word] != InitialAtomicValue(mode, word)) {
            ++atomic_other_bad;
        }
    }

    uint32_t initial_target = same_line ? InitialDataValue(mode, TARGET_WORD) :
                                          InitialAtomicValue(mode, TARGET_WORD);
    uint32_t target_actual = same_line ? data_snapshot[TARGET_WORD] :
                                         atomic_snapshot[TARGET_WORD];
    uint32_t dirty_actual = data_snapshot[DIRTY_WORD];

    WriteGmByPassDCache<uint32_t>(&result[RESULT_MAGIC], RESULT_MAGIC_VALUE);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_MODE], mode);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_PRELOAD_DATA_BAD], preload_data_bad);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_PRELOAD_ATOMIC_BAD], preload_atomic_bad);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_TARGET_ACTUAL], target_actual);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_DIRTY_ACTUAL], dirty_actual);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_DATA_OTHER_BAD], data_other_bad);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_ATOMIC_OTHER_BAD], atomic_other_bad);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_DATA_HASH], data_hash);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_ATOMIC_HASH], atomic_hash);
    WriteGmByPassDCache<uint32_t>(
        &result[RESULT_ATOMIC_SURVIVED], target_actual == AtomicValue(mode) ? 1u : 0u);
    WriteGmByPassDCache<uint32_t>(
        &result[RESULT_ATOMIC_ROLLED_BACK], target_actual == initial_target ? 1u : 0u);
    WriteGmByPassDCache<uint32_t>(
        &result[RESULT_DIRTY_PUBLISHED], dirty_actual == DirtyValue(mode) ? 1u : 0u);
    WriteGmByPassDCache<uint32_t>(
        &result[RESULT_DIRTY_UNPUBLISHED],
        dirty_actual == InitialDataValue(mode, DIRTY_WORD) ? 1u : 0u);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_CORE0_MARKER], CORE0_MAGIC);
    WriteGmByPassDCache<uint32_t>(&result[RESULT_RESERVED], 0u);
    DataSyncBarrier<MemDsbT::ALL>();
}

struct ProbeBuffers {
    uint32_t *data = nullptr;
    uint32_t *atomic_data = nullptr;
    uint32_t *ready = nullptr;
    uint32_t *done = nullptr;
    uint32_t *writer_marker = nullptr;
    uint32_t *result = nullptr;
    uint32_t *data_snapshot = nullptr;
    uint32_t *atomic_snapshot = nullptr;
};

static uint32_t HostInitialDataValue(uint32_t mode, uint32_t word)
{
    return 0x11000000u + mode * 0x00100000u + word;
}

static uint32_t HostInitialAtomicValue(uint32_t mode, uint32_t word)
{
    return 0x22000000u + mode * 0x00100000u + word;
}

static uint32_t HostDirtyValue(uint32_t mode)
{
    return 0xD1700000u + mode;
}

static uint32_t HostAtomicValue(uint32_t mode)
{
    return 0xA7000000u + mode;
}

static uint32_t HostHash(const uint32_t *line)
{
    uint32_t hash = 2166136261u;
    for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
        hash = (hash ^ line[word]) * 16777619u;
    }
    return hash;
}

static bool LinesAreIndependent(const ProbeBuffers &buffers)
{
    uintptr_t addresses[8] = {
        reinterpret_cast<uintptr_t>(buffers.data),
        reinterpret_cast<uintptr_t>(buffers.atomic_data),
        reinterpret_cast<uintptr_t>(buffers.ready),
        reinterpret_cast<uintptr_t>(buffers.done),
        reinterpret_cast<uintptr_t>(buffers.writer_marker),
        reinterpret_cast<uintptr_t>(buffers.result),
        reinterpret_cast<uintptr_t>(buffers.data_snapshot),
        reinterpret_cast<uintptr_t>(buffers.atomic_snapshot),
    };
    for (uint32_t i = 0; i < 8; ++i) {
        if ((addresses[i] & (CACHELINE_BYTES - 1)) != 0) {
            return false;
        }
        for (uint32_t j = 0; j < i; ++j) {
            if ((addresses[i] >> 6) == (addresses[j] >> 6)) {
                return false;
            }
        }
    }
    return true;
}

static bool LineHasOnlyAllowedChanges(
    const uint32_t *line, uint32_t mode, bool data_line, bool same_line)
{
    for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
        uint32_t initial = data_line ? HostInitialDataValue(mode, word) :
                                       HostInitialAtomicValue(mode, word);
        bool dirty_slot = data_line && word == DIRTY_WORD;
        bool target_slot = word == TARGET_WORD &&
            ((data_line && same_line) || (!data_line && !same_line));
        if (!dirty_slot && !target_slot && line[word] != initial) {
            return false;
        }
        if (dirty_slot && line[word] != initial && line[word] != HostDirtyValue(mode)) {
            return false;
        }
        if (target_slot && line[word] != initial && line[word] != HostAtomicValue(mode)) {
            return false;
        }
    }
    return true;
}

int32_t main()
{
    uint32_t mode = 0;
    if (!atomic_probe::RequiredUintEnv("ATOMIC_PROBE_MODE", NUM_MODES, &mode)) {
        return EXIT_FAILURE;
    }
    int32_t device_id = atomic_probe::DeviceId();
    if (device_id < 0) {
        return EXIT_FAILURE;
    }

    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(device_id));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    ProbeBuffers buffers;
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.data), CACHELINE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.atomic_data), CACHELINE_BYTES,
        ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.ready), CACHELINE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.done), CACHELINE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.writer_marker), CACHELINE_BYTES,
        ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.result), CACHELINE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.data_snapshot), CACHELINE_BYTES,
        ACL_MEM_MALLOC_HUGE_FIRST));
    PROBE_ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void **>(&buffers.atomic_snapshot), CACHELINE_BYTES,
        ACL_MEM_MALLOC_HUGE_FIRST));

    if (!LinesAreIndependent(buffers)) {
        std::fprintf(stderr,
                     "data、atomic、ready、done、marker、result 与两条快照未满足独立 64B cacheline 前提\n");
        aclrtFree(buffers.data);
        aclrtFree(buffers.atomic_data);
        aclrtFree(buffers.ready);
        aclrtFree(buffers.done);
        aclrtFree(buffers.writer_marker);
        aclrtFree(buffers.result);
        aclrtFree(buffers.data_snapshot);
        aclrtFree(buffers.atomic_snapshot);
        aclrtDestroyStream(stream);
        aclrtResetDevice(device_id);
        aclFinalize();
        return EXIT_FAILURE;
    }

    atomic_probe::Result check;

    uint32_t data_host[CACHELINE_WORDS];
    uint32_t atomic_host[CACHELINE_WORDS];
    uint32_t zeros[CACHELINE_WORDS] = {};
    for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
        data_host[word] = HostInitialDataValue(mode, word);
        atomic_host[word] = HostInitialAtomicValue(mode, word);
    }
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.data, CACHELINE_BYTES, data_host, CACHELINE_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.atomic_data, CACHELINE_BYTES, atomic_host, CACHELINE_BYTES,
        ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.ready, CACHELINE_BYTES, zeros, CACHELINE_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.done, CACHELINE_BYTES, zeros, CACHELINE_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.writer_marker, CACHELINE_BYTES, zeros, CACHELINE_BYTES,
        ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.result, CACHELINE_BYTES, zeros, CACHELINE_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.data_snapshot, CACHELINE_BYTES, zeros, CACHELINE_BYTES,
        ACL_MEMCPY_HOST_TO_DEVICE));
    PROBE_ACL_CHECK(aclrtMemcpy(
        buffers.atomic_snapshot, CACHELINE_BYTES, zeros, CACHELINE_BYTES,
        ACL_MEMCPY_HOST_TO_DEVICE));

    dcci_atomic_clobber<<<2, nullptr, stream>>>(
        buffers.data, buffers.atomic_data, buffers.ready, buffers.done,
        buffers.writer_marker, buffers.result, buffers.data_snapshot,
        buffers.atomic_snapshot, mode);
    PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

    uint32_t ready_host[CACHELINE_WORDS] = {};
    uint32_t done_host[CACHELINE_WORDS] = {};
    uint32_t marker_host[CACHELINE_WORDS] = {};
    uint32_t result_host[CACHELINE_WORDS] = {};
    uint32_t data_snapshot_host[CACHELINE_WORDS] = {};
    uint32_t atomic_snapshot_host[CACHELINE_WORDS] = {};
    PROBE_ACL_CHECK(aclrtMemcpy(
        data_host, CACHELINE_BYTES, buffers.data, CACHELINE_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        atomic_host, CACHELINE_BYTES, buffers.atomic_data, CACHELINE_BYTES,
        ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        ready_host, CACHELINE_BYTES, buffers.ready, CACHELINE_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        done_host, CACHELINE_BYTES, buffers.done, CACHELINE_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        marker_host, CACHELINE_BYTES, buffers.writer_marker, CACHELINE_BYTES,
        ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        result_host, CACHELINE_BYTES, buffers.result, CACHELINE_BYTES,
        ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        data_snapshot_host, CACHELINE_BYTES, buffers.data_snapshot, CACHELINE_BYTES,
        ACL_MEMCPY_DEVICE_TO_HOST));
    PROBE_ACL_CHECK(aclrtMemcpy(
        atomic_snapshot_host, CACHELINE_BYTES, buffers.atomic_snapshot, CACHELINE_BYTES,
        ACL_MEMCPY_DEVICE_TO_HOST));

    bool same_line = mode < 4;
    uint32_t selector_mode = mode & 3u;
    const char *selectors[4] = {
        "CACHELINE_ALL", "CACHELINE_OUT", "CACHELINE_ATOMIC", "NO DCCI"};
    const uint32_t *target_line = same_line ? data_host : atomic_host;
    uint32_t initial_target = same_line ? HostInitialDataValue(mode, TARGET_WORD) :
                                          HostInitialAtomicValue(mode, TARGET_WORD);
    uint32_t target_actual = target_line[TARGET_WORD];
    uint32_t dirty_actual = data_host[DIRTY_WORD];

    bool phase_exact = ready_host[0] == READY_PHASE && done_host[0] == DONE_PHASE;
    for (uint32_t word = 1; word < CACHELINE_WORDS; ++word) {
        phase_exact = phase_exact && ready_host[word] == 0 && done_host[word] == 0;
    }
    check.Expect(
        phase_exact,
        "ready/done仅word0变化，且核0→核1→核0两个交接phase均精确完成");

    bool marker_exact = marker_host[0] == WRITER_MAGIC && marker_host[1] == mode &&
        marker_host[2] == initial_target && marker_host[3] == HostAtomicValue(mode) &&
        marker_host[4] == (same_line ? 1u : 0u) && marker_host[5] == CORE1_MAGIC;
    for (uint32_t word = 6; word < CACHELINE_WORDS; ++word) {
        marker_exact = marker_exact && marker_host[word] == 0;
    }
    check.Expect(
        marker_exact,
        "核1确实执行一次AtomicExch，返回目标slot初值并记录正确的新值与line类型");

    bool result_header_exact = result_host[RESULT_MAGIC] == RESULT_MAGIC_VALUE &&
        result_host[RESULT_MODE] == mode && result_host[RESULT_CORE0_MARKER] == CORE0_MAGIC &&
        result_host[RESULT_RESERVED] == 0;
    check.Expect(result_header_exact, "核0完成DCCI后两条ld_dev快照并写出完整结果标记");
    check.Expect(
        result_host[RESULT_PRELOAD_DATA_BAD] == 0 &&
            result_host[RESULT_PRELOAD_ATOMIC_BAD] == 0,
        "核0在dirty store前普通load读到两条cacheline的全部host初值");

    bool unchanged_words_exact = LineHasOnlyAllowedChanges(data_host, mode, true, same_line) &&
        LineHasOnlyAllowedChanges(atomic_host, mode, false, same_line) &&
        result_host[RESULT_DATA_OTHER_BAD] == 0 &&
        result_host[RESULT_ATOMIC_OTHER_BAD] == 0;
    check.Expect(
        unchanged_words_exact,
        "除AtomicExch目标slot和scalar dirty slot外，两条cacheline其余word逐一保持初值");

    bool full_snapshots_match_host = true;
    for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
        full_snapshots_match_host = full_snapshots_match_host &&
            data_snapshot_host[word] == data_host[word] &&
            atomic_snapshot_host[word] == atomic_host[word];
    }
    bool snapshot_matches_host = full_snapshots_match_host &&
        result_host[RESULT_TARGET_ACTUAL] == target_actual &&
        result_host[RESULT_DIRTY_ACTUAL] == dirty_actual &&
        result_host[RESULT_DATA_HASH] == HostHash(data_host) &&
        result_host[RESULT_ATOMIC_HASH] == HostHash(atomic_host);
    check.Expect(
        snapshot_matches_host,
        "核0保存的两条 16-word ld_dev 快照必须逐 word 等于 kernel 结束后的 GM 内容");

    bool flags_exact = result_host[RESULT_ATOMIC_SURVIVED] ==
            (target_actual == HostAtomicValue(mode) ? 1u : 0u) &&
        result_host[RESULT_ATOMIC_ROLLED_BACK] ==
            (target_actual == initial_target ? 1u : 0u) &&
        result_host[RESULT_DIRTY_PUBLISHED] ==
            (dirty_actual == HostDirtyValue(mode) ? 1u : 0u) &&
        result_host[RESULT_DIRTY_UNPUBLISHED] ==
            (dirty_actual == HostInitialDataValue(mode, DIRTY_WORD) ? 1u : 0u);
    check.Expect(flags_exact, "行为分类字段与ld_dev实际目标值、dirty值逐项一致");

    bool atomic_survived = target_actual == HostAtomicValue(mode);
    bool atomic_rolled_back = target_actual == initial_target;
    bool dirty_published = dirty_actual == HostDirtyValue(mode);
    bool dirty_unpublished = dirty_actual == HostInitialDataValue(mode, DIRTY_WORD);
    bool clobbered_writeback = same_line && dirty_published && atomic_rolled_back;
    bool survived_writeback = same_line && dirty_published && atomic_survived;
    bool survived_without_publish = same_line && dirty_unpublished && atomic_survived;
    bool separate_cleaned = !same_line && dirty_published && atomic_survived;
    bool separate_not_cleaned = !same_line && dirty_unpublished && atomic_survived;

    const char *classification = "未解释状态：目标值或dirty值不属于允许的完整组合";
    if (clobbered_writeback) {
        classification = "DCCI发布普通dirty line，并用旧快照覆盖AtomicExch新值";
    } else if (survived_writeback) {
        classification = "DCCI发布普通dirty line，同时AtomicExch新值仍保留";
    } else if (survived_without_publish) {
        classification = "普通dirty entry未发布，同时AtomicExch新值仍保留";
    } else if (separate_cleaned) {
        classification = "DCCI发布data dirty line，独立atomic line的新值保留";
    } else if (separate_not_cleaned) {
        classification = "data dirty entry未发布，独立atomic line的新值保留";
    }

    bool complete_state_is_explained = same_line ?
        (clobbered_writeback || survived_writeback || survived_without_publish) :
        (separate_cleaned || separate_not_cleaned);
    check.Expect(
        complete_state_is_explained,
        "两条完整快照必须命中一种已定义状态；拒绝回滚但未回写、任意torn或第四种状态");

    std::printf(
        "[行为分类] mode=%u selector=%s 布局=%s 分类=%s "
        "target=0x%08x dirty=0x%08x\n",
        mode, selectors[selector_mode], same_line ? "同一cacheline" : "分离cacheline",
        classification, target_actual, dirty_actual);

    if (selector_mode == 3) {
        check.Expect(
            target_actual == HostAtomicValue(mode),
            "NO DCCI对照：核1的AtomicExch新值必须保留，不能无故回滚");
        check.Expect(
            dirty_actual == HostInitialDataValue(mode, DIRTY_WORD),
            "NO DCCI对照：核0的普通scalar dirty值不得出现在ld_dev读取的GM中");
    } else if (!same_line) {
        check.Expect(
            target_actual == HostAtomicValue(mode) &&
                dirty_actual == HostDirtyValue(mode),
            "分line selector：DCCI 必须发布 data dirty 值，atomic_data 中的新值必须保留");
    } else {
        check.Expect(
            target_actual == HostAtomicValue(mode) && dirty_actual == HostDirtyValue(mode),
            "同line正确性门禁：DCCI 发布 dirty 值后，AtomicExch 新值仍必须保留；被旧快照覆盖即失败");
    }

    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.data), "aclrtFree(data)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.atomic_data), "aclrtFree(atomic_data)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.ready), "aclrtFree(ready)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.done), "aclrtFree(done)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.writer_marker), "aclrtFree(writer_marker)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.result), "aclrtFree(result)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.data_snapshot), "aclrtFree(data_snapshot)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtFree(buffers.atomic_snapshot), "aclrtFree(atomic_snapshot)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtDestroyStream(stream), "aclrtDestroyStream(stream)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(
        aclrtResetDevice(device_id), "aclrtResetDevice(device_id)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    check.Expect(cleanup_ok, "ACL资源释放与设备复位全部成功");
    return check.ExitCode();
}
