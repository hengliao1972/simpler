// Concurrent cache-line cross-core probe.
//
// A5 has NO hardware cache coherence between cores.  Multiple cores
// reading/writing the same 64B cache line must use explicit cache
// management (st_dev/ld_dev or dcci) to avoid data corruption.
//
// This probe systematically tests every combination:
//   - N cores writing different words simultaneously
//   - st_dev (bypass) vs store+dcci (traditional) vs AtomicMax
//   - ld_dev (bypass read) vs normal read (after dcci inval)
//   - Producer-consumer patterns
//   - Stress test (N rounds)
//
// Layout: gx[0..15] = 64B test cache line, gx[16..] = results
//
// Build/run:
//   bisheng -xasc concurrent_cacheline.asc --npu-arch=dav-3510 -o /tmp/concurrent_cl
//   /tmp/concurrent_cl
#include "../probe_host.h"
#include "kernel_operator.h"
#include <cstdint>
#include <time.h>
#include <cstdio>
using namespace AscendC;

#ifndef SINGLE_CACHE_LINE
#define SINGLE_CACHE_LINE 0
#endif
#ifndef CACHELINE_OUT
#define CACHELINE_OUT 2
#endif

constexpr uint32_t NUM_TEST_WORDS = 16;   // 16 × uint32_t = 64B = 1 cache line

// ============================================================
// Kernel
// ============================================================
__schedmode__(1) __global__ __mix__(0, 1) void conc_cl(
    __gm__ uint32_t *gx, uint32_t mode, uint32_t num_blocks)
{
    uint32_t bid = GetBlockIdx();
    uint32_t nb  = num_blocks;

    // ================================================================
    // Mode 0: N-block concurrent st_dev write (all bypass DCache)
    //
    // Each block writes its own word(s) via st_dev.
    // st_dev bypasses L1 → no clobber. All words should survive.
    // ================================================================
    if (mode == 0) {
        SyncAll();
        // Each block writes words striped across the cache line
        for (uint32_t w = bid; w < NUM_TEST_WORDS; w += nb) {
            __gm__ uint32_t *p = &gx[w];
            WriteGmByPassDCache<uint32_t>(p, 0xA000u + w);
        }
        SyncAll();
        if (bid == 0) {
            uint32_t errors = 0;
            for (uint32_t w = 0; w < NUM_TEST_WORDS; w++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[w]);
                if (v != 0xA000u + w) errors++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], errors);
        }
        SyncAll();

    // ================================================================
    // Mode 1: N-block concurrent store+dcci write (traditional CCE)
    //
    // Each block writes via scalar store + dcci(CACHELINE_OUT).
    // dcci writes the ENTIRE 64B dirty L1 line → clobbers neighbors.
    // ================================================================
    } else if (mode == 1) {
        SyncAll();
        for (uint32_t w = bid; w < NUM_TEST_WORDS; w += nb) {
            gx[w] = 0xB000u + w;
            dcci(gx, SINGLE_CACHE_LINE, CACHELINE_OUT);
        }
        SyncAll();
        if (bid == 0) {
            uint32_t errors = 0;
            for (uint32_t w = 0; w < NUM_TEST_WORDS; w++) {
                if (ReadGmByPassDCache<uint32_t>(&gx[w]) != 0xB000u + w) errors++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], errors);
        }
        SyncAll();

    // ================================================================
    // Mode 2: Mixed concurrent — block 0 st_dev, block 1 store+dcci
    //
    // Block 0: st_dev word[0] (bypass, no L1)
    // Block 1: store word[8] + dcci(CACHELINE_OUT) (full line writeback)
    // Block 1's dcci may clobber word[0] if its L1 had stale data.
    // ================================================================
    } else if (mode == 2) {
        SyncAll();
        // Warm L1 on block 1 with zeros
        if (bid == 1) {
            volatile __gm__ uint32_t *vgx = gx;
            uint32_t s = vgx[0] + vgx[8];
            (void)s;
        }
        SyncAll();
        // Concurrent writes — no sync between them
        if (bid == 0) {
            WriteGmByPassDCache<uint32_t>(&gx[0], 0xDEADBEEFu);
            WriteGmByPassDCache<uint32_t>(&gx[1], 0xCAFEBABEu);
            WriteGmByPassDCache<uint32_t>(&gx[2], 0x12345678u);
            WriteGmByPassDCache<uint32_t>(&gx[3], 0x9ABCDEF0u);
        }
        if (bid == 1) {
            gx[8]  = 0xBEEF0001u;
            gx[9]  = 0xBEEF0002u;
            gx[10] = 0xBEEF0003u;
            gx[11] = 0xBEEF0004u;
            dcci(gx, SINGLE_CACHE_LINE, CACHELINE_OUT);
        }
        SyncAll();
        if (bid == 0) {
            uint32_t e = 0;
            if (ReadGmByPassDCache<uint32_t>(&gx[0]) != 0xDEADBEEFu) e++;
            if (ReadGmByPassDCache<uint32_t>(&gx[1]) != 0xCAFEBABEu) e++;
            if (ReadGmByPassDCache<uint32_t>(&gx[2]) != 0x12345678u) e++;
            if (ReadGmByPassDCache<uint32_t>(&gx[3]) != 0x9ABCDEF0u) e++;
            if (ReadGmByPassDCache<uint32_t>(&gx[8])  != 0xBEEF0001u) e++;
            if (ReadGmByPassDCache<uint32_t>(&gx[9])  != 0xBEEF0002u) e++;
            if (ReadGmByPassDCache<uint32_t>(&gx[10]) != 0xBEEF0003u) e++;
            if (ReadGmByPassDCache<uint32_t>(&gx[11]) != 0xBEEF0004u) e++;
            for (uint32_t w = 4; w < 8; w++)
                if (ReadGmByPassDCache<uint32_t>(&gx[w]) != 0) e++;
            for (uint32_t w = 12; w < 16; w++)
                if (ReadGmByPassDCache<uint32_t>(&gx[w]) != 0) e++;
            WriteGmByPassDCache<uint32_t>(&gx[16], e);
            WriteGmByPassDCache<uint32_t>(&gx[17], ReadGmByPassDCache<uint32_t>(&gx[0]));
            WriteGmByPassDCache<uint32_t>(&gx[18], ReadGmByPassDCache<uint32_t>(&gx[8]));
        }
        SyncAll();

    // ================================================================
    // Mode 3: Producer-consumer (st_dev write → ld_dev poll → read)
    //
    // Block 0 (producer): st_dev write 8 data words, then AtomicAdd flag
    // Block 1 (consumer): ld_dev poll flag, then ld_dev read 8 words
    // No dcci needed — entire path uses bypass DCache.
    // ================================================================
    } else if (mode == 3) {
        SyncAll();
        if (bid == 0) {
            // Producer: write 8 data words directly to HBM
            for (uint32_t i = 0; i < 8; i++)
                WriteGmByPassDCache<uint32_t>(&gx[i], 0xD0000000u + i);
            // Signal completion via atomic flag
            AtomicAdd(&gx[15], 1u);
        } else if (bid == 1) {
            // Consumer: poll flag via bypass read
            uint32_t flag = 0;
            while (flag < 1) {
                flag = ReadGmByPassDCache<uint32_t>(&gx[15]);
                Nop<800>();
            }
            // Read data via bypass read
            uint32_t errors = 0;
            for (uint32_t i = 0; i < 8; i++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[i]);
                if (v != 0xD0000000u + i) errors++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], errors);
        }
        SyncAll();

    // ================================================================
    // Mode 4: Producer-consumer (store+dcci write → dcci inval → read)
    //
    // Block 0 (producer): store 8 words + dcci(CACHELINE_OUT)
    // Block 1 (consumer): dcci(INVAL) + normal read
    // Uses traditional CCE cache management — more complex but common.
    // ================================================================
    } else if (mode == 4) {
        SyncAll();
        if (bid == 0) {
            for (uint32_t i = 0; i < 8; i++) gx[i] = 0xE0000000u + i;
            dcci(gx, SINGLE_CACHE_LINE, CACHELINE_OUT);  // flush
            AtomicAdd(&gx[15], 1u);  // signal
        } else if (bid == 1) {
            // Poll flag via atomic (bypass L1)
            uint32_t flag = 0;
            while (flag < 1) {
                flag = AtomicMax(&gx[15], 0u);  // idempotent atomic read
            }
            // Invalidate + normal read
            dcci(gx, SINGLE_CACHE_LINE);  // inval: discard stale L1, reload from HBM
            uint32_t errors = 0;
            for (uint32_t i = 0; i < 8; i++) {
                volatile __gm__ uint32_t *vgx = gx;
                if (vgx[i] != 0xE0000000u + i) errors++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], errors);
        }
        SyncAll();

    // ================================================================
    // Mode 5: Stress — 100 rounds of concurrent write + verify
    //
    // Each round: both blocks st_dev write their words, sync, verify.
    // Tests for intermittent failures under sustained load.
    // ================================================================
    } else if (mode == 5) {
        SyncAll();
        constexpr uint32_t ROUNDS = 100;
        uint32_t total_errors = 0;
        for (uint32_t r = 0; r < ROUNDS; r++) {
            // Concurrent write
            for (uint32_t w = bid; w < 8; w += nb) {
                WriteGmByPassDCache<uint32_t>(&gx[w], 0xF000u + r * 16 + w);
            }
            SyncAll();
            // Verify (block 0 only)
            if (bid == 0) {
                for (uint32_t w = 0; w < 8; w++) {
                    uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[w]);
                    if (v != 0xF000u + r * 16 + w) total_errors++;
                }
            }
            SyncAll();
            // Clear for next round (block 0)
            if (bid == 0 && r < ROUNDS - 1) {
                for (uint32_t w = 0; w < 8; w++)
                    WriteGmByPassDCache<uint32_t>(&gx[w], 0);
            }
            SyncAll();
        }
        if (bid == 0) WriteGmByPassDCache<uint32_t>(&gx[16], total_errors);
        SyncAll();

    // ================================================================
    // Mode 6: Concurrent read race — write once, then all blocks read
    //
    // Block 0 writes via st_dev, then all blocks read via different
    // methods simultaneously.  Tests read-read races.
    // ================================================================
    } else if (mode == 6) {
        SyncAll();
        if (bid == 0) {
            for (uint32_t i = 0; i < NUM_TEST_WORDS; i++)
                WriteGmByPassDCache<uint32_t>(&gx[i], 0xC000u + i);
        }
        SyncAll();
        // All blocks read via bypass — should all see same correct data
        uint32_t local_errors = 0;
        for (uint32_t i = 0; i < NUM_TEST_WORDS; i++) {
            uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[i]);
            if (v != 0xC000u + i) local_errors++;
        }
        // Report per-block error count
        WriteGmByPassDCache<uint32_t>(&gx[16 + bid], local_errors);
        SyncAll();
    }
}

// ============================================================
// Host
// ============================================================
int32_t main(int32_t argc, char *argv[])
{
    int32_t deviceId = atomic_probe::DeviceId();
    if (deviceId < 0) {
        return EXIT_FAILURE;
    }
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    constexpr int32_t GX_SIZE = 64;
    uint32_t *gx_dev = nullptr;
    PROBE_ACL_CHECK(aclrtMalloc((void **)&gx_dev, GX_SIZE * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    atomic_probe::Result result;

    const char *mode_names[] = {
        "st_dev N-block ",
        "store+dcci N   ",
        "Mixed st+dcci  ",
        "ProdCons bypass",
        "ProdCons dcci  ",
        "Stress 100R    ",
        "ConcurrentRead ",
    };
    const int NUM_MODES = sizeof(mode_names) / sizeof(mode_names[0]);
    // Test with 2, 3, 4 blocks
    uint32_t block_counts[] = {2, 3, 4};

    printf("=== Concurrent Cache-Line Cross-Core Probe ===\n");
    printf("A5: NO HW cache coherence. Explicit cache mgmt required.\n\n");

    for (int mode = 0; mode < NUM_MODES; mode++) {
        for (size_t bi = 0; bi < sizeof(block_counts)/sizeof(block_counts[0]); bi++) {
            uint32_t nblk = block_counts[bi];

            // Zero gx
            uint32_t zeros[GX_SIZE] = {0};
            PROBE_ACL_CHECK(
                aclrtMemcpy(gx_dev, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE));

            struct timespec ts_start, ts_end;
            clock_gettime(CLOCK_MONOTONIC, &ts_start);

            conc_cl<<<nblk, nullptr, stream>>>(gx_dev, (uint32_t)mode, nblk);
            PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

            clock_gettime(CLOCK_MONOTONIC, &ts_end);
            double host_us = (ts_end.tv_sec - ts_start.tv_sec) * 1e6 +
                             (ts_end.tv_nsec - ts_start.tv_nsec) / 1e3;

            uint32_t r[GX_SIZE] = {0};
            PROBE_ACL_CHECK(aclrtMemcpy(r, sizeof(r), gx_dev, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST));

            char assertion[96];

            if (mode == 5) {
                printf("[%-16s] mode=%d blk=%u  errors=%u/800  %.0fus\n",
                       mode_names[mode], mode, nblk, r[16], host_us);
            } else if (mode == 6) {
                uint32_t max_err = 0;
                for (uint32_t b = 0; b < nblk; b++)
                    if (r[16 + b] > max_err) max_err = r[16 + b];
                printf("[%-16s] mode=%d blk=%u  max_err=%u  %.0fus\n",
                       mode_names[mode], mode, nblk, max_err, host_us);
                std::snprintf(assertion, sizeof(assertion), "mode 6 bypass reads, blocks=%u", nblk);
                result.Expect(max_err == 0, assertion);
            } else if (mode == 2) {
                printf("[%-16s] mode=%d blk=%u  errors=%u/16  w0=0x%x w8=0x%x  %.0fus\n",
                       mode_names[mode], mode, nblk, r[16], r[17], r[18], host_us);
            } else {
                printf("[%-16s] mode=%d blk=%u  errors=%u/16  %.0fus\n",
                       mode_names[mode], mode, nblk, r[16], host_us);
            }

            if (mode == 0 || mode == 3 || mode == 4 || mode == 5) {
                std::snprintf(assertion, sizeof(assertion), "mode %d exact verifier, blocks=%u", mode, nblk);
                result.Expect(r[16] == 0, assertion);
            }
        }
        printf("\n");
    }

    // Mode 2 (mixed) repeated 20 times to show race distribution
    printf("--- Mode 2 (Mixed st+dcci) x20 runs, 2 blocks ---\n");
    uint32_t pass_cnt = 0;
    for (int i = 0; i < 20; i++) {
        uint32_t zeros[GX_SIZE] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(gx_dev, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE));
        conc_cl<<<2, nullptr, stream>>>(gx_dev, 2, 2);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));
        uint32_t r[GX_SIZE] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(r, sizeof(r), gx_dev, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST));
        if (r[16] == 0) pass_cnt++;
    }
    printf("  pass=%u/20  fail=%u/20\n", pass_cnt, 20 - pass_cnt);

    printf("\n=== dcci quick reference ===\n");
    printf("  dcci(ptr, 0)        = clean + invalidate (writeback dirty + discard)\n");
    printf("  dcci(ptr, 0, 2)     = clean only (writeback, keep cached)\n");
    printf("  dcci(ptr, 1)        = clean + invalidate ENTIRE_DATA_CACHE\n");

    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(gx_dev), "aclrtFree(gx_dev)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    result.Expect(cleanup_ok, "ACL cleanup");
    return result.ExitCode();
}
