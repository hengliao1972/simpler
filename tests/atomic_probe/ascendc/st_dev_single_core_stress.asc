// 单 AIV repeated st_dev 压力：写者与 bypass 读者是同一个 AIV，不含核间同步或共享写者。
//
// mode 0/1/2：分别反复写 allocation 的 data line0/1/2，每个 trial 的 257 次写后只做一次 DSB；
// mode 3/4：每轮依次写 line0+line1 / line1+line2，257 轮后只做一次 DSB；
// mode 5：与 mode 1 同址，但每次写后立即 DSB；
// mode 6：与 mode 4 同址，但每个 slot 的每次写后立即 DSB。
//
// 每个 launch 执行 100 个 trial，同一个 AIV 在 DSB 后用 bypass load 检查终值必须等于
// 第 257 次写入值。data、result、participation、topology marker 和 tail guard 各自独占
// 64B line；控制信息用 AtomicAdd/AtomicExch 发布，避免把控制区本身变成 repeated st_dev。
// 任一 mismatch 都是正确性失败；“复现到问题”不是 PASS 条件。
#include "../probe_host.h"
#include "kernel_operator.h"

#include <cerrno>
#include <cstdint>
#include <cstdio>
#include <cstdlib>

using namespace AscendC;

constexpr uint32_t CACHELINE_BYTES = 64;
constexpr uint32_t CACHELINE_WORDS = CACHELINE_BYTES / sizeof(uint32_t);
constexpr uint32_t DATA_LINES = 3;
constexpr uint32_t RESULT_BASE = 3 * CACHELINE_WORDS;
constexpr uint32_t PARTICIPATION_BASE = 4 * CACHELINE_WORDS;
constexpr uint32_t MARKER_BASE = 5 * CACHELINE_WORDS;
constexpr uint32_t TAIL_GUARD_BASE = 6 * CACHELINE_WORDS;
constexpr uint32_t STORAGE_LINES = 7;
constexpr uint32_t STORAGE_WORDS = STORAGE_LINES * CACHELINE_WORDS;

constexpr uint32_t NUM_MODES = 7;
constexpr uint32_t ROUNDS = 257;
constexpr uint32_t TRIALS = 100;
constexpr uint32_t DEFAULT_SINGLE_LAUNCHES = 5000;
constexpr uint32_t DEFAULT_DUAL_LAUNCHES = 500;
constexpr uint32_t MAX_LAUNCHES = 1000000;
constexpr uint32_t INVALID_U32 = 0xffffffffu;

constexpr uint32_t RESULT_MAGIC = 0;
constexpr uint32_t RESULT_MODE = 1;
constexpr uint32_t RESULT_CHECKS = 2;
constexpr uint32_t RESULT_ERRORS = 3;
constexpr uint32_t RESULT_SLOT0_ERRORS = 4;
constexpr uint32_t RESULT_SLOT1_ERRORS = 5;
constexpr uint32_t RESULT_FIRST_ACTUAL = 6;
constexpr uint32_t RESULT_FIRST_EXPECTED = 7;
constexpr uint32_t RESULT_FIRST_TRIAL = 8;
constexpr uint32_t RESULT_FIRST_SLOT = 9;
constexpr uint32_t RESULT_ROUNDS = 10;
constexpr uint32_t RESULT_TRIALS = 11;
constexpr uint32_t RESULT_DATA_START_LINE = 12;
constexpr uint32_t RESULT_SLOTS = 13;
constexpr uint32_t RESULT_PER_WRITE_DSB = 14;
constexpr uint32_t RESULT_FINISH = 15;

constexpr uint32_t MARKER_MAGIC = 0;
constexpr uint32_t MARKER_BLOCK_IDX = 1;
constexpr uint32_t MARKER_BLOCK_NUM = 2;
constexpr uint32_t MARKER_CORE_ID = 3;
constexpr uint32_t MARKER_SUBBLOCK_ID = 4;
constexpr uint32_t MARKER_COMM_SLOT = 5;
constexpr uint32_t MARKER_MODE = 6;
constexpr uint32_t MARKER_SLOTS = 7;
constexpr uint32_t MARKER_DATA_START_LINE = 8;
constexpr uint32_t MARKER_PER_WRITE_DSB = 9;
constexpr uint32_t MARKER_ARRIVED = 10;
constexpr uint32_t MARKER_WRITTEN_WORDS = 11;

constexpr uint32_t RESULT_MAGIC_VALUE = 0x53314352u;
constexpr uint32_t RESULT_FINISH_VALUE = 0x46494e49u;
constexpr uint32_t MARKER_MAGIC_VALUE = 0x53434f52u;

constexpr int32_t PTO_CORE_PER_DIE = 18;
constexpr int32_t PTO_AIC_AIV_PER_DIE = 54;

enum class ProbeMode : uint32_t {
    SINGLE_LINE0_LOOP_DSB = 0,
    SINGLE_LINE1_LOOP_DSB = 1,
    SINGLE_LINE2_LOOP_DSB = 2,
    DUAL_LINE01_LOOP_DSB = 3,
    DUAL_LINE12_LOOP_DSB = 4,
    SINGLE_LINE1_PER_WRITE_DSB = 5,
    DUAL_LINE12_PER_WRITE_DSB = 6,
};

__aicore__ inline uint32_t DataStartLine(uint32_t mode)
{
    if (mode == static_cast<uint32_t>(ProbeMode::SINGLE_LINE1_LOOP_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::SINGLE_LINE1_PER_WRITE_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_LOOP_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_PER_WRITE_DSB)) {
        return 1u;
    }
    if (mode == static_cast<uint32_t>(ProbeMode::SINGLE_LINE2_LOOP_DSB)) {
        return 2u;
    }
    return 0u;
}

__aicore__ inline uint32_t SlotCount(uint32_t mode)
{
    return mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE01_LOOP_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_LOOP_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_PER_WRITE_DSB) ? 2u : 1u;
}

__aicore__ inline bool UsesPerWriteDsb(uint32_t mode)
{
    return mode == static_cast<uint32_t>(ProbeMode::SINGLE_LINE1_PER_WRITE_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_PER_WRITE_DSB);
}

__aicore__ inline uint32_t TrialValue(uint32_t mode, uint32_t slot, uint32_t trial, uint32_t round)
{
    return 0xA0000000u + mode * 0x01000000u + slot * 0x00100000u + trial * 0x1000u + round;
}

__aicore__ inline int32_t ComputeA5CommSlot(uint32_t core_id, uint32_t subblock_id)
{
    int32_t core = static_cast<int32_t>(core_id);
    int32_t subblock = static_cast<int32_t>(subblock_id);
    int32_t die = core / PTO_AIC_AIV_PER_DIE;
    return die * PTO_CORE_PER_DIE + (((core % PTO_AIC_AIV_PER_DIE) - PTO_CORE_PER_DIE - subblock) / 2);
}

__schedmode__(1) __global__ __mix__(0, 1) void st_dev_single_core_stress(
    __gm__ uint32_t *storage, uint32_t mode)
{
    uint32_t participant = static_cast<uint32_t>(get_block_idx());
    uint32_t block_num = static_cast<uint32_t>(get_block_num());
    uint32_t data_start_line = DataStartLine(mode);
    uint32_t slots = SlotCount(mode);
    bool per_write_dsb = UsesPerWriteDsb(mode);
    __gm__ uint32_t *result = storage + RESULT_BASE;
    __gm__ uint32_t *participation = storage + PARTICIPATION_BASE;
    __gm__ uint32_t *marker = storage + MARKER_BASE;

    uint32_t core_id = static_cast<uint32_t>(get_coreid());
    uint32_t subblock_id = static_cast<uint32_t>(get_subblockid());
    AtomicAdd(&participation[0], 1u);
    AtomicExch(&marker[MARKER_MAGIC], MARKER_MAGIC_VALUE);
    AtomicExch(&marker[MARKER_BLOCK_IDX], participant);
    AtomicExch(&marker[MARKER_BLOCK_NUM], block_num);
    AtomicExch(&marker[MARKER_CORE_ID], core_id);
    AtomicExch(&marker[MARKER_SUBBLOCK_ID], subblock_id);
    AtomicExch(&marker[MARKER_COMM_SLOT], static_cast<uint32_t>(ComputeA5CommSlot(core_id, subblock_id)));
    AtomicExch(&marker[MARKER_MODE], mode);
    AtomicExch(&marker[MARKER_SLOTS], slots);
    AtomicExch(&marker[MARKER_DATA_START_LINE], data_start_line);
    AtomicExch(&marker[MARKER_PER_WRITE_DSB], per_write_dsb ? 1u : 0u);
    AtomicExch(&marker[MARKER_ARRIVED], 1u);
    DataSyncBarrier<MemDsbT::ALL>();

    uint32_t errors = 0;
    uint32_t slot_errors[2] = {0u, 0u};
    uint32_t first_actual = 0;
    uint32_t first_expected = 0;
    uint32_t first_trial = INVALID_U32;
    uint32_t first_slot = INVALID_U32;

    for (uint32_t trial = 0; trial < TRIALS; ++trial) {
        for (uint32_t round = 0; round < ROUNDS; ++round) {
            for (uint32_t slot = 0; slot < slots; ++slot) {
                uint32_t target = (data_start_line + slot) * CACHELINE_WORDS;
                WriteGmByPassDCache<uint32_t>(&storage[target], TrialValue(mode, slot, trial, round));
                if (per_write_dsb) {
                    DataSyncBarrier<MemDsbT::ALL>();
                }
            }
        }
        if (!per_write_dsb) {
            DataSyncBarrier<MemDsbT::ALL>();
        }

        for (uint32_t slot = 0; slot < slots; ++slot) {
            uint32_t target = (data_start_line + slot) * CACHELINE_WORDS;
            uint32_t expected = TrialValue(mode, slot, trial, ROUNDS - 1u);
            uint32_t actual = ReadGmByPassDCache<uint32_t>(&storage[target]);
            if (actual != expected) {
                if (errors == 0u) {
                    first_actual = actual;
                    first_expected = expected;
                    first_trial = trial;
                    first_slot = slot;
                }
                ++errors;
                ++slot_errors[slot];
            }
        }
    }

    AtomicExch(&result[RESULT_MAGIC], RESULT_MAGIC_VALUE);
    AtomicExch(&result[RESULT_MODE], mode);
    AtomicExch(&result[RESULT_CHECKS], TRIALS * slots);
    AtomicExch(&result[RESULT_ERRORS], errors);
    AtomicExch(&result[RESULT_SLOT0_ERRORS], slot_errors[0]);
    AtomicExch(&result[RESULT_SLOT1_ERRORS], slot_errors[1]);
    AtomicExch(&result[RESULT_FIRST_ACTUAL], first_actual);
    AtomicExch(&result[RESULT_FIRST_EXPECTED], first_expected);
    AtomicExch(&result[RESULT_FIRST_TRIAL], first_trial);
    AtomicExch(&result[RESULT_FIRST_SLOT], first_slot);
    AtomicExch(&result[RESULT_ROUNDS], ROUNDS);
    AtomicExch(&result[RESULT_TRIALS], TRIALS);
    AtomicExch(&result[RESULT_DATA_START_LINE], data_start_line);
    AtomicExch(&result[RESULT_SLOTS], slots);
    AtomicExch(&result[RESULT_PER_WRITE_DSB], per_write_dsb ? 1u : 0u);
    AtomicExch(&result[RESULT_FINISH], RESULT_FINISH_VALUE);
    DataSyncBarrier<MemDsbT::ALL>();
}

static uint32_t HostDataStartLine(uint32_t mode)
{
    if (mode == static_cast<uint32_t>(ProbeMode::SINGLE_LINE1_LOOP_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::SINGLE_LINE1_PER_WRITE_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_LOOP_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_PER_WRITE_DSB)) {
        return 1u;
    }
    return mode == static_cast<uint32_t>(ProbeMode::SINGLE_LINE2_LOOP_DSB) ? 2u : 0u;
}

static uint32_t HostSlotCount(uint32_t mode)
{
    return mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE01_LOOP_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_LOOP_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_PER_WRITE_DSB) ? 2u : 1u;
}

static bool HostUsesPerWriteDsb(uint32_t mode)
{
    return mode == static_cast<uint32_t>(ProbeMode::SINGLE_LINE1_PER_WRITE_DSB) ||
        mode == static_cast<uint32_t>(ProbeMode::DUAL_LINE12_PER_WRITE_DSB);
}

static uint32_t HostTrialValue(uint32_t mode, uint32_t slot, uint32_t trial, uint32_t round)
{
    return 0xA0000000u + mode * 0x01000000u + slot * 0x00100000u + trial * 0x1000u + round;
}

static int32_t HostComputeA5CommSlot(uint32_t core_id, uint32_t subblock_id)
{
    int32_t core = static_cast<int32_t>(core_id);
    int32_t subblock = static_cast<int32_t>(subblock_id);
    int32_t die = core / PTO_AIC_AIV_PER_DIE;
    return die * PTO_CORE_PER_DIE + (((core % PTO_AIC_AIV_PER_DIE) - PTO_CORE_PER_DIE - subblock) / 2);
}

static const char *ModeLabel(uint32_t mode)
{
    static const char *const labels[NUM_MODES] = {
        "single-line0-loop-dsb", "single-line1-loop-dsb", "single-line2-loop-dsb",
        "dual-line01-loop-dsb", "dual-line12-loop-dsb", "single-line1-per-write-dsb",
        "dual-line12-per-write-dsb"};
    return labels[mode];
}

static bool OptionalLaunches(uint32_t mode, uint32_t *launches)
{
    uint32_t default_value = HostSlotCount(mode) == 1u ? DEFAULT_SINGLE_LAUNCHES : DEFAULT_DUAL_LAUNCHES;
    const char *raw = std::getenv("ATOMIC_PROBE_STRESS_LAUNCHES");
    if (raw == nullptr || raw[0] == '\0') {
        *launches = default_value;
        return true;
    }
    errno = 0;
    char *end = nullptr;
    unsigned long parsed = std::strtoul(raw, &end, 10);
    if (errno != 0 || end == raw || *end != '\0' || parsed == 0 || parsed > MAX_LAUNCHES) {
        std::fprintf(stderr, "ATOMIC_PROBE_STRESS_LAUNCHES 必须是 1..%u，实际为：%s\n", MAX_LAUNCHES, raw);
        return false;
    }
    *launches = static_cast<uint32_t>(parsed);
    return true;
}

static bool LinesAreIndependent(uint32_t *storage)
{
    uintptr_t base = reinterpret_cast<uintptr_t>(storage);
    if ((base & (CACHELINE_BYTES - 1u)) != 0u) {
        return false;
    }
    for (uint32_t line = 1; line < STORAGE_LINES; ++line) {
        uintptr_t previous = reinterpret_cast<uintptr_t>(storage + (line - 1u) * CACHELINE_WORDS);
        uintptr_t current = reinterpret_cast<uintptr_t>(storage + line * CACHELINE_WORDS);
        if (current - previous != CACHELINE_BYTES || (current >> 6) == (previous >> 6)) {
            return false;
        }
    }
    return true;
}

int32_t main()
{
    uint32_t mode = 0;
    if (!atomic_probe::RequiredUintEnv("ATOMIC_PROBE_MODE", NUM_MODES, &mode)) {
        return EXIT_FAILURE;
    }
    uint32_t launches = 0;
    if (!OptionalLaunches(mode, &launches)) {
        return EXIT_FAILURE;
    }

    uint32_t data_start_line = HostDataStartLine(mode);
    uint32_t slots = HostSlotCount(mode);
    bool per_write_dsb = HostUsesPerWriteDsb(mode);

    int32_t device = atomic_probe::DeviceId();
    if (device < 0) return EXIT_FAILURE;
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(device));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    uint32_t *device_storage = nullptr;
    PROBE_ACL_CHECK(aclrtMalloc(reinterpret_cast<void **>(&device_storage), STORAGE_WORDS * sizeof(uint32_t),
                                ACL_MEM_MALLOC_HUGE_FIRST));
    if (!LinesAreIndependent(device_storage)) {
        std::fprintf(stderr, "single-core stress storage 未满足独立 64B line 前提\n");
        aclrtFree(device_storage);
        aclrtDestroyStream(stream);
        aclrtResetDevice(device);
        aclFinalize();
        return EXIT_FAILURE;
    }
    uintptr_t allocation = reinterpret_cast<uintptr_t>(device_storage);
    std::printf("allocation_alignment mod128=%llu mod256=%llu mod512=%llu\n",
                static_cast<unsigned long long>(allocation % 128u),
                static_cast<unsigned long long>(allocation % 256u),
                static_cast<unsigned long long>(allocation % 512u));

    uint64_t total_errors = 0;
    uint64_t total_slot_errors[2] = {0u, 0u};
    uint64_t protocol_failures = 0;
    uint64_t final_snapshot_failures = 0;
    bool have_first_error = false;
    uint32_t first_launch = INVALID_U32;
    uint32_t first_actual = 0;
    uint32_t first_expected = 0;
    uint32_t first_trial = INVALID_U32;
    uint32_t first_slot = INVALID_U32;
    uint32_t first_core = INVALID_U32;
    uint32_t first_subblock = INVALID_U32;
    int32_t first_comm_slot = 0;
    uint32_t progress_step = launches < 10u ? 1u : launches / 10u;

    for (uint32_t launch = 0; launch < launches; ++launch) {
        uint32_t host[STORAGE_WORDS] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(device_storage, sizeof(host), host, sizeof(host), ACL_MEMCPY_HOST_TO_DEVICE));
        st_dev_single_core_stress<<<1, nullptr, stream>>>(device_storage, mode);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));
        PROBE_ACL_CHECK(aclrtMemcpy(host, sizeof(host), device_storage, sizeof(host), ACL_MEMCPY_DEVICE_TO_HOST));

        uint32_t *result = host + RESULT_BASE;
        uint32_t *participation = host + PARTICIPATION_BASE;
        uint32_t *marker = host + MARKER_BASE;
        bool protocol_exact = result[RESULT_MAGIC] == RESULT_MAGIC_VALUE &&
            result[RESULT_MODE] == mode && result[RESULT_CHECKS] == TRIALS * slots &&
            result[RESULT_ERRORS] == result[RESULT_SLOT0_ERRORS] + result[RESULT_SLOT1_ERRORS] &&
            result[RESULT_ROUNDS] == ROUNDS && result[RESULT_TRIALS] == TRIALS &&
            result[RESULT_DATA_START_LINE] == data_start_line && result[RESULT_SLOTS] == slots &&
            result[RESULT_PER_WRITE_DSB] == (per_write_dsb ? 1u : 0u) &&
            result[RESULT_FINISH] == RESULT_FINISH_VALUE;

        protocol_exact = protocol_exact && participation[0] == 1u;
        for (uint32_t word = 1; word < CACHELINE_WORDS; ++word) {
            protocol_exact = protocol_exact && participation[word] == 0u;
        }

        protocol_exact = protocol_exact && marker[MARKER_MAGIC] == MARKER_MAGIC_VALUE &&
            marker[MARKER_BLOCK_IDX] == 0u && marker[MARKER_BLOCK_NUM] == 1u &&
            marker[MARKER_COMM_SLOT] == static_cast<uint32_t>(HostComputeA5CommSlot(
                marker[MARKER_CORE_ID], marker[MARKER_SUBBLOCK_ID])) &&
            marker[MARKER_MODE] == mode && marker[MARKER_SLOTS] == slots &&
            marker[MARKER_DATA_START_LINE] == data_start_line &&
            marker[MARKER_PER_WRITE_DSB] == (per_write_dsb ? 1u : 0u) && marker[MARKER_ARRIVED] == 1u;
        for (uint32_t word = MARKER_WRITTEN_WORDS; word < CACHELINE_WORDS; ++word) {
            protocol_exact = protocol_exact && marker[word] == 0u;
        }
        if (launch == 0u) {
            first_core = marker[MARKER_CORE_ID];
            first_subblock = marker[MARKER_SUBBLOCK_ID];
            first_comm_slot = static_cast<int32_t>(marker[MARKER_COMM_SLOT]);
        }

        for (uint32_t line = 0; line < DATA_LINES; ++line) {
            bool target_line = line >= data_start_line && line < data_start_line + slots;
            uint32_t logical_slot = line - data_start_line;
            for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
                uint32_t expected = target_line && word == 0u ?
                    HostTrialValue(mode, logical_slot, TRIALS - 1u, ROUNDS - 1u) : 0u;
                if (host[line * CACHELINE_WORDS + word] != expected) {
                    if (target_line && word == 0u) {
                        ++final_snapshot_failures;
                    } else {
                        protocol_exact = false;
                    }
                }
            }
        }
        for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
            protocol_exact = protocol_exact && host[TAIL_GUARD_BASE + word] == 0u;
        }

        uint32_t launch_errors = result[RESULT_ERRORS];
        total_errors += launch_errors;
        total_slot_errors[0] += result[RESULT_SLOT0_ERRORS];
        total_slot_errors[1] += result[RESULT_SLOT1_ERRORS];
        if (launch_errors == 0u) {
            protocol_exact = protocol_exact && result[RESULT_FIRST_ACTUAL] == 0u &&
                result[RESULT_FIRST_EXPECTED] == 0u && result[RESULT_FIRST_TRIAL] == INVALID_U32 &&
                result[RESULT_FIRST_SLOT] == INVALID_U32;
        } else {
            bool diagnostic_exact = result[RESULT_FIRST_ACTUAL] != result[RESULT_FIRST_EXPECTED] &&
                result[RESULT_FIRST_TRIAL] < TRIALS && result[RESULT_FIRST_SLOT] < slots &&
                result[RESULT_FIRST_EXPECTED] == HostTrialValue(
                    mode, result[RESULT_FIRST_SLOT], result[RESULT_FIRST_TRIAL], ROUNDS - 1u);
            protocol_exact = protocol_exact && diagnostic_exact;
            if (!have_first_error) {
                have_first_error = true;
                first_launch = launch;
                first_actual = result[RESULT_FIRST_ACTUAL];
                first_expected = result[RESULT_FIRST_EXPECTED];
                first_trial = result[RESULT_FIRST_TRIAL];
                first_slot = result[RESULT_FIRST_SLOT];
                std::printf("FIRST_NONZERO mode=%u launch=%u errors=%u/%u slot0=%u slot1=%u "
                            "trial=%u slot=%u actual=0x%08x expected=0x%08x\n",
                            mode, launch, launch_errors, TRIALS * slots,
                            result[RESULT_SLOT0_ERRORS], result[RESULT_SLOT1_ERRORS],
                            first_trial, first_slot, first_actual, first_expected);
            }
        }
        if (!protocol_exact) {
            ++protocol_failures;
        }

        if ((launch + 1u) % progress_step == 0u || launch + 1u == launches) {
            std::printf("progress mode=%u launches=%u/%u mismatches=%llu/%llu\n", mode, launch + 1u,
                        launches, static_cast<unsigned long long>(total_errors),
                        static_cast<unsigned long long>(launch + 1u) * TRIALS * slots);
        }
    }

    std::printf("topology mode=%u block0(core=%u sub=%u comm_slot=%d)\n",
                mode, first_core, first_subblock, first_comm_slot);
    std::printf("aggregate single-core mode=%u label=%s data_start_line=%u slots=%u per_write_dsb=%u "
                "mismatches=%llu/%llu slot0=%llu/%llu slot1=%llu/%llu "
                "final_snapshot_bad=%llu first_launch=%u first_trial=%u first_slot=%u "
                "actual=0x%08x expected=0x%08x\n",
                mode, ModeLabel(mode), data_start_line, slots, per_write_dsb ? 1u : 0u,
                static_cast<unsigned long long>(total_errors),
                static_cast<unsigned long long>(launches) * TRIALS * slots,
                static_cast<unsigned long long>(total_slot_errors[0]),
                static_cast<unsigned long long>(launches) * TRIALS,
                static_cast<unsigned long long>(total_slot_errors[1]),
                static_cast<unsigned long long>(launches) * TRIALS * (slots - 1u),
                static_cast<unsigned long long>(final_snapshot_failures), first_launch,
                first_trial, first_slot, first_actual, first_expected);

    atomic_probe::Result result;
    result.Expect(protocol_failures == 0u,
                  "单 AIV 参与计数、拓扑 marker、结果头、非目标 data 与 guard 精确");
    result.Expect(total_errors == 0u,
                  "单 AIV repeated st_dev 后的 bypass load 必须看到每个 slot 的最后写入值");
    result.Expect(final_snapshot_failures == 0u,
                  "每次 launch 返回 host 时，目标 data 的最终快照必须精确");

    PROBE_ACL_CHECK(aclrtFree(device_storage));
    PROBE_ACL_CHECK(aclrtDestroyStream(stream));
    PROBE_ACL_CHECK(aclrtResetDevice(device));
    PROBE_ACL_CHECK(aclFinalize());
    return result.ExitCode();
}
