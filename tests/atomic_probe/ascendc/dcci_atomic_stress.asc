// dcci type survey + st_dev/ld_dev exhaustive stress probe.
//
// Part 1（旧的观察性调查）：比较同一 ordinary dirty line 上的三个 DCCI selector。
//   Mode 0: dcci(ptr, 0, 0) CACHELINE_ALL  on dirty line
//   Mode 1: dcci(ptr, 0, 2) CACHELINE_OUT  on dirty line
//   Mode 2: dcci(ptr, 0, 3) CACHELINE_ATOMIC on dirty line
//
//   For each: block0 stores word[0] (L1 dirty), block1 st_dev word[3],
//   then block0 does dcci(type). Does word[3] survive?
// 该段没有精确门禁、未关闭编译器自动 DCCI，只保留为 legacy stress，不能用于解释
// 第三参数。权威结论见 dcci_atomic_clobber.asc 与 ccec/dcci_atomic_clobber.cpp。
//
// Part 2: st_dev/ld_dev exhaustive stress
//   Mode 3: N-block tight-loop st_dev to different words in one line (observation)
//   Mode 4: st_dev writer + ld_dev reader (torn read check, 10000 rounds)
//   Mode 5: st_dev + AtomicAdd concurrent on same line (10000 rounds)
//   Mode 6: ld_dev reader during st_dev writer (atomicity of 64B line)
//
// Build:
//   bisheng -xasc dcci_atomic_stress.asc --npu-arch=dav-3510 -o /tmp/dcci_as
//   /tmp/dcci_atomic_stress
#include "../probe_host.h"
#include "kernel_operator.h"
#include <cstdint>
#include <time.h>
#include <cstdio>
using namespace AscendC;

#ifndef SINGLE_CACHE_LINE
#define SINGLE_CACHE_LINE 0
#endif
#ifndef CACHELINE_OUT
#define CACHELINE_OUT 2
#endif

constexpr uint32_t STRESS_ROUNDS = 10000;

__schedmode__(1) __global__ __mix__(0, 1) void dcci_as(
    __gm__ uint32_t *gx, uint32_t mode, uint32_t num_blocks)
{
    uint32_t bid = GetBlockIdx();
    uint32_t nb = num_blocks;

    // ==================================================================
    // Part 1: dcci type survey (modes 0-2)
    //
    // Block 0: scalar store gx[0] (L1 dirty)
    // Block 1: st_dev gx[3] (HBM fresh)
    // Block 0: dcci(gx, 0, type) — does word[3] survive?
    // ==================================================================
    if (mode <= 2) {
        SyncAll();
        if (bid == 0) {
            gx[0] = 0xAA;  // dirty L1: word[0]=0xAA, word[3] stale=0
        }
        SyncAll();
        if (bid == 1) {
            WriteGmByPassDCache<uint32_t>(&gx[3], 0xCAFEBABEu);
        }
        SyncAll();
        if (bid == 0) {
            if (mode == 0)      dcci(gx, SINGLE_CACHE_LINE, 0);  // CACHELINE_ALL
            else if (mode == 1) dcci(gx, SINGLE_CACHE_LINE, 2);  // CACHELINE_OUT
            else                dcci(gx, SINGLE_CACHE_LINE, 3);  // CACHELINE_ATOMIC
        }
        SyncAll();
        if (bid == 1) {
            uint32_t w0 = ReadGmByPassDCache<uint32_t>(&gx[0]);
            uint32_t w3 = ReadGmByPassDCache<uint32_t>(&gx[3]);
            WriteGmByPassDCache<uint32_t>(&gx[16], w0);
            WriteGmByPassDCache<uint32_t>(&gx[17], w3);
            WriteGmByPassDCache<uint32_t>(&gx[18], (w3 == 0xCAFEBABEu) ? 0 : 1);
            WriteGmByPassDCache<uint32_t>(&gx[19], (w0 == 0xAA) ? 0 : 1);
        }
        SyncAll();

    // ==================================================================
    // Mode 3: N-block tight-loop st_dev to one shared cache line.
    // This is the unordered hazard measured precisely by st_dev_same_line.asc;
    // 不把依赖调度的 mismatch 计数当作安全路径的精确判定标准。
    // ==================================================================
    } else if (mode == 3) {
        SyncAll();
        // Each block writes its own words via st_dev, tight loop, no mid-sync
        for (uint32_t r = 0; r < STRESS_ROUNDS; r++) {
            for (uint32_t w = bid; w < 16; w += nb)
                WriteGmByPassDCache<uint32_t>(&gx[w], r * 16 + w);
        }
        SyncAll();
        if (bid == 0) {
            uint32_t err = 0;
            for (uint32_t w = 0; w < 16; w++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[w]);
                uint32_t expected = (STRESS_ROUNDS - 1) * 16 + w;
                if (v != expected) err++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], err);
        }
        SyncAll();

    // ==================================================================
    // Mode 4: st_dev writer + ld_dev reader (torn read check)
    //
    // Block 0: 10000× { st_dev all 16 words = round; st_dev flag = round; }
    // Block 1: continuously ld_dev reads 16 words + flag, checks consistency
    // ==================================================================
    } else if (mode == 4) {
        SyncAll();
        if (bid == 0) {
            // Writer: write all 16 words + flag
            for (uint32_t r = 1; r <= STRESS_ROUNDS; r++) {
                for (uint32_t w = 0; w < 16; w++)
                    WriteGmByPassDCache<uint32_t>(&gx[w], r);
                WriteGmByPassDCache<uint32_t>(&gx[31], r);  // flag = last round
            }
        } else if (bid == 1) {
            // Reader: check all 16 words have same value
            uint32_t torn = 0;
            uint32_t reads = 0;
            uint32_t flag = 0;
            while (flag < STRESS_ROUNDS) {
                uint32_t vals[16];
                for (uint32_t w = 0; w < 16; w++)
                    vals[w] = ReadGmByPassDCache<uint32_t>(&gx[w]);
                flag = ReadGmByPassDCache<uint32_t>(&gx[31]);
                reads++;
                // All 16 data words should be same round number
                uint32_t v0 = vals[0];
                for (uint32_t w = 1; w < 16; w++) {
                    if (vals[w] != v0) { torn++; break; }
                }
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], torn);
            WriteGmByPassDCache<uint32_t>(&gx[17], reads);
        }
        SyncAll();

    // ==================================================================
    // Mode 5：st_dev 与 AtomicAdd 并发，观察 flag 是否被覆盖
    //
    // Block 0: 10000× AtomicAdd(&gx[0], 1)
    // Block 1: 10000× st_dev gx[1..15] = round
    // Check: gx[0] should be 10000 (only logical block 0 adds), words 1-15 correct
    // ==================================================================
    } else if (mode == 5) {
        SyncAll();
        if (bid == 0) {
            for (uint32_t r = 0; r < STRESS_ROUNDS; r++)
                AtomicAdd(&gx[0], 1u);
        }
        if (bid == 1) {
            for (uint32_t r = 0; r < STRESS_ROUNDS; r++) {
                for (uint32_t w = 1; w < 16; w++)
                    WriteGmByPassDCache<uint32_t>(&gx[w], r);
            }
        }
        SyncAll();
        if (bid == 0) {
            uint32_t atomic_val = ReadGmByPassDCache<uint32_t>(&gx[0]);
            uint32_t data_err = 0;
            for (uint32_t w = 1; w < 16; w++) {
                uint32_t v = ReadGmByPassDCache<uint32_t>(&gx[w]);
                if (v != STRESS_ROUNDS - 1) data_err++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], atomic_val);
            WriteGmByPassDCache<uint32_t>(&gx[17], data_err);
            WriteGmByPassDCache<uint32_t>(&gx[18], STRESS_ROUNDS);
        }
        SyncAll();

    // ==================================================================
    // Mode 6: ld_dev atomicity — can reader see old/new mix within 64B?
    //
    // Block 0: alternates between writing PATTERN_OLD and PATTERN_NEW
    //          to all 16 words via st_dev. No flag.
    // Block 1: reads all 16 words via ld_dev, counts how many times
    //          it sees a mix of OLD and NEW (partial update).
    // ==================================================================
    } else if (mode == 6) {
        SyncAll();
        if (bid == 0) {
            // Writer: alternate patterns
            for (uint32_t r = 0; r < STRESS_ROUNDS; r++) {
                uint32_t pat = (r % 2 == 0) ? 0xAAAAAAAAu : 0xBBBBBBBBu;
                for (uint32_t w = 0; w < 16; w++)
                    WriteGmByPassDCache<uint32_t>(&gx[w], pat);
            }
            WriteGmByPassDCache<uint32_t>(&gx[31], 1);  // done flag
        } else if (bid == 1) {
            // Reader
            uint32_t mixed = 0;
            uint32_t reads = 0;
            uint32_t done = 0;
            while (!done) {
                uint32_t v0 = ReadGmByPassDCache<uint32_t>(&gx[0]);
                uint32_t v15 = ReadGmByPassDCache<uint32_t>(&gx[15]);
                done = ReadGmByPassDCache<uint32_t>(&gx[31]);
                reads++;
                // v0 and v15 should be same pattern (both AAAA or both BBBB)
                if (v0 != v15) mixed++;
            }
            WriteGmByPassDCache<uint32_t>(&gx[16], mixed);
            WriteGmByPassDCache<uint32_t>(&gx[17], reads);
        }
        SyncAll();
    }
}

int32_t main(int32_t argc, char *argv[])
{
    int32_t deviceId = atomic_probe::DeviceId();
    if (deviceId < 0) {
        return EXIT_FAILURE;
    }
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    uint32_t *gx_dev = nullptr;
    PROBE_ACL_CHECK(aclrtMalloc((void **)&gx_dev, 64 * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    atomic_probe::Result result;

    const char *names[] = {
        "dcci ALL(0) dirty   ",
        "dcci OUT(2) dirty   ",
        "dcci ATOMIC(3) dirty",
        "st_dev N-blk 10k    ",
        "st_dev+ld_dev torn  ",
        "st_dev+AtomicAdd    ",
        "ld_dev atomicity    ",
    };
    const int NUM_MODES = 7;

    printf("=== dcci Type Survey + st_dev/ld_dev Stress ===\n\n");

    for (int mode = 0; mode < NUM_MODES; mode++) {
        uint32_t nblk = (mode == 3) ? 3 : 2;
        uint32_t zeros[64] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(gx_dev, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE));

        struct timespec ts0, ts1;
        clock_gettime(CLOCK_MONOTONIC, &ts0);

        dcci_as<<<nblk, nullptr, stream>>>(gx_dev, (uint32_t)mode, nblk);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));

        clock_gettime(CLOCK_MONOTONIC, &ts1);
        double us = (ts1.tv_sec - ts0.tv_sec) * 1e6 + (ts1.tv_nsec - ts0.tv_nsec) / 1e3;

        uint32_t r[64] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(r, sizeof(r), gx_dev, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST));

        if (mode <= 2) {
            const char *type_name = (mode == 0) ? "ALL" : (mode == 1) ? "OUT" : "ATOMIC";
            printf("[%s] dcci(ptr,0,%d) %s  w0=0x%x w3=0x%x(exp 0xCAFEBABE)  %s  %.0fus\n",
                   names[mode], mode == 0 ? 0 : (mode == 1 ? 2 : 3), type_name,
                   r[16], r[17],
                   r[18] ? "w3:CLOBBERED" : "w3:SURVIVED", us);
        } else if (mode == 3) {
            printf("[%s] mode=%d blk=%u  err=%u/16  %.0fus\n",
                   names[mode], mode, nblk, r[16], us);
            result.Observe("N-block repeated st_dev to different slots in one cache line");
        } else if (mode == 4) {
            printf("[%s] torn=%u/%u reads  %.0fus\n",
                   names[mode], r[16], r[17], us);
            result.Expect(r[17] > 0, "st_dev/ld_dev observer executed");
        } else if (mode == 5) {
            printf("[%s] atomic_gx0=%u(exp %u) data_err=%u/15  %.0fus\n",
                   names[mode], r[16], r[18], r[17], us);
            result.Expect(r[16] == r[18] && r[17] == 0, "st_dev plus AtomicAdd exact result");
        } else if (mode == 6) {
            printf("[%s] mixed=%u/%u reads  %.0fus\n",
                   names[mode], r[16], r[17], us);
            result.Expect(r[17] > 0, "ld_dev atomicity observer executed");
        }
    }

    // dcci ATOMIC mode repeated 10× for consistency
    printf("\n--- dcci ATOMIC(3) x10 runs ---\n");
    for (int i = 0; i < 10; i++) {
        uint32_t zeros[64] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(gx_dev, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE));
        dcci_as<<<2, nullptr, stream>>>(gx_dev, 2, 2);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));
        uint32_t r[64] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(r, sizeof(r), gx_dev, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST));
        printf("  run %d: w0=0x%x w3=0x%x %s\n", i, r[16], r[17],
               r[18] ? "CLOBBERED" : "SURVIVED");
    }

    // Repeat the unordered same-line stress to report its distribution.
    printf("\n--- st_dev N-blk stress x5 runs ---\n");
    for (int i = 0; i < 5; i++) {
        uint32_t zeros[64] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(gx_dev, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE));
        dcci_as<<<3, nullptr, stream>>>(gx_dev, 3, 3);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));
        uint32_t r[64] = {0};
        PROBE_ACL_CHECK(aclrtMemcpy(r, sizeof(r), gx_dev, sizeof(r), ACL_MEMCPY_DEVICE_TO_HOST));
        printf("  run %d: err=%u/16\n", i, r[16]);
    }

    printf("\n=== Summary ===\n");
    printf("dcci selector survey is legacy observational output; use dcci_atomic_clobber for gating\n");
    printf("st_dev: bypasses DCache; repeated cross-AIV same-line writes remain an observed hazard\n");
    printf("ld_dev: bypass DCache, direct HBM read\n");

    bool cleanup_ok = true;
    cleanup_ok &= atomic_probe::CheckAcl(aclrtFree(gx_dev), "aclrtFree(gx_dev)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)", __FILE__, __LINE__);
    cleanup_ok &= atomic_probe::CheckAcl(aclFinalize(), "aclFinalize()", __FILE__, __LINE__);
    result.Expect(cleanup_ok, "ACL cleanup");
    return result.ExitCode();
}
