// Cache-line atomic blast-radius probe.
//
// Question: does AtomicMax/AtomicAdd on gx[0] clobber gx[1..15] in the same
// 64B cache line?  On A5 there is no HW cache coherence, so a normal
// store+dcci(CACHELINE_OUT) writes the entire dirty L1 line back to HBM,
// potentially overwriting a neighbour's data.  Hardware atomics
// (AtomicMax/AtomicAdd) are supposed to bypass L1 and do RMW directly in
// L2/HBM, touching only the target word.  This probe verifies that.
//
// Note: A5 atomic granularity is 4 bytes (uint32_t).  There is no 2-byte
// atomic; "2 bytes" in the question is conceptual — the point is whether
// the blast radius extends beyond the target word to the full cache line.
//
// Layout (gx is one 64B cache line for testing, rest in separate lines):
//   gx[0]      — atomic target (attacker operates here)
//   gx[1..15]  — victim sentinel data (defender writes + flushes)
//   gx[16]     — corruption count (defender reports clobbered neighbours)
//   gx[17]     — gx[0] actual value after test
//   gx[18]     — gx[0] expected value
//   gx[19..34] — snapshot of gx[0..15] after test (debugging)
//
// Modes:
//   0 = sequential:  defender writes+flush → SyncAll → attacker atomic → SyncAll → verify
//                    Expected PASS — no stale L1, atomic is isolated.
//
//   1 = stale-L1:    attacker reads cache line first (L1 warm with zeros)
//                    → SyncAll → defender writes+flush (HBM has sentinels, attacker
//                    L1 still stale) → SyncAll → attacker atomic → SyncAll → verify
//                    CRITICAL: if atomic uses L1 RMW + writeback, stale zeros
//                    clobber sentinels in HBM.
//
//   2 = concurrent atomic: attacker 100× AtomicAdd(&gx[0],1) while defender
//                         writes sentinels via AtomicMax (NOT scalar store).
//                         No SyncAll between them.
//                         Expected PASS — concurrent atomics on different words
//                         of the same cache line don't interfere.
//
//   3 = reverse:     attacker atomicMax first, then defender writes gx[1]+flush.
//                    Tests reverse direction: does defender's dcci(CACHELINE_OUT)
//                    clobber the atomic result in gx[0] with stale L1 data?
//
//   4 = concurrent mixed: attacker 100× AtomicAdd(&gx[0],1) while defender
//                    writes sentinels via scalar store + dcci(CACHELINE_OUT).
//                    Expected: gx[0] may be CLOBBERED — dcci writes entire dirty
//                    L1 line back to HBM, overwriting the atomic result.
//                    This is the KNOWN dcci-clobber (not atomic's fault).
//
// Build/run:
//   bisheng -xasc cacheline_blast.asc --npu-arch=dav-3510 -o /tmp/cacheline_blast
//   /tmp/cacheline_blast
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cstdint>
#include <time.h>
#include <cstdio>
using namespace AscendC;

#ifndef SINGLE_CACHE_LINE
#define SINGLE_CACHE_LINE 0
#endif
#ifndef CACHELINE_OUT
#define CACHELINE_OUT 2
#endif

constexpr int32_t CACHELINE_BYTES = 64;
constexpr uint32_t SENTINEL_BASE  = 0xA000;  // gx[1]=0xA001, gx[2]=0xA002, ...
constexpr uint32_t ATOMIC_TARGET  = 0xBEEF;  // AtomicMax target for gx[0]
constexpr uint32_t ATOMIC_ADDS    = 100;     // AtomicAdd rounds in mode 2

__aicore__ inline void dcci_flush_line(__gm__ void *ptr) {
    dcci(ptr, SINGLE_CACHE_LINE, CACHELINE_OUT);
}
__aicore__ inline void dcci_inval_line(__gm__ void *ptr) {
    dcci(ptr, SINGLE_CACHE_LINE);
}

// Fill gx[19..34] snapshot and gx[16..18] summary for host consumption.
// Called by the defender (bid==1) after invalidate + read-back.
__aicore__ inline void report_result(__gm__ uint32_t *gx, uint32_t gx0_expected) {
    uint32_t corrupted = 0;
    for (uint32_t i = 1; i <= 15; i++) {
        if (gx[i] != SENTINEL_BASE + i) corrupted++;
    }
    gx[16] = corrupted;
    gx[17] = gx[0];            // actual gx[0]
    gx[18] = gx0_expected;     // expected gx[0]
    for (uint32_t i = 0; i <= 15; i++) gx[19 + i] = gx[i];
}

__schedmode__(1) __global__ __mix__(0, 1) void cacheline_blast(
    __gm__ uint32_t *gx, uint32_t mode)
{
    uint32_t bid = GetBlockIdx();

    // ================================================================
    // Mode 0: Sequential (control — no stale L1)
    // ================================================================
    if (mode == 0) {
        SyncAll();                          // 1: init done

        if (bid == 1) {
            for (uint32_t i = 1; i <= 15; i++) gx[i] = SENTINEL_BASE + i;
            dcci_flush_line(gx);
        }

        SyncAll();                          // 2: sentinels in HBM

        if (bid == 0) {
            AtomicMax(&gx[0], ATOMIC_TARGET);
        }

        SyncAll();                          // 3: atomic done

        if (bid == 1) {
            dcci_inval_line(gx);
            report_result(gx, ATOMIC_TARGET);
        }

        SyncAll();                          // 4: done

    // ================================================================
    // Mode 1: Stale L1 (the critical test)
    // ================================================================
    } else if (mode == 1) {
        SyncAll();                          // 1: init done

        if (bid == 0) {
            // Attacker: warm L1 by reading entire cache line (all zeros)
            volatile __gm__ uint32_t *vgx = gx;
            uint32_t sum = 0;
            for (uint32_t i = 0; i <= 15; i++) sum += vgx[i];
            (void)sum;
        }

        SyncAll();                          // 2: attacker L1 warmed

        if (bid == 1) {
            for (uint32_t i = 1; i <= 15; i++) gx[i] = SENTINEL_BASE + i;
            dcci_flush_line(gx);            // HBM now has sentinels
        }

        SyncAll();                          // 3: sentinels in HBM

        if (bid == 0) {
            // AtomicMax should bypass L1 and go to L2/HBM.
            // If it pulls L1 (stale zeros) → RMW → writeback, it clobbers gx[1..15].
            AtomicMax(&gx[0], ATOMIC_TARGET);
        }

        SyncAll();                          // 4: atomic done

        if (bid == 1) {
            dcci_inval_line(gx);
            report_result(gx, ATOMIC_TARGET);
        }

        SyncAll();                          // 5: done

    // ================================================================
    // Mode 2: Concurrent atomic-vs-atomic (no scalar store interference)
    // ================================================================
    } else if (mode == 2) {
        SyncAll();                          // 1: start

        if (bid == 0) {
            for (uint32_t i = 0; i < ATOMIC_ADDS; i++) {
                AtomicAdd(&gx[0], 1u);
            }
        }
        if (bid == 1) {
            // Defender uses atomic writes (NOT scalar store) — both sides
            // bypass L1, so neither can clobber the other.
            for (uint32_t i = 1; i <= 15; i++) AtomicMax(&gx[i], SENTINEL_BASE + i);
        }

        SyncAll();                          // 2: both done

        if (bid == 1) {
            dcci_inval_line(gx);
            report_result(gx, ATOMIC_ADDS);
        }

        SyncAll();                          // 3: done

    // ================================================================
    // Mode 3: Reverse (does defender's dcci clobber attacker's atomic?)
    // ================================================================
    } else if (mode == 3) {
        SyncAll();                          // 1: init done

        if (bid == 0) {
            // Attacker: warm L1, then atomic
            volatile __gm__ uint32_t *vgx = gx;
            uint32_t sum = 0;
            for (uint32_t i = 0; i <= 15; i++) sum += vgx[i];
            (void)sum;
        }

        SyncAll();                          // 2: L1 warmed

        if (bid == 0) {
            AtomicMax(&gx[0], ATOMIC_TARGET);
        }

        SyncAll();                          // 3: atomic done

        if (bid == 1) {
            // Defender: write sentinel to ONE neighbour, then flush.
            // If defender's L1 has stale gx[0], the flush clobbers the atomic.
            gx[1] = SENTINEL_BASE + 1;
            dcci_flush_line(gx);
        }

        SyncAll();                          // 4: defender done

        if (bid == 1) {
            dcci_inval_line(gx);
            // Check: gx[0] should survive defender's dcci flush
            uint32_t corrupted = 0;
            if (gx[0] != ATOMIC_TARGET) corrupted = 0xFF;  // special: atomic lost
            gx[16] = corrupted;
            gx[17] = gx[0];
            gx[18] = ATOMIC_TARGET;
            for (uint32_t i = 0; i <= 15; i++) gx[19 + i] = gx[i];
        }

        SyncAll();                          // 5: done

    // ================================================================
    // Mode 4: Concurrent mixed (atomic + scalar store + dcci)
    //         Demonstrates the KNOWN dcci-clobber (reverse direction).
    // ================================================================
    } else if (mode == 4) {
        SyncAll();                          // 1: start

        if (bid == 0) {
            for (uint32_t i = 0; i < ATOMIC_ADDS; i++) {
                AtomicAdd(&gx[0], 1u);
            }
        }
        if (bid == 1) {
            // Scalar store + dcci(CACHELINE_OUT) writes the ENTIRE dirty L1
            // line back to HBM.  If gx[0] was loaded into L1 as 0 before the
            // atomics, the writeback clobbers the atomic results.
            for (uint32_t i = 1; i <= 15; i++) gx[i] = SENTINEL_BASE + i;
            dcci_flush_line(gx);
        }

        SyncAll();                          // 2: both done

        if (bid == 1) {
            dcci_inval_line(gx);
            report_result(gx, ATOMIC_ADDS);
        }

        SyncAll();                          // 3: done

    // ================================================================
    // Mode 5: Byte-granular uint32_t atomic (blast radius = 4 bytes)
    // Fills 64 bytes with unique sentinels at byte granularity, does
    // uint32_t AtomicMax on bytes 0-3, checks bytes 4-63 individually.
    // ================================================================
    } else if (mode == 5) {
        SyncAll();                          // 1: init done

        if (bid == 0) {
            // Attacker: warm L1 with zeros
            volatile __gm__ uint8_t *vb = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t sum = 0;
            for (uint32_t i = 0; i < 64; i++) sum += vb[i];
            (void)sum;
        }

        SyncAll();                          // 2: L1 warmed

        if (bid == 1) {
            // Defender: fill every byte with a unique sentinel
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            for (uint32_t i = 0; i < 64; i++) bytes[i] = (uint8_t)(i + 1);
            dcci_flush_line(gx);
        }

        SyncAll();                          // 3: sentinels in HBM

        if (bid == 0) {
            // Attacker: uint32_t atomic on bytes 0-3
            // 0xFFFFFFFF > any sentinel-formed value, so AtomicMax always overwrites
            AtomicMax(&gx[0], 0xFFFFFFFFu);
        }

        SyncAll();                          // 4: atomic done

        if (bid == 1) {
            dcci_inval_line(gx);
            // Check every byte: bytes 0-3 = atomic result, bytes 4-63 = sentinels
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t corrupted = 0;
            for (uint32_t i = 4; i < 64; i++) {
                if (bytes[i] != (uint8_t)(i + 1)) corrupted++;
            }
            gx[16] = corrupted;
            gx[17] = gx[0];
            gx[18] = ATOMIC_TARGET;
            for (uint32_t i = 0; i <= 15; i++) gx[19 + i] = gx[i];
        }

        SyncAll();                          // 5: done

    // ================================================================
    // Mode 6: Byte-granular half atomicAdd (blast radius = 2 bytes)
    // A5's narrowest atomic is half (2 bytes).  This verifies the
    // blast radius is exactly 2 bytes, not the full cache line.
    // ================================================================
    } else if (mode == 6) {
        SyncAll();                          // 1: init done

        if (bid == 0) {
            volatile __gm__ uint8_t *vb = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t sum = 0;
            for (uint32_t i = 0; i < 64; i++) sum += vb[i];
            (void)sum;
        }

        SyncAll();                          // 2: L1 warmed

        if (bid == 1) {
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            for (uint32_t i = 0; i < 64; i++) bytes[i] = (uint8_t)(i + 1);
            dcci_flush_line(gx);
        }

        SyncAll();                          // 3: sentinels in HBM

        if (bid == 0) {
            // half atomicAdd on bytes 0-1 only (2-byte atomic)
            __gm__ half *ph = reinterpret_cast<__gm__ half*>(&gx[0]);
            atomicAdd(ph, (half)128.0f);  // large value to change the 2 bytes
        }

        SyncAll();                          // 4: atomic done

        if (bid == 1) {
            dcci_inval_line(gx);
            // Check: bytes 2-63 should be sentinels (byte 0-1 changed by half atomic)
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t corrupted = 0;
            for (uint32_t i = 2; i < 64; i++) {
                if (bytes[i] != (uint8_t)(i + 1)) corrupted++;
            }
            // For half mode, report differently: corrupted count / 62
            gx[16] = corrupted;
            gx[17] = gx[0];  // first word (includes the half result in bytes 0-1)
            gx[18] = 0x8000; // not a simple expected — host will check bytes
            for (uint32_t i = 0; i <= 15; i++) gx[19 + i] = gx[i];
        }

        SyncAll();                          // 5: done

    // ================================================================
    // Mode 7: Byte-granular uint64_t atomic (blast radius = 8 bytes)
    // ================================================================
    } else if (mode == 7) {
        SyncAll();                          // 1: init done

        if (bid == 0) {
            volatile __gm__ uint8_t *vb = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t sum = 0;
            for (uint32_t i = 0; i < 64; i++) sum += vb[i];
            (void)sum;
        }

        SyncAll();                          // 2: L1 warmed

        if (bid == 1) {
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            for (uint32_t i = 0; i < 64; i++) bytes[i] = (uint8_t)(i + 1);
            dcci_flush_line(gx);
        }

        SyncAll();                          // 3: sentinels in HBM

        if (bid == 0) {
            // uint64_t atomic on bytes 0-7 — INT64_MAX > any sentinel value
            AtomicMax(reinterpret_cast<__gm__ int64_t*>(&gx[0]), (int64_t)0x7FFFFFFFFFFFFFFFLL);
        }

        SyncAll();                          // 4: atomic done

        if (bid == 1) {
            dcci_inval_line(gx);
            // Check: bytes 8-63 should be sentinels
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t corrupted = 0;
            for (uint32_t i = 8; i < 64; i++) {
                if (bytes[i] != (uint8_t)(i + 1)) corrupted++;
            }
            gx[16] = corrupted;
            gx[17] = gx[0];
            gx[18] = (uint32_t)0xCAFE;  // low 32 bits of 0xDEADBEEFCAFE
            for (uint32_t i = 0; i <= 15; i++) gx[19 + i] = gx[i];
        }

        SyncAll();                          // 5: done
    }

    // Print result from AIC block 0 only (suppress AIV duplicate)
#ifndef __DAV_VEC__
    if (bid == 0) {
        // Modes 5-7 use byte-level checks; print extra detail
        if (mode >= 5) {
            __gm__ uint8_t *bytes = reinterpret_cast<__gm__ uint8_t*>(gx);
            uint32_t check_from = (mode == 6) ? 2 : (mode == 7 ? 8 : 4);
            uint32_t byte_corrupt = 0;
            for (uint32_t i = check_from; i < 64; i++)
                if (bytes[i] != (uint8_t)(i + 1)) byte_corrupt++;
            printf("mode=%u byte_corrupted=%u/%u  first8=",
                   mode, byte_corrupt, 64 - check_from);
            for (uint32_t i = 0; i < 8; i++) printf("%02x ", bytes[i]);
            printf("\n");
        } else {
            printf("mode=%u corrupted=%u/15 gx0=0x%x(exp 0x%x)",
                   mode, gx[16], gx[17], gx[18]);
            for (uint32_t i = 0; i <= 15; i++) {
                uint32_t actual = gx[19 + i];
                uint32_t expected;
                if ((mode == 2 || mode == 4) && i == 0) expected = ATOMIC_ADDS;
                else if (i == 0)         expected = ATOMIC_TARGET;
                else                     expected = SENTINEL_BASE + i;
                if (actual != expected) {
                    printf(" !!gx[%u]=0x%x/0x%x", i, actual, expected);
                }
            }
            printf("\n");
        }
    }
#endif
}

// =====================================================================
// Host
// =====================================================================
int32_t main(int32_t argc, char *argv[])
{
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // gx: 64 uint32_t = 256 bytes
    //   [0..15]  = test cache line (64B)
    //   [16..50] = results (separate cache lines)
    constexpr int32_t GX_SIZE = 64;
    uint32_t *gx_dev;
    aclrtMalloc((void **)&gx_dev, GX_SIZE * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);

    const char *mode_names[] = {
        "Sequential     ",
        "Stale-L1       ",
        "ConcurrentAtom ",
        "Reverse(dcci)  ",
        "ConcurrentMixed",
        "Byte32(4B)     ",
        "ByteHalf(2B)   ",
        "Byte64(8B)     ",
    };
    const int NUM_MODES = sizeof(mode_names) / sizeof(mode_names[0]);

    printf("=== Cache-line Atomic Blast-Radius Probe ===\n");
    printf("Cache line: 64B = 16 x uint32_t\n");
    printf("gx[0] = atomic target, gx[1..15] = victim sentinels (0xA001..0xA00F)\n\n");

    for (int mode = 0; mode < NUM_MODES; mode++) {
        // Zero gx
        uint32_t zeros[GX_SIZE] = {0};
        aclrtMemcpy(gx_dev, sizeof(zeros), zeros, sizeof(zeros), ACL_MEMCPY_HOST_TO_DEVICE);

        struct timespec ts_start, ts_end;
        clock_gettime(CLOCK_MONOTONIC, &ts_start);

        // Always 2 blocks: 0=attacker, 1=defender
        cacheline_blast<<<2, nullptr, stream>>>(gx_dev, (uint32_t)mode);
        aclrtSynchronizeStream(stream);

        clock_gettime(CLOCK_MONOTONIC, &ts_end);
        double host_us = (ts_end.tv_sec - ts_start.tv_sec) * 1e6 +
                         (ts_end.tv_nsec - ts_start.tv_nsec) / 1e3;

        // Read results
        uint32_t results[GX_SIZE];
        aclrtMemcpy(results, sizeof(results), gx_dev, sizeof(results), ACL_MEMCPY_DEVICE_TO_HOST);

        if (mode >= 5) {
            // Byte-granular modes: check byte-level corruption from the snapshot
            uint8_t *snap = reinterpret_cast<uint8_t*>(&results[19]);
            uint32_t check_from = (mode == 6) ? 2 : (mode == 7 ? 8 : 4);
            uint32_t corrupted = 0;
            for (uint32_t i = check_from; i < 64; i++) {
                if (snap[i] != (uint8_t)(i + 1)) corrupted++;
            }
            uint32_t total = 64 - check_from;
            bool pass = (corrupted == 0);
            printf("[%s] mode=%d  byte_corrupted=%u/%u  first8=",
                   mode_names[mode], mode, corrupted, total);
            for (uint32_t i = 0; i < 8; i++) printf("%02x ", snap[i]);
            printf(" %.0fus  %s\n", host_us, pass ? "PASS" : "FAIL");

            if (!pass) {
                printf("  expected bytes [%u..63] = 0x%02x..0x%02x\n",
                       check_from, check_from + 1, 64);
                printf("  actual bytes: ");
                for (uint32_t i = 0; i < 64; i++) {
                    if (snap[i] != (uint8_t)(i + 1))
                        printf("[%u]=%02x(want %02x) ", i, snap[i], (uint8_t)(i + 1));
                }
                printf("\n");
            }
        } else {
            uint32_t corrupted   = results[16];
            uint32_t gx0_actual   = results[17];
            uint32_t gx0_expected = results[18];

            bool gx0_ok      = (gx0_actual == gx0_expected);
            bool neighbors_ok = (corrupted == 0);
            bool pass         = gx0_ok && neighbors_ok;

            printf("[%s] mode=%d  corrupted=%u/15  gx0=0x%x(exp 0x%x)  %.0fus  %s\n",
                   mode_names[mode], mode, corrupted, gx0_actual, gx0_expected,
                   host_us, pass ? "PASS" : "FAIL");

            // Detailed dump on failure
            if (!pass) {
                printf("  snapshot: ");
                for (int i = 0; i <= 15; i++) printf("[%d]=0x%x ", i, results[19 + i]);
                printf("\n  expected: ");
                for (int i = 0; i <= 15; i++) {
                    uint32_t exp;
                    if ((mode == 2 || mode == 4) && i == 0) exp = ATOMIC_ADDS;
                    else if (i == 0)         exp = ATOMIC_TARGET;
                    else                     exp = SENTINEL_BASE + i;
                    printf("[%d]=0x%x ", i, exp);
                }
                printf("\n");
            }
        }
    }

    aclrtFree(gx_dev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
