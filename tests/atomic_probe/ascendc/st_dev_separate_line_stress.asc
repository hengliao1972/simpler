// 测试目标：只验证多个 AIV 各自独占 64B cacheline 时，连续 st_dev 的终值是否精确。
// 本用例没有任何“两个 AIV 写同一 cacheline”的路径，不能用来说明同-line 行为。
//
// Mode（同时隔离活跃 block 组合与 allocation 内 data line 起点）：
//   0. 启动两个 AIV；block0、block1 活跃；分别写 allocation 的 line0、line1。
//   1. 启动三个 AIV；block0、block2 活跃；分别写 allocation 的 line0、line1。
//   2. 启动两个 AIV；block0、block1 活跃；分别写 allocation 的 line1、line2。
//   3. 启动三个 AIV；block0、block2 活跃；分别写 allocation 的 line1、line2。
// mode 1/3 的 block1 不读取也不写入任何被测 data；除 participation AtomicAdd、写自己的
// 独占 64B topology marker 外，只与另外两个 block 等次数、同顺序参加每一个 SyncAll<true>()。
//
// 每次 launch 的固定时序：
//   1. 每个已启动 AIV 先在独立于 data 的 participation line 上做 AtomicAdd，再只写自己的
//      64B topology marker，记录 launch、逻辑 block id、block 数、get_coreid()、
//      get_subblockid()，并按本机 PTO A5 TSyncCVID 的公式计算 comm_slot；
//      marker 写完执行 DSB，随后所有 AIV 执行第一次 SyncAll。
//   2. 每个 trial 中，两个活跃 AIV 分别对自己独占 line 的同一个 4B 地址连续执行
//      257 次 WriteGmByPassDCache<uint32_t>；循环中不插 DSB，只在第 257 次之后执行
//      一次 DSB。mode 1/3 的 block1 在这一阶段不访问被测 data。
//   3. 所有 AIV 执行 SyncAll；block0 用 bypass load 精确检查两条 line 的本 trial
//      终值；所有 AIV再次执行 SyncAll，确保检查结束后才进入下一 trial。
//   4. 共执行 100 个 trial。block0 保存错误总数，以及最早错误的 actual、expected、
//      launch、trial 和活跃 slot；写完结果并执行 DSB 后，所有 AIV执行最后一次 SyncAll。
//
// 内存布局和预期：
//   - 单个 allocation 中，mode 0/1 使用 line0/line1，mode 2/3 使用 line1/line2；
//     result 固定为 line3、participation 固定为 line4、三个 marker 固定为 line5..7，
//     tail guard 固定为 line8；
//   - 两个活跃 AIV 的目标地址永远分属不同 64B line；除两个目标 word 外，所有 data
//     word 必须保持全零；mode 0/1 的未用 line2、mode 2/3 的未用 line0 和固定 tail
//     guard 也必须保持全零；
//   - 每个参与者 marker 独占一条 64B line，marker 未写字段也必须保持初始化值；
//   - 每个 trial 的两个终值必须精确等于各自第 257 次写入值；参与数、marker、PTO
//     comm_slot 公式与所有 guard 必须精确。comm_slot 严格复刻 PTO 原函数的 signed int
//     算式，只作为派生记录；raw coreid/subblockid 始终单独输出，不把 comm_slot 扩大解释
//     为硬件物理组号，也不把两个 active comm_slot 是否相同设为执行前提或正确性门禁。
#include "../probe_host.h"
#include "kernel_operator.h"

#include <cerrno>
#include <climits>
#include <cstdint>
#include <cstdio>
#include <cstdlib>

using namespace AscendC;

constexpr uint32_t CACHELINE_BYTES = 64;
constexpr uint32_t CACHELINE_WORDS = CACHELINE_BYTES / sizeof(uint32_t);
constexpr uint32_t NUM_MODES = 4;
constexpr uint32_t ROUNDS = 257;
constexpr uint32_t TRIALS = 100;
constexpr uint32_t DEFAULT_LAUNCHES = 500;
constexpr uint32_t MAX_LAUNCHES = 1000000;

// 单 allocation 的 cacheline 布局。mode 2/3 的 data line1/line2 与旧 separate
// path 的 SEPARATE_BASE=16、第二个 slot=32 完全一致。
constexpr uint32_t DATA_BASE_LINE01 = 0 * CACHELINE_WORDS;
constexpr uint32_t DATA_BASE_LINE12 = 1 * CACHELINE_WORDS;
constexpr uint32_t RESULT_BASE = 3 * CACHELINE_WORDS;
constexpr uint32_t PARTICIPATION_BASE = 4 * CACHELINE_WORDS;
constexpr uint32_t MARKER_BASE = 5 * CACHELINE_WORDS;
constexpr uint32_t TAIL_GUARD_BASE = 8 * CACHELINE_WORDS;
constexpr uint32_t STORAGE_LINES = 9;
constexpr uint32_t STORAGE_WORDS = STORAGE_LINES * CACHELINE_WORDS;

constexpr uint32_t MAX_PARTICIPANTS = 3;
constexpr uint32_t MARKER_MAGIC = 0;
constexpr uint32_t MARKER_BLOCK_IDX = 1;
constexpr uint32_t MARKER_BLOCK_NUM = 2;
constexpr uint32_t MARKER_CORE_ID = 3;
constexpr uint32_t MARKER_SUBBLOCK_ID = 4;
constexpr uint32_t MARKER_COMM_SLOT = 5;
constexpr uint32_t MARKER_MODE = 6;
constexpr uint32_t MARKER_ACTIVE = 7;
constexpr uint32_t MARKER_ACTIVE_SLOT = 8;
constexpr uint32_t MARKER_ARRIVED = 9;
constexpr uint32_t MARKER_LAUNCH = 10;
constexpr uint32_t MARKER_WRITTEN_WORDS = 11;

constexpr uint32_t PARTICIPATION_COUNT = 0;
constexpr uint32_t PARTICIPATION_LAUNCH = 1;
constexpr uint32_t PARTICIPATION_MODE = 2;
constexpr uint32_t PARTICIPATION_BLOCK_NUM = 3;
constexpr uint32_t PARTICIPATION_WRITTEN_WORDS = 4;

constexpr uint32_t RESULT_MAGIC = 0;
constexpr uint32_t RESULT_MODE = 1;
constexpr uint32_t RESULT_LAUNCH = 2;
constexpr uint32_t RESULT_TRIALS = 3;
constexpr uint32_t RESULT_ROUNDS = 4;
constexpr uint32_t RESULT_PARTICIPANTS = 5;
constexpr uint32_t RESULT_MARKER_ERRORS = 6;
constexpr uint32_t RESULT_STORE_ERRORS = 7;
constexpr uint32_t RESULT_SLOT0_ERRORS = 8;
constexpr uint32_t RESULT_SLOT1_ERRORS = 9;
constexpr uint32_t RESULT_FIRST_ACTUAL = 10;
constexpr uint32_t RESULT_FIRST_EXPECTED = 11;
constexpr uint32_t RESULT_FIRST_LAUNCH = 12;
constexpr uint32_t RESULT_FIRST_TRIAL = 13;
constexpr uint32_t RESULT_FIRST_SLOT = 14;
constexpr uint32_t RESULT_FINISH_MAGIC = 15;

constexpr uint32_t TOPOLOGY_MAGIC_BASE = 0x544f5000u;
constexpr uint32_t RESULT_MAGIC_VALUE = 0x53544453u;
constexpr uint32_t RESULT_FINISH_VALUE = 0x46494e49u;
constexpr uint32_t INVALID_U32 = 0xffffffffu;

// 与本机 PTO A5 TSyncCVID.hpp 中计算 comm_slot 的 signed int 算式一致。
constexpr int32_t PTO_CORE_PER_DIE = 18;
constexpr int32_t PTO_AIC_AIV_PER_DIE = 54;

__aicore__ inline uint32_t TrialValue(uint32_t mode, uint32_t active_slot, uint32_t trial, uint32_t round)
{
    return 0xA0000000u + mode * 0x01000000u + active_slot * 0x00100000u + trial * 0x1000u + round;
}

__aicore__ inline int32_t ComputeA5CommSlot(uint32_t core_id, uint32_t subblock_id)
{
    int32_t core = static_cast<int32_t>(core_id);
    int32_t subblock = static_cast<int32_t>(subblock_id);
    int32_t die = core / PTO_AIC_AIV_PER_DIE;
    return die * PTO_CORE_PER_DIE + (((core % PTO_AIC_AIV_PER_DIE) - PTO_CORE_PER_DIE - subblock) / 2);
}

__aicore__ inline void AivSyncAll()
{
    SyncAll<true>();
}

__schedmode__(1) __global__ __mix__(0, 1) void st_dev_separate_line_stress(
    __gm__ uint32_t *storage, uint32_t mode)
{
    uint32_t participant = static_cast<uint32_t>(get_block_idx());
    uint32_t block_num = static_cast<uint32_t>(get_block_num());
    bool launch_three_blocks = (mode & 1u) != 0;
    uint32_t second_active_block = launch_three_blocks ? 2u : 1u;
    uint32_t data_base = mode < 2 ? DATA_BASE_LINE01 : DATA_BASE_LINE12;
    bool active = participant == 0 || participant == second_active_block;
    uint32_t active_slot = participant == 0 ? 0u : (participant == second_active_block ? 1u : INVALID_U32);
    __gm__ uint32_t *result = storage + RESULT_BASE;
    __gm__ uint32_t *participation = storage + PARTICIPATION_BASE;
    __gm__ uint32_t *topology_markers = storage + MARKER_BASE;
    uint32_t launch_index = ReadGmByPassDCache<uint32_t>(&participation[PARTICIPATION_LAUNCH]);

    uint32_t core_id = static_cast<uint32_t>(get_coreid());
    uint32_t subblock_id = static_cast<uint32_t>(get_subblockid());
    int32_t comm_slot = ComputeA5CommSlot(core_id, subblock_id);
    __gm__ uint32_t *my_marker = topology_markers + participant * CACHELINE_WORDS;
    AtomicAdd(&participation[PARTICIPATION_COUNT], 1u);
    // 控制证据使用 atomic 写，避免把 marker 自身变成同-line st_dev 场景。
    AtomicExch(&my_marker[MARKER_MAGIC], TOPOLOGY_MAGIC_BASE | participant);
    AtomicExch(&my_marker[MARKER_BLOCK_IDX], participant);
    AtomicExch(&my_marker[MARKER_BLOCK_NUM], block_num);
    AtomicExch(&my_marker[MARKER_CORE_ID], core_id);
    AtomicExch(&my_marker[MARKER_SUBBLOCK_ID], subblock_id);
    AtomicExch(&my_marker[MARKER_COMM_SLOT], static_cast<uint32_t>(comm_slot));
    AtomicExch(&my_marker[MARKER_MODE], mode);
    AtomicExch(&my_marker[MARKER_ACTIVE], active ? 1u : 0u);
    AtomicExch(&my_marker[MARKER_ACTIVE_SLOT], active_slot);
    AtomicExch(&my_marker[MARKER_ARRIVED], 1u);
    AtomicExch(&my_marker[MARKER_LAUNCH], launch_index);
    DataSyncBarrier<MemDsbT::ALL>();
    AivSyncAll();

    uint32_t participant_count = 0;
    uint32_t marker_errors = 0;
    if (participant == 0) {
        participant_count = ReadGmByPassDCache<uint32_t>(&participation[PARTICIPATION_COUNT]);
        for (uint32_t p = 0; p < block_num; ++p) {
            __gm__ uint32_t *marker = topology_markers + p * CACHELINE_WORDS;
            bool marker_ok = ReadGmByPassDCache<uint32_t>(&marker[MARKER_MAGIC]) == (TOPOLOGY_MAGIC_BASE | p) &&
                             ReadGmByPassDCache<uint32_t>(&marker[MARKER_BLOCK_IDX]) == p &&
                             ReadGmByPassDCache<uint32_t>(&marker[MARKER_BLOCK_NUM]) == block_num &&
                             ReadGmByPassDCache<uint32_t>(&marker[MARKER_MODE]) == mode &&
                             ReadGmByPassDCache<uint32_t>(&marker[MARKER_ARRIVED]) == 1u &&
                             ReadGmByPassDCache<uint32_t>(&marker[MARKER_LAUNCH]) == launch_index;
            if (!marker_ok) {
                ++marker_errors;
            }
        }
    }

    uint32_t store_errors = 0;
    uint32_t slot0_errors = 0;
    uint32_t slot1_errors = 0;
    uint32_t first_actual = 0;
    uint32_t first_expected = 0;
    uint32_t first_launch = INVALID_U32;
    uint32_t first_trial = INVALID_U32;
    uint32_t first_slot = INVALID_U32;
    for (uint32_t trial = 0; trial < TRIALS; ++trial) {
        if (active) {
            uint32_t target_word = data_base + active_slot * CACHELINE_WORDS;
            for (uint32_t round = 0; round < ROUNDS; ++round) {
                WriteGmByPassDCache<uint32_t>(
                    &storage[target_word], TrialValue(mode, active_slot, trial, round));
            }
        }
        // 活跃核的 257 次 store 到这里才做一次 DSB；空闲 block1 不访问 data。
        DataSyncBarrier<MemDsbT::ALL>();
        AivSyncAll();

        if (participant == 0) {
            for (uint32_t slot = 0; slot < 2; ++slot) {
                uint32_t target_word = data_base + slot * CACHELINE_WORDS;
                uint32_t expected = TrialValue(mode, slot, trial, ROUNDS - 1);
                uint32_t actual = ReadGmByPassDCache<uint32_t>(&storage[target_word]);
                if (actual != expected) {
                    if (store_errors == 0) {
                        first_actual = actual;
                        first_expected = expected;
                        first_launch = launch_index;
                        first_trial = trial;
                        first_slot = slot;
                    }
                    ++store_errors;
                    if (slot == 0) {
                        ++slot0_errors;
                    } else {
                        ++slot1_errors;
                    }
                }
            }
        }
        AivSyncAll();
    }

    if (participant == 0) {
        // 结果控制区同样使用 atomic 写，不让结果发布自身引入同-line st_dev。
        AtomicExch(&result[RESULT_MAGIC], RESULT_MAGIC_VALUE);
        AtomicExch(&result[RESULT_MODE], mode);
        AtomicExch(&result[RESULT_LAUNCH], launch_index);
        AtomicExch(&result[RESULT_TRIALS], TRIALS);
        AtomicExch(&result[RESULT_ROUNDS], ROUNDS);
        AtomicExch(&result[RESULT_PARTICIPANTS], participant_count);
        AtomicExch(&result[RESULT_MARKER_ERRORS], marker_errors);
        AtomicExch(&result[RESULT_STORE_ERRORS], store_errors);
        AtomicExch(&result[RESULT_SLOT0_ERRORS], slot0_errors);
        AtomicExch(&result[RESULT_SLOT1_ERRORS], slot1_errors);
        AtomicExch(&result[RESULT_FIRST_ACTUAL], first_actual);
        AtomicExch(&result[RESULT_FIRST_EXPECTED], first_expected);
        AtomicExch(&result[RESULT_FIRST_LAUNCH], first_launch);
        AtomicExch(&result[RESULT_FIRST_TRIAL], first_trial);
        AtomicExch(&result[RESULT_FIRST_SLOT], first_slot);
        AtomicExch(&result[RESULT_FINISH_MAGIC], RESULT_FINISH_VALUE);
        DataSyncBarrier<MemDsbT::ALL>();
    }
    AivSyncAll();
}

static uint32_t HostTrialValue(uint32_t mode, uint32_t active_slot, uint32_t trial, uint32_t round)
{
    return 0xA0000000u + mode * 0x01000000u + active_slot * 0x00100000u + trial * 0x1000u + round;
}

static int32_t HostComputeA5CommSlot(uint32_t core_id, uint32_t subblock_id)
{
    int32_t core = static_cast<int32_t>(core_id);
    int32_t subblock = static_cast<int32_t>(subblock_id);
    int32_t die = core / PTO_AIC_AIV_PER_DIE;
    return die * PTO_CORE_PER_DIE + (((core % PTO_AIC_AIV_PER_DIE) - PTO_CORE_PER_DIE - subblock) / 2);
}

static bool OptionalPositiveUintEnv(const char *name, uint32_t default_value, uint32_t exclusive_max,
                                    uint32_t *value)
{
    const char *raw = std::getenv(name);
    if (raw == nullptr || raw[0] == '\0') {
        *value = default_value;
        return true;
    }
    errno = 0;
    char *end = nullptr;
    unsigned long parsed = std::strtoul(raw, &end, 10);
    if (errno != 0 || end == raw || *end != '\0' || parsed == 0 || parsed >= exclusive_max) {
        std::fprintf(stderr, "Invalid %s: %s (expected 1..%u)\n", name, raw, exclusive_max - 1);
        return false;
    }
    *value = static_cast<uint32_t>(parsed);
    return true;
}

static bool LinesAreIndependent(uint32_t *storage)
{
    uintptr_t addresses[STORAGE_LINES] = {0};
    for (uint32_t line = 0; line < STORAGE_LINES; ++line) {
        addresses[line] = reinterpret_cast<uintptr_t>(storage + line * CACHELINE_WORDS);
    }
    for (uint32_t i = 0; i < STORAGE_LINES; ++i) {
        if ((addresses[i] & (CACHELINE_BYTES - 1)) != 0) {
            return false;
        }
        for (uint32_t j = 0; j < i; ++j) {
            if ((addresses[i] >> 6) == (addresses[j] >> 6)) {
                return false;
            }
        }
    }
    return true;
}

int32_t main()
{
    uint32_t mode = 0;
    if (!atomic_probe::RequiredUintEnv("ATOMIC_PROBE_MODE", NUM_MODES, &mode)) {
        return EXIT_FAILURE;
    }
    uint32_t launches = DEFAULT_LAUNCHES;
    if (!OptionalPositiveUintEnv("ATOMIC_PROBE_STRESS_LAUNCHES", DEFAULT_LAUNCHES, MAX_LAUNCHES, &launches)) {
        return EXIT_FAILURE;
    }

    int32_t device = atomic_probe::DeviceId();
    if (device < 0) return EXIT_FAILURE;
    PROBE_ACL_CHECK(aclInit(nullptr));
    PROBE_ACL_CHECK(aclrtSetDevice(device));
    aclrtStream stream = nullptr;
    PROBE_ACL_CHECK(aclrtCreateStream(&stream));

    uint32_t *device_storage = nullptr;
    PROBE_ACL_CHECK(aclrtMalloc(reinterpret_cast<void **>(&device_storage), STORAGE_WORDS * sizeof(uint32_t),
                                ACL_MEM_MALLOC_HUGE_FIRST));

    if (!LinesAreIndependent(device_storage)) {
        std::fprintf(stderr, "stress allocation 的各对象未满足独立 64B cacheline 前提\n");
        aclrtFree(device_storage);
        aclrtDestroyStream(stream);
        aclrtResetDevice(device);
        aclFinalize();
        return EXIT_FAILURE;
    }
    uintptr_t allocation = reinterpret_cast<uintptr_t>(device_storage);
    std::printf("allocation_alignment mod128=%llu mod256=%llu mod512=%llu\n",
                static_cast<unsigned long long>(allocation % 128u),
                static_cast<unsigned long long>(allocation % 256u),
                static_cast<unsigned long long>(allocation % 512u));

    uint64_t total_store_errors = 0;
    uint64_t total_slot_errors[2] = {0, 0};
    uint64_t control_failures = 0;
    uint64_t participation_failures = 0;
    uint64_t marker_failures = 0;
    uint64_t final_value_failures[2] = {0, 0};
    uint64_t guard_failures = 0;
    uint64_t comm_slot_record_failures = 0;
    bool have_first_error = false;
    uint32_t global_first_actual = 0;
    uint32_t global_first_expected = 0;
    uint32_t global_first_launch = INVALID_U32;
    uint32_t global_first_trial = INVALID_U32;
    uint32_t global_first_slot = INVALID_U32;

    bool launch_three_blocks = (mode & 1u) != 0;
    uint32_t block_count = launch_three_blocks ? 3u : 2u;
    uint32_t second_active_block = launch_three_blocks ? 2u : 1u;
    uint32_t data_base = mode < 2 ? DATA_BASE_LINE01 : DATA_BASE_LINE12;
    uint32_t data_start_line = data_base / CACHELINE_WORDS;
    for (uint32_t launch = 0; launch < launches; ++launch) {
        uint32_t host_storage[STORAGE_WORDS] = {0};
        uint32_t *host_result = host_storage + RESULT_BASE;
        uint32_t *host_participation = host_storage + PARTICIPATION_BASE;
        uint32_t *host_markers = host_storage + MARKER_BASE;
        host_participation[PARTICIPATION_LAUNCH] = launch;
        host_participation[PARTICIPATION_MODE] = mode;
        host_participation[PARTICIPATION_BLOCK_NUM] = block_count;

        PROBE_ACL_CHECK(aclrtMemcpy(device_storage, sizeof(host_storage), host_storage, sizeof(host_storage),
                                    ACL_MEMCPY_HOST_TO_DEVICE));

        st_dev_separate_line_stress<<<block_count, nullptr, stream>>>(device_storage, mode);
        PROBE_ACL_CHECK(aclrtSynchronizeStream(stream));
        PROBE_ACL_CHECK(aclrtMemcpy(host_storage, sizeof(host_storage), device_storage, sizeof(host_storage),
                                    ACL_MEMCPY_DEVICE_TO_HOST));

        bool result_header_ok = host_result[RESULT_MAGIC] == RESULT_MAGIC_VALUE &&
                                host_result[RESULT_MODE] == mode &&
                                host_result[RESULT_LAUNCH] == launch &&
                                host_result[RESULT_TRIALS] == TRIALS &&
                                host_result[RESULT_ROUNDS] == ROUNDS &&
                                host_result[RESULT_FINISH_MAGIC] == RESULT_FINISH_VALUE;
        if (!result_header_ok) {
            ++control_failures;
            if (control_failures <= 3) {
                std::printf("result_header_bad launch=%u magic=0x%08x mode=%u result_launch=%u trials=%u "
                            "rounds=%u finish=0x%08x\n",
                            launch, host_result[RESULT_MAGIC], host_result[RESULT_MODE],
                            host_result[RESULT_LAUNCH], host_result[RESULT_TRIALS],
                            host_result[RESULT_ROUNDS], host_result[RESULT_FINISH_MAGIC]);
            }
        }
        if (host_result[RESULT_PARTICIPANTS] != block_count) {
            ++participation_failures;
            if (participation_failures <= 3) {
                std::printf("result_participation_bad launch=%u actual=%u expected=%u\n",
                            launch, host_result[RESULT_PARTICIPANTS], block_count);
            }
        }
        for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
            uint32_t expected = 0;
            if (word == PARTICIPATION_COUNT || word == PARTICIPATION_BLOCK_NUM) {
                expected = block_count;
            } else if (word == PARTICIPATION_LAUNCH) {
                expected = launch;
            } else if (word == PARTICIPATION_MODE) {
                expected = mode;
            }
            if (host_participation[word] != expected) {
                ++participation_failures;
                if (participation_failures <= 3) {
                    std::printf("participation_line_bad launch=%u word=%u actual=0x%08x expected=0x%08x\n",
                                launch, word, host_participation[word], expected);
                }
            }
        }
        if (host_result[RESULT_MARKER_ERRORS] != 0) {
            marker_failures += host_result[RESULT_MARKER_ERRORS];
        }

        total_store_errors += host_result[RESULT_STORE_ERRORS];
        total_slot_errors[0] += host_result[RESULT_SLOT0_ERRORS];
        total_slot_errors[1] += host_result[RESULT_SLOT1_ERRORS];
        if (host_result[RESULT_STORE_ERRORS] !=
            host_result[RESULT_SLOT0_ERRORS] + host_result[RESULT_SLOT1_ERRORS]) {
            ++control_failures;
            if (control_failures <= 3) {
                std::printf("slot_error_sum_bad launch=%u total=%u slot0=%u slot1=%u\n",
                            launch, host_result[RESULT_STORE_ERRORS], host_result[RESULT_SLOT0_ERRORS],
                            host_result[RESULT_SLOT1_ERRORS]);
            }
        }
        if (host_result[RESULT_STORE_ERRORS] != 0 && !have_first_error) {
            have_first_error = true;
            global_first_actual = host_result[RESULT_FIRST_ACTUAL];
            global_first_expected = host_result[RESULT_FIRST_EXPECTED];
            global_first_launch = host_result[RESULT_FIRST_LAUNCH];
            global_first_trial = host_result[RESULT_FIRST_TRIAL];
            global_first_slot = host_result[RESULT_FIRST_SLOT];
        }
        if (host_result[RESULT_STORE_ERRORS] == 0 &&
            (host_result[RESULT_FIRST_ACTUAL] != 0 ||
             host_result[RESULT_FIRST_EXPECTED] != 0 ||
             host_result[RESULT_FIRST_LAUNCH] != INVALID_U32 ||
             host_result[RESULT_FIRST_TRIAL] != INVALID_U32 ||
             host_result[RESULT_FIRST_SLOT] != INVALID_U32)) {
            ++control_failures;
            if (control_failures <= 3) {
                std::printf("empty_first_error_bad launch=%u actual=0x%08x expected=0x%08x "
                            "first_launch=%u trial=%u slot=%u\n",
                            launch, host_result[RESULT_FIRST_ACTUAL], host_result[RESULT_FIRST_EXPECTED],
                            host_result[RESULT_FIRST_LAUNCH], host_result[RESULT_FIRST_TRIAL],
                            host_result[RESULT_FIRST_SLOT]);
            }
        }
        if (host_result[RESULT_STORE_ERRORS] != 0) {
            uint32_t first_trial = host_result[RESULT_FIRST_TRIAL];
            uint32_t first_slot = host_result[RESULT_FIRST_SLOT];
            bool first_error_ok = host_result[RESULT_FIRST_LAUNCH] == launch &&
                                  first_trial < TRIALS && first_slot < 2 &&
                                  host_result[RESULT_FIRST_EXPECTED] ==
                                      HostTrialValue(mode, first_slot, first_trial, ROUNDS - 1);
            if (!first_error_ok) {
                ++control_failures;
            }
        }

        for (uint32_t line = 0; line < 3; ++line) {
            bool target_line = line == data_start_line || line == data_start_line + 1;
            uint32_t slot = line - data_start_line;
            uint32_t line_base = line * CACHELINE_WORDS;
            for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
                uint32_t expected = target_line && word == 0 ?
                    HostTrialValue(mode, slot, TRIALS - 1, ROUNDS - 1) : 0u;
                uint32_t actual = host_storage[line_base + word];
                if (actual == expected) {
                    continue;
                }
                if (target_line && word == 0) {
                    ++final_value_failures[slot];
                    if (!have_first_error) {
                        have_first_error = true;
                        global_first_actual = actual;
                        global_first_expected = expected;
                        global_first_launch = launch;
                        global_first_trial = TRIALS - 1;
                        global_first_slot = slot;
                    }
                } else {
                    ++guard_failures;
                }
            }
        }
        for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
            if (host_storage[TAIL_GUARD_BASE + word] != 0) {
                ++guard_failures;
            }
        }

        for (uint32_t participant = 0; participant < MAX_PARTICIPANTS; ++participant) {
            uint32_t *marker = host_markers + participant * CACHELINE_WORDS;
            if (participant >= block_count) {
                for (uint32_t word = 0; word < CACHELINE_WORDS; ++word) {
                    if (marker[word] != 0) {
                        ++marker_failures;
                    }
                }
                continue;
            }

            bool expected_active = participant == 0 || participant == second_active_block;
            uint32_t expected_slot = participant == 0 ? 0u :
                                     (participant == second_active_block ? 1u : INVALID_U32);
            bool marker_header_ok = marker[MARKER_MAGIC] == (TOPOLOGY_MAGIC_BASE | participant) &&
                                    marker[MARKER_BLOCK_IDX] == participant &&
                                    marker[MARKER_BLOCK_NUM] == block_count &&
                                    marker[MARKER_MODE] == mode &&
                                    marker[MARKER_ACTIVE] == (expected_active ? 1u : 0u) &&
                                    marker[MARKER_ACTIVE_SLOT] == expected_slot &&
                                    marker[MARKER_ARRIVED] == 1u &&
                                    marker[MARKER_LAUNCH] == launch;
            if (!marker_header_ok) {
                ++marker_failures;
            }
            for (uint32_t word = MARKER_WRITTEN_WORDS; word < CACHELINE_WORDS; ++word) {
                if (marker[word] != 0) {
                    ++marker_failures;
                }
            }

            int32_t computed_comm_slot = HostComputeA5CommSlot(
                marker[MARKER_CORE_ID], marker[MARKER_SUBBLOCK_ID]);
            if (marker[MARKER_COMM_SLOT] != static_cast<uint32_t>(computed_comm_slot)) {
                ++comm_slot_record_failures;
            }
            if (launch == 0) {
                std::printf("topology mode=%u launch=0 block=%u coreid=%u subblock=%u comm_slot=%d active=%u slot=%u\n",
                            mode, participant, marker[MARKER_CORE_ID], marker[MARKER_SUBBLOCK_ID],
                            static_cast<int32_t>(marker[MARKER_COMM_SLOT]), marker[MARKER_ACTIVE],
                            marker[MARKER_ACTIVE_SLOT]);
            }
        }

    }

    unsigned long long total_trial_checks =
        static_cast<unsigned long long>(launches) * TRIALS * 2u;
    std::printf("mode=%u blocks=%u active=0+%u data_lines=%u+%u launches=%u trial_checks=%llu "
                "store_errors=%llu slot0_store_errors=%llu slot1_store_errors=%llu "
                "control_failures=%llu participation_failures=%llu marker_failures=%llu "
                "slot0_final_value_failures=%llu slot1_final_value_failures=%llu guard_failures=%llu "
                "comm_slot_record_failures=%llu\n",
                mode, block_count, second_active_block, data_start_line, data_start_line + 1,
                launches, total_trial_checks,
                static_cast<unsigned long long>(total_store_errors),
                static_cast<unsigned long long>(total_slot_errors[0]),
                static_cast<unsigned long long>(total_slot_errors[1]),
                static_cast<unsigned long long>(control_failures),
                static_cast<unsigned long long>(participation_failures),
                static_cast<unsigned long long>(marker_failures),
                static_cast<unsigned long long>(final_value_failures[0]),
                static_cast<unsigned long long>(final_value_failures[1]),
                static_cast<unsigned long long>(guard_failures),
                static_cast<unsigned long long>(comm_slot_record_failures));
    if (have_first_error) {
        std::printf("first_error actual=0x%08x expected=0x%08x launch=%u trial=%u slot=%u\n",
                    global_first_actual, global_first_expected, global_first_launch,
                    global_first_trial, global_first_slot);
    } else {
        std::printf("first_error none\n");
    }

    atomic_probe::Result result;
    result.Expect(total_store_errors == 0, "所有 trial 的两条独占 line 终值精确");
    result.Expect(control_failures == 0, "kernel 结果头与首错记录精确");
    result.Expect(participation_failures == 0, "每次 launch 的参与 AIV 数精确");
    result.Expect(marker_failures == 0, "每个 AIV 的独占 topology marker 精确");
    result.Expect(final_value_failures[0] == 0 && final_value_failures[1] == 0,
                  "每次 launch 结束后的两个目标终值精确");
    result.Expect(guard_failures == 0, "所有非目标 data 与 guard word 保持初值");
    result.Expect(comm_slot_record_failures == 0, "记录的 comm_slot 与 PTO signed int 算式一致");

    PROBE_ACL_CHECK(aclrtFree(device_storage));
    PROBE_ACL_CHECK(aclrtDestroyStream(stream));
    PROBE_ACL_CHECK(aclrtResetDevice(device));
    PROBE_ACL_CHECK(aclFinalize());
    return result.ExitCode();
}
