#include "acl/acl.h"
#include "kernel_operator.h"
#include <time.h>
#include <cstdio>
using namespace AscendC;

__schedmode__(1) __global__ __mix__(0,1) void test(__gm__ uint8_t* gx, uint32_t numBlocks)
{
    SyncAll();  //多核同步
    int64_t systemCycleBefore = AscendC::GetSystemCycle(); // 调用GetBlockNum指令前的cycle数

    for(int i = 0; i < 100; i++) {
        // dcci(gx, 0, 2);
        auto t = AtomicCas(reinterpret_cast<__gm__ uint32_t *>(gx), (uint32_t)1000, (uint32_t)2000);
        if (t == 22222) break;
    }

    int64_t systemCycleAfter = AscendC::GetSystemCycle(); // 调用GetBlockNum指令后的cycle数
    int64_t NumCycle = systemCycleAfter - systemCycleBefore;
    int64_t CycleToTimeBase = 1000; // cycle数转成时间的基线单位

    int64_t NumTime = NumCycle / CycleToTimeBase; // 执行指令所用时间，单位为us
    if (GetBlockIdx() == 0) {
        printf("%u %ld\n", numBlocks, NumTime);
    }

    // 350 / 100 = 3.5us / core
    // 3.5us/core -> 3500ns
}

int32_t main(int32_t argc, char* argv[])
{
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xDevice;
    aclrtMalloc((void **)&xDevice, 32, ACL_MEM_MALLOC_HUGE_FIRST);

    uint32_t initVal = 1000;

    // 选择几个关键点做 host 侧真实时间校准
    uint32_t test_blocks[] = {1, 4, 8, 16, 32, 64};
    for (size_t i = 0; i < sizeof(test_blocks)/sizeof(test_blocks[0]); i++) {
        uint32_t numBlocks = test_blocks[i];

        aclrtMemcpy(xDevice, sizeof(uint32_t), &initVal, sizeof(uint32_t), ACL_MEMCPY_HOST_TO_DEVICE);

        struct timespec ts_start, ts_end;
        clock_gettime(CLOCK_MONOTONIC, &ts_start);

        test<<<numBlocks, nullptr, stream>>>(xDevice, numBlocks);
        aclrtSynchronizeStream(stream);

        clock_gettime(CLOCK_MONOTONIC, &ts_end);

        double host_time_us = (ts_end.tv_sec - ts_start.tv_sec) * 1e6 +
                              (ts_end.tv_nsec - ts_start.tv_nsec) / 1e3;

        printf("[HOST] NUM_BLOCKS=%u  HostMeasured≈%.1f us   (Device printed NumTime should be close if unit is us)\n",
               numBlocks, host_time_us);
    }

    // 仍然跑完整 1~64 方便曲线
    printf("\n--- Full 1~64 sweep (device side) ---\n");
    for (uint32_t numBlocks = 1; numBlocks <= 64; numBlocks++) {
        aclrtMemcpy(xDevice, sizeof(uint32_t), &initVal, sizeof(uint32_t), ACL_MEMCPY_HOST_TO_DEVICE);
        test<<<numBlocks, nullptr, stream>>>(xDevice, numBlocks);
        aclrtSynchronizeStream(stream);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
